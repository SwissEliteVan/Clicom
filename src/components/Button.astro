---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'dark' | 'ghost';
  type?: 'button' | 'submit';
  class?: string;
}
const { href, variant = 'primary', type = 'button', class: className = '', ...attributes } = Astro.props;
const classes = `button button--${variant} ${className}`;
---
{href ? <a {...attributes} class={classes} href={href}><slot /></a> : <button {...attributes} class={classes} type={type}><slot /></button>}
