---
import Button from './Button.astro';

interface Props { title?: string; text?: string; href?: string; label?: string; }

const {
  title = 'Prêt à accélérer votre croissance ?',
  text = 'Parlons de vos objectifs et identifions les leviers digitaux les plus pertinents pour votre entreprise.',
  href = '/contact#audit',
  label = 'Demander un audit gratuit →',
} = Astro.props;
---
<section class="section"><div class="container"><div class="cta-panel"><div><h2>{title}</h2><p>{text}</p></div><Button {href}>{label}</Button></div></div></section>
