---
import Button from './Button.astro';

interface Props { title?: string; text?: string; }

const {
  title = 'Prêt à accélérer votre croissance ?',
  text = 'Parlons de vos objectifs et identifions les leviers digitaux les plus pertinents pour votre entreprise.',
} = Astro.props;
---
<section class="section"><div class="container"><div class="cta-panel"><div><h2>{title}</h2><p>{text}</p></div><Button href="/contact#audit">Demander un audit gratuit →</Button></div></div></section>
