---
import type { CaseStudy } from '../data/case-studies';
interface Props { study: CaseStudy }
const { study } = Astro.props;
---

<article class="case-card card card--interactive">
  <div class="case-card__media"><img src={study.image.src} alt={study.image.alt} width={study.image.width} height={study.image.height} loading="lazy" /></div>
  <div class="case-card__body">
    <div class="case-card__meta"><span>{study.sector}</span><time datetime={study.date}>{new Date(study.date).toLocaleDateString('fr-CH', { year: 'numeric', month: 'long' })}</time></div>
    <h2>{study.client}</h2>
    <p>{study.problem}</p>
    <a class="text-link" href={`/realisations/${study.slug}/`}>Découvrir le projet <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .case-card { display: grid; grid-template-columns: minmax(240px,.8fr) minmax(0,1.2fr); gap: 0; padding: 0; overflow: hidden; }
  .case-card__media { min-height: 330px; overflow: hidden; background: var(--color-primary-soft); }
  .case-card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--transition-base); }
  .case-card__body { padding: clamp(28px,5vw,54px); }
  .case-card__meta { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; margin-bottom: 30px; color: var(--color-text-muted); font-size: .7rem; font-weight: 750; letter-spacing: .09em; text-transform: uppercase; }
  .case-card__meta span { color: var(--color-primary); }
  @media (hover:hover) { .case-card:hover img { transform: scale(1.025); } }
  @media (max-width: 700px) { .case-card { grid-template-columns: 1fr; } .case-card__media { min-height: 220px; } }
</style>
