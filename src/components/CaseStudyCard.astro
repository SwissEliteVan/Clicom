---
import type { CaseStudy } from '../data/case-studies';
interface Props { study: CaseStudy }
const { study } = Astro.props;
---

<article class="case-entry">
  <div class="case-entry__media">
    <img src={study.image.src} alt={study.image.alt} width={study.image.width} height={study.image.height} loading="lazy" />
  </div>
  <div class="case-entry__body">
    <div class="case-entry__meta">
      <span class="case-entry__sector">{study.sector}</span>
      <time datetime={study.date}>{new Date(study.date).toLocaleDateString('fr-CH', { year: 'numeric', month: 'long' })}</time>
    </div>
    <h3>{study.client}</h3>
    <p class="case-entry__problem">{study.problem}</p>

    {study.results.length > 0 && (
      <div class="case-entry__proof">
        <strong>Résultat concret :</strong>
        <p><span>{study.results[0].value}</span> — {study.results[0].context}</p>
      </div>
    )}

    <div class="case-entry__action">
      <a class="button button--secondary" href={`/realisations/${study.slug}/`}>
        Découvrir le projet <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .case-entry {
    display: grid;
    grid-template-columns: minmax(320px, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
    padding-top: 36px;
    border-top: 1px solid var(--color-border-strong);
  }
  .case-entry__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-surface);
    border: 1px solid var(--color-border);
    background: var(--color-midnight);
    aspect-ratio: 16 / 10;
  }
  .case-entry__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-smooth);
  }
  .case-entry__body {
    display: flex;
    flex-direction: column;
  }
  .case-entry__meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 12px;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .case-entry__sector {
    color: var(--color-primary);
  }
  .case-entry h3 {
    margin: 0 0 14px;
    font-size: clamp(1.75rem, 2.5vw, 2.35rem);
    color: var(--color-midnight);
    line-height: 1.1;
  }
  .case-entry__problem {
    margin: 0 0 20px;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .case-entry__proof {
    margin-bottom: 24px;
    padding-left: 16px;
    border-left: 2px solid var(--color-primary);
  }
  .case-entry__proof strong {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 4px;
  }
  .case-entry__proof p {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-midnight);
  }
  .case-entry__proof p span {
    font-weight: 700;
    color: var(--color-primary);
  }
  .case-entry__action {
    display: flex;
  }

  @media (hover: hover) and (pointer: fine) {
    .case-entry:hover .case-entry__media img {
      transform: scale(1.02);
    }
  }
  @media (max-width: 900px) {
    .case-entry {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
