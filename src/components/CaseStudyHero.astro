---
import type { CaseStudy } from '../data/case-studies';
interface Props { study: CaseStudy }
const { study } = Astro.props;
---

<header class="case-hero">
  <div class="container case-hero__inner">
    <div class="case-hero__copy" data-reveal-children><div class="eyebrow">Étude de cas · {study.sector}</div><h1>{study.client}</h1><p>{study.problem}</p><div class="case-hero__services">{study.services.map(service => <a href={service.href}>{service.label}</a>)}</div></div>
    <div class="case-hero__media" data-reveal="media"><img src={study.image.src} alt={study.image.alt} width={study.image.width} height={study.image.height} /></div>
  </div>
</header>

<style>
  .case-hero { padding-block: clamp(7rem,11vw,10rem) clamp(5rem,8vw,8rem); overflow: hidden; background: linear-gradient(180deg,#fff,var(--color-background)); }
  .case-hero__inner { display: grid; grid-template-columns: minmax(0,.8fr) minmax(320px,1.2fr); gap: clamp(40px,8vw,100px); align-items: center; }
  .case-hero__copy p { max-width: 650px; font-size: clamp(1.08rem,1.7vw,1.3rem); }
  .case-hero__services { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 30px; }
  .case-hero__services a { padding: 8px 11px; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-primary); font-size: .78rem; font-weight: 700; }
  .case-hero__media { min-height: 440px; overflow: hidden; border-radius: var(--radius-surface); background: var(--color-primary-soft); box-shadow: var(--shadow-featured); }
  .case-hero__media img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 900px) { .case-hero__inner { grid-template-columns: 1fr; } .case-hero__media { min-height: 300px; } }
  @media (max-width: 480px) { .case-hero__media { min-height: 220px; border-radius: var(--radius-card); } }
</style>
