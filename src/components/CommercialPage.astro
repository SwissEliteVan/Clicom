---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import CTA from './CTA.astro';
import CalendlyButton from './conversion/CalendlyButton.astro';
import CommercialVisual from './CommercialVisual.astro';
import EditorialImage from './EditorialImage.astro';
import type { ImageMetadata } from 'astro';

interface Item { title: string; text: string }
interface FAQ { question: string; answer: string }
interface Link { href: string; label: string }
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  intro: string;
  problems: Item[];
  solution: string;
  services: Item[];
  process: Item[];
  benefits: string[];
  faq: FAQ[];
  links: Link[];
  variant?: 'standard' | 'reverse';
  editorialImage?: ImageMetadata;
}

const { title, description, eyebrow, h1, intro, problems, solution, services, process, benefits, faq, links, variant = 'standard', editorialImage } = Astro.props;
const visualByEyebrow: Record<string, 'web' | 'seo' | 'geo' | 'ads' | 'ai' | 'automation'> = {
  'CrÃ©ation de site web': 'web',
  'RÃ©fÃ©rencement naturel': 'seo',
  'GEO & AEO': 'geo',
  'Google Ads': 'ads',
  'Intelligence artificielle': 'ai',
  'Automatisation': 'automation',
};
const visual = visualByEyebrow[eyebrow];
const sectionCopy = {
  web: { issues: 'Faire du site un actif commercial, pas une simple vitrine.', offer: 'Concevoir chaque couche autour du mÃªme objectif.', process: 'Du cadrage au lancement, sans rupture entre design et technique.', benefits: 'Une expÃ©rience qui inspire confiance et facilite le passage Ã  lâ€™action.' },
  seo: { issues: 'Concentrer lâ€™effort SEO lÃ  oÃ¹ il peut crÃ©er de la valeur.', offer: 'Technique, contenu, autoritÃ©, local et mesure rÃ©unis.', process: 'Une progression lisible, fondÃ©e sur les prioritÃ©s.', benefits: 'Une visibilitÃ© construite pour soutenir les objectifs commerciaux.' },
  geo: { issues: 'Rendre une expertise claire, structurÃ©e et vÃ©rifiable.', offer: 'PrÃ©parer la marque aux nouveaux parcours de recherche.', process: 'Observer, structurer et publier avant de mesurer.', benefits: 'Des signaux plus cohÃ©rents pour les moteurs et les personnes.' },
  ads: { issues: 'Transformer un budget mÃ©dia en systÃ¨me dâ€™acquisition pilotable.', offer: 'Aligner lâ€™intention, le message, la page et la mesure.', process: 'Un cycle court entre apprentissage et optimisation.', benefits: 'Des dÃ©cisions publicitaires fondÃ©es sur la qualitÃ© des conversions.' },
  automation: { issues: 'Supprimer les frictions rÃ©pÃ©titives.', offer: 'Relier les outils autour de dÃ©cisions claires.', process: 'Cartographier, simplifier, connecter et superviser.', benefits: 'Des flux fiables qui libÃ¨rent du temps.' },
  ai: { issues: 'Passer des essais isolÃ©s Ã  des usages rÃ©ellement intÃ©grÃ©s.', offer: 'Mettre lâ€™IA au service des processus et des Ã©quipes.', process: 'Prototyper vite, intÃ©grer avec mÃ©thode, encadrer durablement.', benefits: 'Une adoption pragmatique, contrÃ´lÃ©e et Ã©volutive.' },
}[visual] ?? { issues: 'Transformer les points de friction en opportunitÃ©s.', offer: 'Une expertise reliÃ©e Ã  votre croissance.', process: 'De la stratÃ©gie Ã  lâ€™amÃ©lioration continue.', benefits: 'Un levier pensÃ© pour produire de la valeur.' };
---

<Layout {title} {description}>
  <PageHero {eyebrow} title={h1} {intro} primary="/contact/" primaryLabel="Réserver un rendez-vous" secondary="/audit-gratuit/" secondaryLabel="Demander un audit gratuit" />

  {editorialImage && <section class="commercial-editorial" aria-hidden="true"><EditorialImage src={editorialImage} alt="" ratio="21/9" ratioMobile="4/3" eager sizes="100vw" /></section>}

  <section class="section section--white commercial-booking"><div class="container commercial-booking__inner"><div><div class="eyebrow">Premier échange</div><h2>Clarifions vos priorités.</h2><p>Un rendez-vous permet de vérifier l'adéquation entre vos objectifs, votre contexte et les leviers à activer.</p></div><CalendlyButton mode="popup" label="Réserver un rendez-vous" /></div></section>

  <section class="section section--white">
    <div class:list={['container', 'split', { 'split--reverse': variant === 'reverse' }]}>
      <div class="section-heading">
        <div class="eyebrow">Vos enjeux</div>
        <h2>{sectionCopy.issues}</h2>
        <p>{solution}</p>
      </div>
      <div class="issue-list">
        {problems.map((item, index) => <article><span>0{index + 1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}
      </div>
    </div>
  </section>

  {visual && <CommercialVisual type={visual} />}

  <section class="section section--dark">
    <div class="container">
      <div class="section-heading"><div class="eyebrow">Solution CLICOM</div><h2>{sectionCopy.offer}</h2></div>
      <div class:list={['grid', 'grid--3', 'offer-grid', { 'offer-grid--featured': variant === 'reverse' }]}>
        {services.map((item) => <article class="card"><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="section-heading"><div class="eyebrow">Processus</div><h2>{sectionCopy.process}</h2></div>
      <div class="process-grid">
        {process.map((item, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section benefits-section">
    <div class="container benefits">
      <div><div class="eyebrow">BÃ©nÃ©fices</div><h2>{sectionCopy.benefits}</h2></div>
      <ul>{benefits.map((benefit) => <li><span>â†’</span>{benefit}</li>)}</ul>
    </div>
  </section>

  <section class="section section--white">
    <div class="container faq-wrap">
      <div class="section-heading"><div class="eyebrow">Questions frÃ©quentes</div><h2>Les rÃ©ponses <span class="accent">essentielles.</span></h2></div>
      <div class="faq-list">{faq.map((item) => <details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}</div>
      <nav class="related" aria-label="Expertises associÃ©es"><strong>Ã€ dÃ©couvrir aussi</strong>{links.map((link) => <a href={link.href}>{link.label} <span>â†’</span></a>)}</nav>
    </div>
  </section>

  <CTA variant="calendly" secondaryHref="/audit-gratuit/" secondaryLabel="Demander un audit gratuit" title="Faisons de cette expertise votre prochain accÃ©lÃ©rateur." text="Un premier audit permet dâ€™identifier les prioritÃ©s, les dÃ©pendances et les opportunitÃ©s les plus pertinentes pour votre entreprise." />
</Layout>

<style>
  .commercial-booking__inner { display:flex; align-items:center; justify-content:space-between; gap:32px; padding:clamp(28px,4vw,48px); border:1px solid var(--color-border); border-radius:var(--radius-surface); background:var(--color-primary-soft); }
  .commercial-booking__inner p { max-width:680px; margin:0; }
  .commercial-editorial { position: relative; z-index: 20; width: 100%; max-width: none; overflow: visible; background: white; }
  .commercial-editorial :global(img) { position: relative; z-index: 20; display: block; width: 100%; max-width: none; height: auto; min-height: 0; object-fit: cover; opacity: 1; visibility: visible; filter: none; clip-path: none; transform: none; }
  .commercial-editorial :global(figure) { width: 100%; max-width: none; min-height: 0; margin: 0; border-radius: 0; }
  .split { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(50px, 8vw, 110px); align-items: start; }
  .split--reverse .section-heading { order: 2; }
  .issue-list { display: grid; gap: 1px; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-border); }
  .issue-list article { display: grid; grid-template-columns: auto 1fr; gap: 20px; padding: 28px; background: white; }
  .issue-list article > span, .process-grid article > span { color: var(--color-primary); font-size: .75rem; font-weight: 780; letter-spacing: .12em; }
  .issue-list h3 { margin-bottom: 8px; font-size: 1.25rem; }
  .issue-list p { margin: 0; }
  .offer-grid .card::before { background: var(--color-cyan); }
  .offer-grid--featured .card:first-child { grid-column: span 2; background: linear-gradient(145deg, rgba(255,255,255,.09), rgba(36,87,255,.12)); }
  .process-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-block: 1px solid var(--color-border); }
  .process-grid article { padding: 32px; border-right: 1px solid var(--color-border); }
  .process-grid article:last-child { border-right: 0; }
  .process-grid h3 { margin-top: 32px; }
  .benefits-section { background: var(--color-primary-soft); }
  .benefits { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(40px, 8vw, 100px); align-items: center; }
  .benefits ul { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(36,87,255,.18); }
  .benefits li { display: flex; gap: 15px; padding: 18px 0; border-bottom: 1px solid rgba(36,87,255,.18); font-weight: 650; }
  .benefits li span { color: var(--color-primary); }
  .faq-wrap { max-width: 980px; }
  .faq-list { border-top: 1px solid var(--color-border); }
  .faq-list details { border-bottom: 1px solid var(--color-border); }
  .faq-list summary { display: flex; min-height: 76px; align-items: center; justify-content: space-between; gap: 24px; cursor: pointer; font-weight: 720; list-style: none; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary span { color: var(--color-primary); font-size: 1.5rem; }
  .faq-list details[open] summary span { transform: rotate(45deg); }
  .faq-list p { max-width: 780px; padding: 0 40px 24px 0; }
  .related { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--color-border); }
  .related strong { width: 100%; margin-bottom: 6px; }
  .related a { padding: 9px 13px; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-text-muted); font-size: .84rem; font-weight: 680; }
  .related a span { color: var(--color-primary); }
  @media (max-width:900px) { .split, .benefits { grid-template-columns:1fr; } .split--reverse .section-heading { order:initial; } .process-grid { grid-template-columns:repeat(2,1fr); } .process-grid article:nth-child(2) { border-right:0; } .offer-grid--featured .card:first-child { grid-column:auto; } }
  @media (max-width:600px) { .commercial-booking__inner { align-items:flex-start; flex-direction:column; } }
  @media (max-width: 580px) { .process-grid { grid-template-columns: 1fr; } .process-grid article { border-right: 0; border-bottom: 1px solid var(--color-border); padding-inline: 0; } .faq-list p { padding-right: 0; } }
</style>

