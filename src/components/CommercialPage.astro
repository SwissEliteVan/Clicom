---
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import CTA from './CTA.astro';
import CommercialVisual from './CommercialVisual.astro';
import PageHero from './PageHero.astro';

interface Item {
  title: string;
  text: string;
}

interface FAQ {
  question: string;
  answer: string;
}

interface Link {
  href: string;
  label: string;
}

interface DecisionGuide {
  eyebrow: string;
  title: string;
  intro?: string;
  items: Item[];
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  intro: string;
  problems: Item[];
  solution: string;
  services: Item[];
  process: Item[];
  benefits: string[];
  faq: FAQ[];
  links: Link[];
  variant?: 'standard' | 'reverse';
  editorialImage?: ImageMetadata;
  problemEyebrow?: string;
  problemsTitle?: string;
  offerEyebrow?: string;
  offerTitle?: string;
  processTitle?: string;
  benefitsTitle?: string;
  faqTitle?: string;
  decisionGuide?: DecisionGuide;
  heroPrimaryLabel?: string;
  heroSecondary?: string;
  heroSecondaryLabel?: string;
  heroPrimaryCalendly?: boolean;
  ctaTitle?: string;
  ctaText?: string;
  ctaLabel?: string;
  ctaCalendly?: boolean;
}

const {
  title,
  description,
  eyebrow,
  h1,
  intro,
  problems,
  solution,
  services,
  process,
  benefits,
  faq,
  links,
  variant = 'standard',
  editorialImage,
  problemEyebrow = 'Vos enjeux',
  problemsTitle = 'Clarifier ce qui freine vos résultats.',
  offerEyebrow = 'Approche CLICOM',
  offerTitle = 'Une expertise reliée à vos objectifs.',
  processTitle = 'Une méthode claire, du premier échange à l’amélioration.',
  benefitsTitle = 'Des décisions plus simples et des actions plus cohérentes.',
  faqTitle = 'Les réponses aux questions les plus utiles.',
  decisionGuide,
  heroPrimaryLabel = 'Réserver un échange de 30 min →',
  heroSecondary = '#method',
  heroSecondaryLabel = 'Découvrir notre méthode',
  heroPrimaryCalendly = false,
  ctaTitle = 'Parlons de la meilleure prochaine étape.',
  ctaText = 'Un échange de 30 minutes permet de clarifier votre contexte, les priorités et le bon niveau d’accompagnement.',
  ctaLabel = 'Réserver un échange de 30 min →',
  ctaCalendly = false,
} = Astro.props;

const visualByEyebrow: Record<string, 'web' | 'seo' | 'geo' | 'ads' | 'ai' | 'automation'> = {
  'Création de site web': 'web',
  'Référencement naturel': 'seo',
  'GEO & AEO': 'geo',
  'Google Ads': 'ads',
  'Intelligence artificielle': 'ai',
  Automatisation: 'automation',
};

const visual = visualByEyebrow[eyebrow];
---

<Layout {title} {description}>
  <PageHero
    {eyebrow}
    title={h1}
    {intro}
    primaryLabel={heroPrimaryLabel}
    primaryCalendly={heroPrimaryCalendly}
    primary="/contact/"
    secondary={heroSecondary}
    secondaryLabel={heroSecondaryLabel}
  />

  {
    editorialImage && (
      <section class="commercial-editorial" aria-hidden="true">
        <img
          src={editorialImage.src}
          alt=""
          width={editorialImage.width}
          height={editorialImage.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </section>
    )
  }

  <section class="section section--white">
    <div class:list={['container', 'split', { 'split--reverse': variant === 'reverse' }]}>
      <div class="section-heading">
        <div class="eyebrow">{problemEyebrow}</div>
        <h2>{problemsTitle}</h2>
        <p>{solution}</p>
      </div>
      <div class="issue-list">
        {
          problems.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {visual && <CommercialVisual type={visual} />}

  <section id="approach" class="section section--dark">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">{offerEyebrow}</div>
        <h2>{offerTitle}</h2>
      </div>
      <div class:list={['grid', 'grid--3', 'offer-grid', { 'offer-grid--featured': variant === 'reverse' }]}>
        {services.map((item) => <article class="card"><h3>{item.title}</h3><p>{item.text}</p></article>)}
      </div>
    </div>
  </section>

  {
    decisionGuide && (
      <section class="section decision-section">
        <div class="container">
          <div class="section-heading">
            <div class="eyebrow">{decisionGuide.eyebrow}</div>
            <h2>{decisionGuide.title}</h2>
            {decisionGuide.intro && <p>{decisionGuide.intro}</p>}
          </div>
          <div class:list={['grid', 'decision-grid', decisionGuide.items.length === 2 ? 'grid--2' : 'grid--3']}>
            {decisionGuide.items.map((item) => <article class="card"><h3>{item.title}</h3><p>{item.text}</p></article>)}
          </div>
        </div>
      </section>
    )
  }

  <section id="method" class="section section--white">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">Processus</div>
        <h2>{processTitle}</h2>
      </div>
      <div class="process-grid" style={`--process-count: ${Math.min(process.length, 5)}`}>
        {
          process.map((item, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section benefits-section">
    <div class="container benefits">
      <div>
        <div class="eyebrow">Bénéfices</div>
        <h2>{benefitsTitle}</h2>
      </div>
      <ul>{benefits.map((benefit) => <li><span>→</span>{benefit}</li>)}</ul>
    </div>
  </section>

  <section class="section section--white">
    <div class="container faq-wrap">
      <div class="section-heading">
        <div class="eyebrow">Questions fréquentes</div>
        <h2>{faqTitle}</h2>
      </div>
      <div class="faq-list">
        {
          faq.map((item) => (
            <details>
              <summary>{item.question}<span aria-hidden="true">+</span></summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
      <nav class="related" aria-label="Expertises associées">
        <strong>À découvrir aussi</strong>
        {links.map((link) => <a href={link.href}>{link.label} <span>→</span></a>)}
      </nav>
    </div>
  </section>

  <CTA title={ctaTitle} text={ctaText} label={ctaLabel} calendly={ctaCalendly} />
</Layout>

<style>
  .commercial-editorial { position: relative; z-index: 20; width: 100%; max-width: none; min-height: 420px; overflow: visible; background: white; }
  .commercial-editorial :global(img) { position: relative; z-index: 20; display: block; width: 100%; max-width: none; height: 420px; min-height: 420px; object-fit: cover; opacity: 1; visibility: visible; filter: none; clip-path: none; transform: none; }
  .split { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(50px, 8vw, 110px); align-items: start; }
  .split--reverse .section-heading { order: 2; }
  .issue-list { display: grid; gap: 1px; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-border); }
  .issue-list article { display: grid; grid-template-columns: auto 1fr; gap: 20px; padding: 28px; background: white; }
  .issue-list article > span, .process-grid article > span { color: var(--color-primary); font-size: .75rem; font-weight: 780; letter-spacing: .12em; }
  .issue-list h3 { margin-bottom: 8px; font-size: 1.25rem; }
  .issue-list p { margin: 0; }
  .offer-grid .card::before { background: var(--color-cyan); }
  .offer-grid--featured .card:first-child { grid-column: span 2; background: linear-gradient(145deg, rgba(255,255,255,.09), rgba(36,87,255,.12)); }
  .decision-section { background: var(--color-primary-soft); }
  .decision-grid .card { background: rgba(255,255,255,.85); }
  .process-grid { display: grid; grid-template-columns: repeat(var(--process-count, 4), minmax(0, 1fr)); border-block: 1px solid var(--color-border); }
  .process-grid article { padding: 32px; border-right: 1px solid var(--color-border); }
  .process-grid article:last-child { border-right: 0; }
  .process-grid h3 { margin-top: 32px; }
  .benefits-section { background: var(--color-primary-soft); }
  .benefits { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(40px, 8vw, 100px); align-items: center; }
  .benefits ul { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid rgba(36,87,255,.18); }
  .benefits li { display: flex; gap: 15px; padding: 18px 0; border-bottom: 1px solid rgba(36,87,255,.18); font-weight: 650; }
  .benefits li span { color: var(--color-primary); }
  .faq-wrap { max-width: 980px; }
  .faq-list { border-top: 1px solid var(--color-border); }
  .faq-list details { border-bottom: 1px solid var(--color-border); }
  .faq-list summary { display: flex; min-height: 76px; align-items: center; justify-content: space-between; gap: 24px; cursor: pointer; font-weight: 720; list-style: none; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary span { color: var(--color-primary); font-size: 1.5rem; }
  .faq-list details[open] summary span { transform: rotate(45deg); }
  .faq-list p { max-width: 780px; padding: 0 40px 24px 0; }
  .related { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--color-border); }
  .related strong { width: 100%; margin-bottom: 6px; }
  .related a { padding: 9px 13px; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-text-muted); font-size: .84rem; font-weight: 680; }
  .related a span { color: var(--color-primary); }
  @media (max-width: 900px) {
    .split, .benefits { grid-template-columns: 1fr; }
    .split--reverse .section-heading { order: initial; }
    .process-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .process-grid article { border-bottom: 1px solid var(--color-border); }
    .process-grid article:nth-child(even) { border-right: 0; }
    .offer-grid--featured .card:first-child { grid-column: auto; }
  }
  @media (max-width: 580px) {
    .commercial-editorial, .commercial-editorial :global(img) { height: 240px; min-height: 240px; }
    .process-grid { grid-template-columns: 1fr; }
    .process-grid article, .process-grid article:nth-child(even) { border-right: 0; }
    .process-grid article:last-child { border-bottom: 0; }
    .faq-list p { padding-right: 0; }
  }
</style>
