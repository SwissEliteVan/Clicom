---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt?: string;
  /** ratio CSS, ex. '21/9', '4/3', '1/1' — défaut '21/9' */
  ratio?: string;
  /** ratio mobile (<=700px) */
  ratioMobile?: string;
  position?: string;
  eager?: boolean;
  class?: string;
  sizes?: string;
}

const {
  src,
  alt = '',
  ratio = '21/9',
  ratioMobile = '4/3',
  position = 'center',
  eager = false,
  class: className = '',
  sizes = '(max-width: 700px) 100vw, (max-width: 1280px) calc(100vw - 48px), 1232px',
} = Astro.props;
---

<figure class:list={['editorial-image', className]} data-editorial style={`--ratio:${ratio};--ratio-m:${ratioMobile};--pos:${position}`}>
  <Picture
    src={src}
    alt={alt}
    widths={[480, 768, 1280, 1920]}
    sizes={sizes}
    formats={['avif', 'webp']}
    quality={82}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
</figure>

<style>
  .editorial-image {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-surface, 28px);
    aspect-ratio: var(--ratio);
    background: var(--color-midnight, #081126);
  }
  .editorial-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
  }
  @media (max-width: 700px) {
    .editorial-image { aspect-ratio: var(--ratio-m); border-radius: 20px; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-editorial]').forEach((el) => {
      const img = el.querySelector('img');
      gsap.fromTo(el,
        { clipPath: 'inset(12% 6% 12% 6% round 28px)', opacity: 0 },
        {
          clipPath: 'inset(0% 0% 0% 0% round 28px)', opacity: 1,
          duration: 1.2, ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 85%', once: true },
        }
      );
      if (img) {
        gsap.fromTo(img, { scale: 1.12 }, {
          scale: 1, duration: 1.6, ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 85%', once: true },
        });
      }
    });
  }
</script>
