---
const currentYear = new Date().getFullYear();
const path = Astro.url.pathname;
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label="Clicom, accueil">
          <span class="brand__mark" aria-hidden="true"><i></i><b>→</b></span>
          <span class="brand__name">clicom<span>.</span></span>
        </a>
        <p class="footer-tagline">Agence digitale indépendante.<br />Stratégie, création, performance.</p>
        <div class="footer-cta">
          <a href="/audit-gratuit/" class="button">Demander un audit gratuit <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="footer-col">
        <span class="footer-heading">Services</span>
        <a href="/services/">Tous les services</a>
        <a href="/creation-site-web/">Création de sites web</a>
        <a href="/seo/">SEO / Référencement</a>
        <a href="/referencement-ia/">Référencement IA / GEO</a>
        <a href="/google-ads/">Google Ads</a>
        <a href="/social-ads/">Publicité réseaux sociaux</a>
        <a href="/intelligence-artificielle/">Intelligence artificielle</a>
        <a href="/automatisation/">Automatisation</a>
        <a href="/email-marketing-crm/">CRM & e-mail marketing</a>
        <a href="/creation-contenu/">Création de contenu</a>
        <a href="/reseaux-sociaux/">Gestion des réseaux sociaux</a>
        <a href="/branding/">Branding</a>
      </div>

      <div class="footer-col">
        <span class="footer-heading">Ressources</span>
        <a href="/blog/">Blog</a>
        <a href="/ressources/">Ressources</a>
        <a href="/faq/">FAQ</a>
        <a href="/tarifs/">Tarifs</a>
        <a href="/methode/">Méthode</a>
        <a href="/realisations/">Réalisations</a>
        <a href="/secteurs/">Secteurs</a>
      </div>

      <div class="footer-col">
        <span class="footer-heading">Clicom</span>
        <a href="/agence/">Agence</a>
        <a href="/solutions/">Solutions</a>
        <a href="/contact/">Contact</a>
        <a href="/audit-gratuit/">Audit gratuit</a>
      </div>

      <div class="footer-col footer-col--legal">
        <span class="footer-heading">Légal</span>
        <a href="/mentions-legales/">Mentions légales</a>
        <a href="/politique-de-confidentialite/">Politique de confidentialité</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Clicom. Tous droits réservés.</p>
      <p class="footer-bottom__links">
        <a href="/mentions-legales/">Mentions légales</a>
        <span aria-hidden="true">·</span>
        <a href="/politique-de-confidentialite/">Politique de confidentialité</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding: 80px 0 0;
    background: var(--color-midnight);
    color: rgba(247, 249, 252, 0.75);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 40px;
    padding-bottom: 60px;
    border-bottom: 1px solid rgba(247, 249, 252, 0.1);
  }

  .footer-brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 16px;
  }

  .footer-brand .brand__mark {
    position: relative;
    display: flex;
    width: 34px;
    align-items: center;
    color: var(--color-cyan);
  }

  .footer-brand .brand__mark i {
    width: 8px;
    height: 8px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 0 5px rgba(0, 200, 255, 0.12);
  }

  .footer-brand .brand__mark::after {
    width: 13px;
    height: 1px;
    background: var(--color-cyan);
    content: '';
  }

  .footer-brand .brand__mark b {
    font-size: 1rem;
    font-weight: 650;
    line-height: 1;
  }

  .footer-brand .brand__name {
    font-size: 1.62rem;
    font-weight: 800;
    letter-spacing: -.07em;
    line-height: 1;
    color: white;
  }

  .footer-brand .brand__name span {
    color: var(--color-cyan);
  }

  .footer-tagline {
    margin-bottom: 24px;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .footer-cta .button {
    display: inline-flex;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 12px;
    background: var(--color-cyan);
    color: var(--color-midnight);
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: background var(--transition-fast), transform var(--transition-fast);
  }

  .footer-cta .button:hover {
    background: white;
    transform: translateY(-1px);
  }

  .footer-heading {
    display: block;
    margin-bottom: 20px;
    color: white;
    font-size: 0.78rem;
    font-weight: 780;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col a {
    color: rgba(247, 249, 252, 0.7);
    font-size: 0.86rem;
    font-weight: 600;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .footer-col a:hover {
    color: white;
    transform: translateX(3px);
  }

  .footer-col--legal a {
    font-size: 0.8rem;
    color: rgba(247, 249, 252, 0.5);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 0;
    font-size: 0.8rem;
    color: rgba(247, 249, 252, 0.45);
  }

  .footer-bottom__links {
    display: flex;
    gap: 8px;
  }

  .footer-bottom__links a {
    color: rgba(247, 249, 252, 0.5);
    transition: color var(--transition-fast);
  }

  .footer-bottom__links a:hover {
    color: white;
  }

  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 680px) {
    .site-footer {
      padding: 60px 0 0;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-bottom: 40px;
    }

    .footer-bottom {
      flex-direction: column;
      gap: 8px;
      text-align: center;
    }
  }
</style>