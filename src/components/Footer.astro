---
const links=[['Services','/services'],['Solutions','/solutions'],['Réalisations','/realisations'],['Agence','/agence'],['Ressources','/ressources'],['Contact','/contact']];
---
<footer><div class="container footer-grid"><div><a class="wordmark" href="/">clicom<span>.</span></a><p>Votre croissance digitale, construite avec précision.</p><div class="motif">●────→</div></div><div><h2>Navigation</h2>{links.map(([label,href])=><a href={href}>{label}</a>)}</div><div class="contact"><h2>Parlons croissance</h2><a href="tel:0788238950">078 823 89 50</a><a href="mailto:hello@clicom.ch">hello@clicom.ch</a></div></div><div class="container bottom"><span>© {new Date().getFullYear()} CLICOM</span><span>Swiss precision. Digital acceleration.</span></div></footer>
<style>footer{padding-top:clamp(64px,8vw,104px);color:#fff;background:var(--color-midnight)}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1.3fr;gap:48px;padding-bottom:72px}.wordmark{font-size:2.2rem;font-weight:800;letter-spacing:-.07em}.wordmark span,.motif{color:var(--color-cyan)}p,a,.bottom{color:var(--color-dark-muted)}h2{margin:7px 0 22px;font-size:.78rem;letter-spacing:.12em;text-transform:uppercase}.footer-grid>div:not(:first-child){display:flex;flex-direction:column;align-items:flex-start;gap:10px}.bottom{display:flex;justify-content:space-between;padding-block:24px;border-top:1px solid rgba(255,255,255,.1);font-size:.82rem}@media(max-width:700px){.footer-grid{grid-template-columns:1fr}.bottom{flex-direction:column;gap:8px}}</style>
