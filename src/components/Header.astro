---
import Button from './Button.astro';

const path = Astro.url.pathname;
const links = [
  ['/realisations', 'Projets'],
  ['/agence', 'À propos'],
  ['/contact', 'Contact'],
];
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Clicom, accueil">
      <span class="brand__mark" aria-hidden="true"><i></i><b>→</b></span>
      <span class="brand__name">clicom<span>.</span></span>
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      {links.map(([href, label]) => <a class:list={{ active: path.startsWith(href) }} href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
    </nav>

    <Button href="/audit-gratuit/" class="header-cta">Audit gratuit <span aria-hidden="true">→</span></Button>

    <details class="mobile-menu" data-menu>
      <summary aria-label="Ouvrir la navigation" aria-expanded="false">
        <span></span><span></span><span></span>
      </summary>
      <div class="mobile-menu__panel">
        <div class="mobile-menu__top">
          <span>Navigation</span>
          <span class="brand__name">clicom<span>.</span></span>
        </div>
        {links.map(([href, label]) => <a class:list={{ active: path.startsWith(href) }} href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}<span>→</span></a>)}
        <a class:list={{ active: path.startsWith('/services') }} href="/services" aria-current={path.startsWith('/services') ? 'page' : undefined}>Services<span>→</span></a>
        <div class="mobile-menu__services">
          <span>Piliers du système</span>
          <div><a href="/creation-site-web/">Sites web</a><a href="/seo/">SEO</a><a href="/google-ads/">Publicité</a><a href="/automatisation/">Automatisation</a></div>
        </div>
        <Button href="/audit-gratuit/">Demander un audit gratuit <span aria-hidden="true">→</span></Button>
      </div>
    </details>
  </div>
</header>

<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>('[data-menu]');

  const closeMenu = (menu: HTMLDetailsElement) => {
    menu.open = false;
    menu.querySelector('summary')?.setAttribute('aria-expanded', 'false');
  };

  menus.forEach((menu) => {
    const trigger = menu.querySelector('summary');
    menu.addEventListener('toggle', () => {
      trigger?.setAttribute('aria-expanded', String(menu.open));
      if (menu.open) menus.forEach((other) => other !== menu && closeMenu(other));
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu(menu)));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      const openMenu = Array.from(menus).find((menu) => menu.open);
      menus.forEach(closeMenu);
      openMenu?.querySelector<HTMLElement>('summary')?.focus();
    }
  });

  document.addEventListener('pointerdown', (event) => {
    if (event.target instanceof Node) menus.forEach((menu) => !menu.contains(event.target as Node) && closeMenu(menu));
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: var(--z-header); border-bottom: 1px solid rgba(228,232,240,.9); background: rgba(248,250,252,.82); backdrop-filter: blur(18px) saturate(140%); }
  .header-inner { position: relative; display: flex; height: 72px; align-items: center; gap: clamp(20px, 2.4vw, 36px); }
  .brand { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 11px; margin-right: auto; }
  .brand__mark { position: relative; display: flex; width: 34px; align-items: center; color: var(--color-primary); }
  .brand__mark i { width: 8px; height: 8px; flex: 0 0 auto; border-radius: 50%; background: var(--color-primary); box-shadow: 0 0 0 5px rgba(36,87,255,.09); }
  .brand__mark::after { width: 13px; height: 1px; background: var(--color-primary); content: ''; }
  .brand__mark b { font-size: 1rem; font-weight: 650; line-height: 1; }
  .brand__name { font-size: 1.55rem; font-weight: 800; letter-spacing: -.07em; line-height: 1; }
  .brand__name span { color: var(--color-primary); }
  .desktop-nav { display: flex; height: 100%; align-items: center; gap: clamp(18px, 2vw, 30px); }
  .desktop-nav > a { position: relative; display: flex; min-height: 44px; align-items: center; color: var(--color-text-muted); font-size: .9rem; font-weight: 650; transition: color var(--transition-fast); }
  .desktop-nav > a::after { position: absolute; right: 50%; bottom: -1px; left: 50%; height: 2px; border-radius: 2px; background: var(--color-primary); content: ''; transition: right var(--transition-fast), left var(--transition-fast); }
  .desktop-nav > a:hover, .desktop-nav > a.active { color: var(--color-midnight); }
  .desktop-nav > a:hover::after, .desktop-nav > a.active::after { right: 0; left: 0; }
  .header-cta { min-height: 42px; padding: 10px 16px; font-size: .82rem; }
  .mobile-menu { display: none; }

  @media (max-width: 760px) {
    .desktop-nav, .header-inner > :global(.header-cta) { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu > summary { display: grid; width: 44px; height: 44px; place-content: center; gap: 5px; border: 1px solid var(--color-border-strong); border-radius: 12px; background: white; box-shadow: 0 4px 14px rgba(8,17,38,.05); cursor: pointer; list-style: none; }
    .mobile-menu > summary::-webkit-details-marker { display: none; }
    .mobile-menu > summary span { display: block; width: 20px; height: 2px; border-radius: 2px; background: var(--color-midnight); transition: transform var(--transition-fast), opacity var(--transition-fast); }
    .mobile-menu[open] > summary span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .mobile-menu[open] > summary span:nth-child(2) { opacity: 0; }
    .mobile-menu[open] > summary span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .mobile-menu__panel { position: absolute; top: calc(100% + 12px); right: 0; left: 0; display: none; gap: 3px; max-height: calc(100vh - 104px); padding: 18px; overflow-y: auto; border: 1px solid var(--color-border); border-radius: 20px; background: rgba(255,255,255,.98); box-shadow: var(--shadow-featured); }
    .mobile-menu[open] .mobile-menu__panel { display: grid; animation: mobile-menu-in var(--transition-smooth) var(--ease-out); }
    @keyframes mobile-menu-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
    .mobile-menu__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; padding: 2px 8px 14px; border-bottom: 1px solid var(--color-border); color: var(--color-text-muted); font-size: .7rem; font-weight: 760; letter-spacing: .13em; text-transform: uppercase; }
    .mobile-menu__top .brand__name { font-size: 1.3rem; text-transform: none; }
    .mobile-menu__panel > a:not(.button) { display: flex; min-height: 48px; align-items: center; justify-content: space-between; padding: 10px 12px; border-radius: 10px; color: var(--color-midnight); font-size: 1rem; font-weight: 680; }
    .mobile-menu__panel > a.active { color: var(--color-primary); background: var(--color-primary-soft); }
    .mobile-menu__panel > a span { color: var(--color-primary); }
    .mobile-menu__services { margin-block: 10px; padding: 16px 12px; border-block: 1px solid var(--color-border); }
    .mobile-menu__services > span { display: block; margin-bottom: 12px; color: var(--color-text-muted); font-size: .68rem; font-weight: 760; letter-spacing: .12em; text-transform: uppercase; }
    .mobile-menu__services div { display: flex; flex-wrap: wrap; gap: 8px; }
    .mobile-menu__services a { padding: 7px 10px; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-text-muted); font-size: .78rem; font-weight: 650; }
    .mobile-menu__panel > :global(.button) { width: 100%; margin-top: 8px; }
  }

  @media (max-width: 480px) {
    .header-inner { height: 66px; }
    .brand__mark { width: 31px; }
    .brand__name { font-size: 1.42rem; }
    .mobile-menu__panel { right: -2px; left: -2px; border-radius: 16px; }
  }
</style>
