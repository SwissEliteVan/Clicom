---
import Button from './Button.astro';

const path = Astro.url.pathname;
const servicePaths = ['/services','/creation-site-web','/seo','/referencement-ia','/google-ads','/social-ads','/reseaux-sociaux','/creation-contenu','/branding','/intelligence-artificielle','/automatisation','/email-marketing-crm'];
const serviceActive = servicePaths.some((href) => path.startsWith(href));
const clicomPaths = ['/agence','/methode','/solutions','/secteurs','/ressources','/tarifs','/faq'];
const clicomActive = clicomPaths.some((href) => path.startsWith(href));

const serviceGroups = [
  {
    title: 'Acquisition',
    links: [
      ['/seo/', 'SEO'],
      ['/referencement-ia/', 'Référencement IA'],
      ['/google-ads/', 'Google Ads'],
      ['/social-ads/', 'Publicité sur les réseaux sociaux'],
    ],
  },
  {
    title: 'Création',
    links: [
      ['/creation-site-web/', 'Sites web'],
      ['/creation-contenu/', 'Contenu'],
      ['/reseaux-sociaux/', 'Gestion des réseaux sociaux'],
      ['/branding/', 'Branding'],
    ],
  },
  {
    title: 'Technologie',
    links: [
      ['/intelligence-artificielle/', 'Intelligence artificielle'],
      ['/automatisation/', 'Automatisation'],
      ['/email-marketing-crm/', 'CRM & e-mail'],
    ],
  },
];

const clicomGroups = [
  {
    title: 'Découvrir CLICOM',
    links: [
      ['/agence/', "L'agence", 'Présentation de CLICOM'],
      ['/methode/', 'Notre méthode', 'Notre manière de travailler'],
      ['/solutions/', 'Solutions', 'Découvrir les solutions proposées'],
      ['/secteurs/', 'Secteurs', 'Solutions adaptées à chaque profil'],
    ],
  },
  {
    title: 'Informations',
    links: [
      ['/ressources/', 'Ressources', 'Guides et contenus utiles'],
      ['/tarifs/', 'Tarifs', 'Comprendre notre approche tarifaire'],
      ['/faq/', 'FAQ', 'Questions fréquentes'],
    ],
  },
];
---

<header class="site-header" data-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Clicom, accueil">
      <span class="brand__mark" aria-hidden="true"><i></i><b>→</b></span>
      <span class="brand__name">clicom<span>.</span></span>
    </a>

    <nav class="desktop-nav" aria-label="Navigation principale">
      <details class="services-menu" data-menu>
        <summary class:list={{ active: serviceActive }} aria-haspopup="true" aria-expanded="false">
          Services <span aria-hidden="true">⌄</span>
        </summary>
        <div class="mega-menu">
          <div class="mega-menu__intro">
            <span class="mega-menu__kicker">Expertises Clicom</span>
            <strong>Attirer. Convertir.<br />Automatiser. Accélérer.</strong>
            <a href="/services">Voir tous les services <span aria-hidden="true">→</span></a>
          </div>
          {serviceGroups.map((group) => (
            <div class="mega-menu__group">
              <span>{group.title}</span>
              {group.links.map(([href, label]) => <a href={href}>{label}</a>)}
            </div>
          ))}
        </div>
      </details>
      <a class:list={{ active: path.startsWith('/realisations') }} href="/realisations/" aria-current={path.startsWith('/realisations') ? 'page' : undefined}>Réalisations</a>
      <a class:list={{ active: path.startsWith('/blog') }} href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog</a>

      <details class="clicom-menu" data-menu>
        <summary class:list={{ active: clicomActive }} aria-haspopup="true" aria-expanded="false">
          CLICOM <span aria-hidden="true">⌄</span>
        </summary>
        <div class="clicom-dropdown">
          {clicomGroups.map((group) => (
            <div class="clicom-dropdown__group">
              <span>{group.title}</span>
              {group.links.map(([href, label, desc]) => (
                <a href={href}>
                  <strong>{label}</strong>
                  <small>{desc}</small>
                </a>
              ))}
            </div>
          ))}
        </div>
      </details>
      <a class:list={{ active: path.startsWith('/contact') }} href="/contact/" aria-current={path.startsWith('/contact') ? 'page' : undefined}>Contact</a>
    </nav>

    <Button href="/audit-gratuit/" class="header-cta">Demander un audit <span aria-hidden="true">→</span></Button>

    <details class="mobile-menu" data-menu>
      <summary aria-label="Ouvrir la navigation" aria-expanded="false">
        <span></span><span></span><span></span>
      </summary>
      <div class="mobile-menu__panel">
        <div class="mobile-menu__top">
          <span>Navigation</span>
          <span class="brand__name">clicom<span>.</span></span>
        </div>

        <details class="mobile-menu__accordion" data-mobile-accordion>
          <summary aria-expanded="false">Services <span aria-hidden="true">+</span></summary>
          <div class="mobile-menu__sublinks">
            <a href="/services">Tous les services <span>→</span></a>
            <a href="/creation-site-web/">Sites web</a>
            <a href="/seo/">SEO</a>
            <a href="/referencement-ia/">Référencement IA</a>
            <a href="/google-ads/">Google Ads</a>
            <a href="/social-ads/">Publicité sur les réseaux sociaux</a>
            <a href="/reseaux-sociaux/">Gestion des réseaux sociaux</a>
            <a href="/creation-contenu/">Création de contenu</a>
            <a href="/branding/">Branding</a>
            <a href="/intelligence-artificielle/">Intelligence artificielle</a>
            <a href="/automatisation/">Automatisation</a>
            <a href="/email-marketing-crm/">CRM & e-mail</a>
          </div>
        </details>

        <a class:list={{ active: path.startsWith('/realisations') }} href="/realisations/" aria-current={path.startsWith('/realisations') ? 'page' : undefined}>Réalisations <span>→</span></a>
        <a class:list={{ active: path.startsWith('/blog') }} href="/blog/" aria-current={path.startsWith('/blog') ? 'page' : undefined}>Blog <span>→</span></a>

        <details class="mobile-menu__accordion" data-mobile-accordion>
          <summary aria-expanded="false">CLICOM <span aria-hidden="true">+</span></summary>
          <div class="mobile-menu__sublinks">
            <a href="/agence/">L'agence</a>
            <a href="/methode/">Notre méthode</a>
            <a href="/solutions/">Solutions</a>
            <a href="/secteurs/">Secteurs</a>
            <a href="/ressources/">Ressources</a>
            <a href="/tarifs/">Tarifs</a>
            <a href="/faq/">FAQ</a>
          </div>
        </details>

        <a class:list={{ active: path.startsWith('/contact') }} href="/contact/" aria-current={path.startsWith('/contact') ? 'page' : undefined}>Contact <span>→</span></a>
        <Button href="/audit-gratuit/">Demander un audit <span aria-hidden="true">→</span></Button>
      </div>
    </details>
  </div>
</header>

<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>('[data-menu]');
  const header = document.querySelector<HTMLElement>('[data-header]');
  const isHome = document.body.classList.contains('home-page');

  const closeMenu = (menu: HTMLDetailsElement) => {
    menu.open = false;
    menu.querySelector('summary')?.setAttribute('aria-expanded', 'false');
  };

  menus.forEach((menu) => {
    const trigger = menu.querySelector('summary');
    menu.addEventListener('toggle', () => {
      trigger?.setAttribute('aria-expanded', String(menu.open));
      if (menu.open) menus.forEach((other) => other !== menu && closeMenu(other));
    });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu(menu)));
  });

  // Mobile accordions
  const accordions = document.querySelectorAll<HTMLDetailsElement>('[data-mobile-accordion]');
  accordions.forEach((acc) => {
    const trigger = acc.querySelector('summary');
    acc.addEventListener('toggle', () => {
      trigger?.setAttribute('aria-expanded', String(acc.open));
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      const openMenu = Array.from(menus).find((menu) => menu.open);
      menus.forEach(closeMenu);
      openMenu?.querySelector<HTMLElement>('summary')?.focus();
    }
  });

  document.addEventListener('pointerdown', (event) => {
    if (event.target instanceof Node) menus.forEach((menu) => !menu.contains(event.target as Node) && closeMenu(menu));
  });

  if (header && isHome) {
    let scheduled = false;

    const updateHeader = () => {
      scheduled = false;
      header.classList.toggle('is-scrolled', window.scrollY > 24);
    };

    const onScroll = () => {
      if (scheduled) return;
      scheduled = true;
      window.requestAnimationFrame(updateHeader);
    };

    updateHeader();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: var(--z-header); border-bottom: 1px solid rgba(228,232,240,.82); background: rgba(247,249,252,.86); backdrop-filter: blur(18px) saturate(140%); transition: background-color var(--transition-base), border-color var(--transition-base), backdrop-filter var(--transition-base), box-shadow var(--transition-base); }
  .header-inner { position: relative; display: flex; height: 82px; align-items: center; gap: clamp(20px, 2.4vw, 36px); }
  .brand { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 11px; margin-right: auto; }
  .brand__mark { position: relative; display: flex; width: 34px; align-items: center; color: var(--color-primary); }
  .brand__mark i { width: 8px; height: 8px; flex: 0 0 auto; border-radius: 50%; background: var(--color-primary); box-shadow: 0 0 0 5px rgba(36,87,255,.09); }
  .brand__mark::after { width: 13px; height: 1px; background: var(--color-primary); content: ''; }
  .brand__mark b { font-size: 1rem; font-weight: 650; line-height: 1; }
  .brand__name { font-size: 1.62rem; font-weight: 800; letter-spacing: -.07em; line-height: 1; }
  .brand__name span { color: var(--color-primary); }
  .desktop-nav { display: flex; height: 100%; align-items: center; gap: clamp(15px, 1.7vw, 25px); }
  .desktop-nav > a, .services-menu > summary, .clicom-menu > summary { position: relative; display: flex; min-height: 44px; align-items: center; color: var(--color-text-muted); font-size: .86rem; font-weight: 680; cursor: pointer; list-style: none; transition: color var(--transition-fast); }
  .services-menu > summary::-webkit-details-marker, .clicom-menu > summary::-webkit-details-marker { display: none; }
  .services-menu > summary span, .clicom-menu > summary span { margin-left: 5px; font-size: .78rem; transition: transform var(--transition-fast); }
  .services-menu[open] > summary span, .clicom-menu[open] > summary span { transform: rotate(180deg); }
  .desktop-nav > a::after, .services-menu > summary::after, .clicom-menu > summary::after { position: absolute; right: 50%; bottom: -1px; left: 50%; height: 2px; border-radius: 2px; background: var(--color-primary); content: ''; transition: right var(--transition-fast), left var(--transition-fast); }
  .desktop-nav > a:hover, .desktop-nav > a.active, .services-menu > summary:hover, .services-menu > summary.active, .services-menu[open] > summary, .clicom-menu > summary:hover, .clicom-menu > summary.active, .clicom-menu[open] > summary { color: var(--color-midnight); }
  .desktop-nav > a:hover::after, .desktop-nav > a.active::after, .services-menu > summary:hover::after, .services-menu > summary.active::after, .services-menu[open] > summary::after, .clicom-menu > summary:hover::after, .clicom-menu > summary.active::after, .clicom-menu[open] > summary::after { right: 0; left: 0; }
  .services-menu, .clicom-menu { position: relative; height: 100%; }
  .services-menu > summary, .clicom-menu > summary { height: 100%; }
  .mega-menu { position: absolute; top: calc(100% + 12px); right: 0; left: 0; display: grid; grid-template-columns: 1.25fr repeat(3, 1fr); gap: 1px; padding: 10px; overflow: hidden; border: 1px solid var(--color-border); border-radius: 24px; background: var(--color-border); box-shadow: var(--shadow-featured); }
  .mega-menu::before { position: fixed; inset: 82px 0 0; z-index: -1; background: rgba(8,17,38,.08); content: ''; backdrop-filter: blur(2px); }
  .mega-menu__intro, .mega-menu__group { min-width: 0; padding: 27px; background: white; }
  .mega-menu__intro { border-radius: 15px 0 0 15px; background: var(--color-midnight); }
  .mega-menu__kicker, .mega-menu__group > span { display: block; margin-bottom: 19px; color: var(--color-primary); font-size: .67rem; font-weight: 780; letter-spacing: .14em; text-transform: uppercase; }
  .mega-menu__intro strong { display: block; margin-bottom: 24px; color: white; font-size: 1.24rem; line-height: 1.28; letter-spacing: -.035em; }
  .mega-menu__intro a { display: inline-flex; gap: 8px; color: var(--color-cyan); font-size: .82rem; font-weight: 700; }
  .mega-menu__group { display: flex; flex-direction: column; align-items: flex-start; gap: 7px; }
  .mega-menu__group:last-child { border-radius: 0 15px 15px 0; }
  .mega-menu__group > span { color: var(--color-text-muted); }
  .mega-menu__group a { width: 100%; padding: 7px 0; color: var(--color-midnight); font-size: .86rem; font-weight: 650; transition: color var(--transition-fast), transform var(--transition-fast); }
  .mega-menu__group a:hover { color: var(--color-primary); transform: translateX(3px); }
  .clicom-dropdown { position: absolute; top: calc(100% + 12px); right: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1px; width: 520px; padding: 10px; overflow: hidden; border: 1px solid var(--color-border); border-radius: 20px; background: var(--color-border); box-shadow: var(--shadow-featured); }
  .clicom-dropdown::before { position: fixed; inset: 82px 0 0; z-index: -1; background: rgba(8,17,38,.08); content: ''; backdrop-filter: blur(2px); }
  .clicom-dropdown__group { min-width: 0; display: flex; flex-direction: column; gap: 4px; padding: 22px; background: white; }
  .clicom-dropdown__group:first-child { border-radius: 11px 0 0 11px; }
  .clicom-dropdown__group:last-child { border-radius: 0 11px 11px 0; }
  .clicom-dropdown__group > span { display: block; margin-bottom: 12px; color: var(--color-text-muted); font-size: .65rem; font-weight: 780; letter-spacing: .14em; text-transform: uppercase; }
  .clicom-dropdown__group a { display: flex; flex-direction: column; gap: 2px; padding: 9px 10px; border-radius: 10px; color: var(--color-midnight); transition: color var(--transition-fast), background var(--transition-fast); }
  .clicom-dropdown__group a strong { font-size: .86rem; font-weight: 680; }
  .clicom-dropdown__group a small { font-size: .74rem; font-weight: 550; color: var(--color-text-muted); line-height: 1.4; }
  .clicom-dropdown__group a:hover { color: var(--color-primary); background: var(--color-primary-soft); }
  .clicom-dropdown__group a:hover small { color: var(--color-text-muted); }
  .header-cta { min-height: 46px; padding: 12px 17px; font-size: .82rem; text-transform: uppercase; letter-spacing: .04em; }
  .mobile-menu { display: none; }

  @media (max-width: 1100px) {
    .desktop-nav, .header-inner > :global(.header-cta) { display: none; }
    .mobile-menu { display: block; }
    .mobile-menu > summary { display: grid; width: 46px; height: 46px; place-content: center; gap: 5px; border: 1px solid var(--color-border-strong); border-radius: 12px; background: white; box-shadow: 0 4px 14px rgba(8,17,38,.05); cursor: pointer; list-style: none; }
    .mobile-menu > summary::-webkit-details-marker { display: none; }
    .mobile-menu > summary span { display: block; width: 20px; height: 2px; border-radius: 2px; background: var(--color-midnight); transition: transform var(--transition-fast), opacity var(--transition-fast); }
    .mobile-menu[open] > summary span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .mobile-menu[open] > summary span:nth-child(2) { opacity: 0; }
    .mobile-menu[open] > summary span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .mobile-menu__panel { position: absolute; top: calc(100% + 12px); right: 0; left: 0; display: grid; gap: 3px; max-height: calc(100vh - 112px); padding: 18px; overflow-y: auto; border: 1px solid var(--color-border); border-radius: 22px; background: rgba(255,255,255,.98); box-shadow: var(--shadow-featured); }
    .mobile-menu__top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; padding: 2px 8px 14px; border-bottom: 1px solid var(--color-border); color: var(--color-text-muted); font-size: .7rem; font-weight: 760; letter-spacing: .13em; text-transform: uppercase; }
    .mobile-menu__top .brand__name { font-size: 1.3rem; text-transform: none; }
    .mobile-menu__panel > a:not(.button) { display: flex; min-height: 48px; align-items: center; justify-content: space-between; padding: 10px 12px; border-radius: 10px; color: var(--color-midnight); font-size: 1rem; font-weight: 680; }
    .mobile-menu__panel > a.active { color: var(--color-primary); background: var(--color-primary-soft); }
    .mobile-menu__panel > a span { color: var(--color-primary); }
    .mobile-menu__accordion { border-radius: 10px; }
    .mobile-menu__accordion summary { display: flex; min-height: 48px; align-items: center; justify-content: space-between; padding: 10px 12px; border-radius: 10px; color: var(--color-midnight); font-size: 1rem; font-weight: 680; cursor: pointer; list-style: none; }
    .mobile-menu__accordion summary::-webkit-details-marker { display: none; }
    .mobile-menu__accordion summary span { color: var(--color-primary); font-size: 1.3rem; transition: transform var(--transition-fast); }
    .mobile-menu__accordion[open] summary span { transform: rotate(45deg); }
    .mobile-menu__accordion[open] { background: var(--color-primary-soft); }
    .mobile-menu__accordion[open] > summary { border-bottom: 1px solid var(--color-border); }
    .mobile-menu__sublinks { display: grid; gap: 2px; padding: 4px 12px 12px; }
    .mobile-menu__sublinks a { display: flex; min-height: 40px; align-items: center; justify-content: space-between; padding: 6px 8px 6px 16px; border-radius: 8px; color: var(--color-text-muted); font-size: .9rem; font-weight: 650; }
    .mobile-menu__sublinks a:first-child { color: var(--color-primary); font-weight: 720; }
    .mobile-menu__sublinks a span { color: var(--color-primary); font-size: .85rem; }
    .mobile-menu__panel > :global(.button) { width: 100%; margin-top: 8px; }
  }

  @media (max-width: 680px) {
    .header-inner { height: 72px; }
    .brand__mark { width: 31px; }
    .brand__name { font-size: 1.5rem; }
    .mobile-menu__panel { right: -2px; left: -2px; border-radius: 18px; }
  }

  :global(body.home-page) .site-header {
    position: fixed;
    right: 0;
    left: 0;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg,rgba(8,17,38,.44),rgba(8,17,38,.05));
    backdrop-filter: none;
    color: white;
  }

  :global(body.home-page) .site-header.is-scrolled {
    top: 10px;
    right: 16px;
    left: 16px;
    border: 1px solid rgba(228, 232, 240, 0.68);
    border-radius: 18px;
    border-bottom-color: rgba(228, 232, 240, 0.68);
    background: rgba(247, 249, 252, 0.88);
    box-shadow: 0 10px 30px rgba(8, 17, 38, 0.08);
    backdrop-filter: blur(20px) saturate(140%);
    color: var(--color-midnight);
  }

  :global(body.home-page) .brand__mark,
  :global(body.home-page) .brand__name,
  :global(body.home-page) .desktop-nav > a,
  :global(body.home-page) .services-menu > summary,
  :global(body.home-page) .clicom-menu > summary {
    color: rgba(247, 249, 252, 0.88);
  }

  :global(body.home-page) .site-header.is-scrolled .brand__mark,
  :global(body.home-page) .site-header.is-scrolled .brand__name,
  :global(body.home-page) .site-header.is-scrolled .desktop-nav > a,
  :global(body.home-page) .site-header.is-scrolled .services-menu > summary,
  :global(body.home-page) .site-header.is-scrolled .clicom-menu > summary {
    color: var(--color-text-muted);
  }

  :global(body.home-page) .desktop-nav > a:hover,
  :global(body.home-page) .desktop-nav > a.active,
  :global(body.home-page) .services-menu > summary:hover,
  :global(body.home-page) .services-menu > summary.active,
  :global(body.home-page) .services-menu[open] > summary,
  :global(body.home-page) .clicom-menu > summary:hover,
  :global(body.home-page) .clicom-menu > summary.active,
  :global(body.home-page) .clicom-menu[open] > summary {
    color: white;
  }

  :global(body.home-page) .site-header.is-scrolled .desktop-nav > a:hover,
  :global(body.home-page) .site-header.is-scrolled .desktop-nav > a.active,
  :global(body.home-page) .site-header.is-scrolled .services-menu > summary:hover,
  :global(body.home-page) .site-header.is-scrolled .services-menu > summary.active,
  :global(body.home-page) .site-header.is-scrolled .services-menu[open] > summary,
  :global(body.home-page) .site-header.is-scrolled .clicom-menu > summary:hover,
  :global(body.home-page) .site-header.is-scrolled .clicom-menu > summary.active,
  :global(body.home-page) .site-header.is-scrolled .clicom-menu[open] > summary { color: var(--color-midnight); }

  :global(body.home-page) .brand__mark i,
  :global(body.home-page) .brand__mark::after,
  :global(body.home-page) .desktop-nav > a::after,
  :global(body.home-page) .services-menu > summary::after,
  :global(body.home-page) .clicom-menu > summary::after {
    background: var(--color-cyan);
  }

  :global(body.home-page) .site-header.is-scrolled .brand__mark i,
  :global(body.home-page) .site-header.is-scrolled .brand__mark::after,
  :global(body.home-page) .site-header.is-scrolled .desktop-nav > a::after,
  :global(body.home-page) .site-header.is-scrolled .services-menu > summary::after,
  :global(body.home-page) .site-header.is-scrolled .clicom-menu > summary::after {
    background: var(--color-primary);
  }

  :global(body.home-page) .header-cta {
    color: var(--color-midnight);
    background: rgba(255, 255, 255, 0.92);
    border-color: rgba(255, 255, 255, 0.2);
  }

  :global(body.home-page) .header-cta:hover {
    background: white;
  }

  :global(body.home-page) .mobile-menu > summary {
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.9);
  }

  @media (max-width: 680px) {
    :global(body.home-page) .site-header.is-scrolled { top: 8px; right: 8px; left: 8px; border-radius: 15px; }
  }
</style>