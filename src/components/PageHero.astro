---
import Button from './Button.astro';
import CalendlyButton from './conversion/CalendlyButton.astro';
import VisualBand from './visuals/VisualBand.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  secondary?: string;
  secondaryLabel?: string;
  primary?: string;
  primaryLabel?: string;
  primaryCalendly?: boolean;
  showBand?: boolean;
}

const {
  eyebrow,
  title,
  intro,
  secondary,
  secondaryLabel = 'Découvrir nos services',
  primary = '/contact#audit',
  primaryLabel = 'Parler de mon projet →',
  primaryCalendly = false,
  showBand = true,
} = Astro.props;
const bands = {
  Services: { type: 'services' as const, eyebrow: 'Système CLICOM', title: 'Trois forces, une même trajectoire.', text: 'Acquisition, création et technologie deviennent un système cohérent.' },
  'Audit gratuit': { type: 'audit' as const, eyebrow: 'Diagnostic visuel', title: 'Six signaux observés comme un seul système.', text: 'Site, visibilité, acquisition, social, IA et conversion sont reliés sans score artificiel.' },
  Blog: { type: 'editorial' as const, eyebrow: 'Lecture structurée', title: 'Des signaux transformés en décisions.', text: 'Une grille éditoriale légère relie les sujets, les analyses et les prochaines actions.' },
  Ressources: { type: 'editorial' as const, eyebrow: 'Cartographie éditoriale', title: 'Trouver le bon point d’entrée.', text: 'Les contenus sont reliés par intention plutôt qu’empilés comme une bibliothèque générique.' },
};
const band = bands[eyebrow as keyof typeof bands];
---

<section class="page-hero">
  <div class="container page-hero__inner">
    <div class="page-hero__copy">
      <div class="eyebrow">{eyebrow}</div>
      <h1 set:html={title}></h1>
      <p>{intro}</p>
      <div class="button-row">
        {primaryCalendly ? <CalendlyButton label={primaryLabel} /> : <Button href={primary}>{primaryLabel}</Button>}
        {secondary && <Button href={secondary} variant="secondary">{secondaryLabel}</Button>}
      </div>
    </div>
    <div class="hero-mark" aria-hidden="true">
      <span class="hero-mark__kicker">CLICOM · SUISSE ROMANDE</span>
      <p class="hero-mark__quote">Un digital structuré comme un actif stratégique pour votre entreprise.</p>
      <div class="hero-mark__footer">
        <span>Ingénierie &amp; Conseil</span>
        <span>PME romandes</span>
      </div>
    </div>
  </div>
</section>
{showBand && band && <VisualBand {...band} />}

<style>
  .button-row :global(.calendly-wrap) { display: inline-flex; }

  @media (max-width: 680px) {
    .button-row :global(.calendly-wrap),
    .button-row :global(.calendly-wrap .button) { width: 100%; }
  }
</style>
