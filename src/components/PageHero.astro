---
import Button from './Button.astro';interface Props{eyebrow:string;title:string;intro:string;secondary?:string};const{eyebrow,title,intro,secondary}=Astro.props;---
<section class="page-hero"><div class="container page-hero__inner"><div class="page-hero__copy"><div class="eyebrow">{eyebrow}</div><h1 set:html={title}></h1><p>{intro}</p><div class="button-row"><Button href="/contact#audit">Parler de mon projet →</Button>{secondary&&<Button href={secondary} variant="secondary">Découvrir nos services</Button>}</div></div><div class="hero-mark" aria-hidden="true"><div class="hero-mark__line"></div><span class="hero-mark__dot"></span><span class="hero-mark__arrow">→</span><span class="hero-mark__label hero-mark__label--a">STRATÉGIE</span><span class="hero-mark__label hero-mark__label--b">CROISSANCE</span></div></div></section>
