---
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import Button from './Button.astro';

interface Item { title: string; text: string }
interface FAQ { question: string; answer: string }
interface Link { href: string; label: string }
interface Props {
  title: string; description: string; eyebrow: string; h1: string; intro: string;
  problems: Item[]; services: Item[]; method: Item[]; faq: FAQ[]; links: Link[];
  variant?: 'standard' | 'offset';
}
const { title, description, eyebrow, h1, intro, problems, services, method, faq, links, variant = 'standard' } = Astro.props;
---
<Layout {title} {description}>
  <PageHero {eyebrow} title={h1} {intro} primary="/audit-gratuit/" primaryLabel="Demander un audit →" secondary="/secteurs/" secondaryLabel="Voir tous les secteurs" />
  <section class="section section--white"><div class:list={['container','sector-split',{'sector-split--offset':variant==='offset'}]}><div class="section-heading"><div class="eyebrow">Problématiques</div><h2>Des enjeux propres à votre <span class="accent">activité.</span></h2><p>Nous partons de votre réalité commerciale, de votre territoire et de vos ressources avant de choisir les leviers.</p></div><div class="problem-list">{problems.map((item,i)=><article><span>0{i+1}</span><div><h3>{item.title}</h3><p>{item.text}</p></div></article>)}</div></div></section>
  <section class="section section--dark"><div class="container"><div class="section-heading"><div class="eyebrow">Services pertinents</div><h2>Un système pour attirer, convertir et <span class="gradient-text">accélérer.</span></h2></div><div class:list={['grid','grid--3','sector-services',{'sector-services--offset':variant==='offset'}]}>{services.map(item=><article class="card"><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>
  <section class="section section--white"><div class="container"><div class="section-heading"><div class="eyebrow">Méthode</div><h2>Des priorités claires, puis une <span class="accent">exécution mesurable.</span></h2></div><div class="method">{method.map((item,i)=><article><span>{String(i+1).padStart(2,'0')}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>
  <section class="section"><div class="container faq"><div class="section-heading"><div class="eyebrow">FAQ</div><h2>Questions fréquentes.</h2></div>{faq.map(item=><details><summary>{item.question}<span aria-hidden="true">+</span></summary><p>{item.answer}</p></details>)}<nav class="related" aria-label="Liens associés">{links.map(link=><a href={link.href}>{link.label} →</a>)}</nav></div></section>
  <section class="section section--white"><div class="container"><div class="cta-panel"><div><h2>Identifions les leviers adaptés à votre secteur.</h2><p>Un audit permet de cadrer les priorités sans ajouter de complexité inutile.</p></div><Button href="/audit-gratuit/">Demander un audit gratuit →</Button></div></div></section>
</Layout>
<style>
  .sector-split{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(50px,8vw,110px)}.sector-split--offset{grid-template-columns:1.15fr .85fr}.sector-split--offset .section-heading{order:2}.problem-list{border-top:1px solid var(--color-border)}.problem-list article{display:grid;grid-template-columns:48px 1fr;gap:20px;padding:26px 0;border-bottom:1px solid var(--color-border)}.problem-list span,.method span{color:var(--color-primary);font-size:.75rem;font-weight:780}.problem-list h3{margin-bottom:7px}.problem-list p{margin:0}.sector-services--offset .card:first-child{grid-column:span 2;background:rgba(255,255,255,.08)}.method{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--color-border)}.method article{padding:30px;border-right:1px solid var(--color-border)}.method article:last-child{border:0}.method h3{margin-top:28px}.faq{max-width:940px}.faq details{border-bottom:1px solid var(--color-border)}.faq summary{display:flex;min-height:78px;align-items:center;justify-content:space-between;gap:20px;cursor:pointer;font-weight:720;list-style:none}.faq summary::-webkit-details-marker{display:none}.faq summary span{color:var(--color-primary);font-size:1.5rem}.faq details[open] summary span{transform:rotate(45deg)}.faq details p{padding-right:40px}.related{display:flex;flex-wrap:wrap;gap:10px;margin-top:42px}.related a{padding:9px 13px;border:1px solid var(--color-border);border-radius:999px;color:var(--color-primary);font-size:.84rem;font-weight:680}@media(max-width:900px){.sector-split,.sector-split--offset{grid-template-columns:1fr}.sector-split--offset .section-heading{order:initial}.method{grid-template-columns:repeat(2,1fr)}.sector-services--offset .card:first-child{grid-column:auto}}@media(max-width:580px){.method{grid-template-columns:1fr}.method article{padding-inline:0;border-right:0;border-bottom:1px solid var(--color-border)}.faq details p{padding-right:0}}
</style>
