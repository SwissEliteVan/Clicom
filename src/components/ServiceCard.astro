---
import Icon from './Icon.astro';

interface Props {
  title: string;
  text: string;
  icon: 'search' | 'cursor' | 'chart' | 'globe' | 'automation' | 'target' | 'code' | 'spark';
  href?: string;
  id?: string;
  variant?: 'standard' | 'highlighted';
}

const { title, text, icon, href, id, variant = 'standard' } = Astro.props;
---

<article class:list={['card', `card--${variant}`, { 'card--interactive': href }]} {id}>
  <div class="icon-box"><Icon name={icon} /></div>
  <h3>{title}</h3>
  <p>{text}</p>
  {href && <a class="text-link" href={href}>Découvrir <span>→</span></a>}
</article>
