---
interface Props { mode?: 'popup' | 'inline'; label?: string; variant?: 'primary' | 'secondary' | 'ghost'; class?: string; }
const { mode = 'popup', label = 'Réserver un rendez-vous', variant = 'primary', class: className = '' } = Astro.props;
const calendlyUrl = import.meta.env.PUBLIC_CALENDLY_URL ?? '';
---
{calendlyUrl && (
  <div class={`calendly-wrap calendly-wrap--${mode} ${className}`} data-calendly-mode={mode}>
    {mode === 'popup' ? <button type="button" class={`button button--${variant}`} data-calendly-popup>{label}</button> : <div class="calendly-inline-container" data-calendly-inline aria-label="Calendrier de réservation"><button type="button" class={`button button--${variant}`} data-calendly-inline-trigger>{label}</button></div>}
  </div>
)}
<script>
  import { initCalendlyInline, openCalendlyPopup } from '../../scripts/calendly';
  document.querySelectorAll<HTMLButtonElement>('[data-calendly-popup]:not([data-calendly-bound])').forEach((button) => { button.dataset.calendlyBound = 'true'; button.addEventListener('click', () => void openCalendlyPopup()); });
  document.querySelectorAll<HTMLButtonElement>('[data-calendly-inline-trigger]:not([data-calendly-bound])').forEach((button) => { button.dataset.calendlyBound = 'true'; button.addEventListener('click', () => { const container = button.closest<HTMLElement>('[data-calendly-inline]'); if (container) void initCalendlyInline(container); }); });
</script>
<style>.calendly-wrap{display:inline-flex}.calendly-wrap--inline{display:block;width:100%}.calendly-inline-container{width:100%;min-width:0}</style>
