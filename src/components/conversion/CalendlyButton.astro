---
// CalendlyButton.astro
interface Props {
  mode?: 'popup' | 'inline';
  label?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  class?: string;
}

const {
  mode = 'popup',
  label = 'Réserver un rendez-vous',
  variant = 'primary',
  class: className = '',
} = Astro.props;

const calendlyUrl = import.meta.env.PUBLIC_CALENDLY_URL ?? '';
const isDisabled = !calendlyUrl;
---

{!isDisabled && (
  <div class={`calendly-wrap calendly-wrap--${mode} ${className}`} data-calendly-mode={mode}>
    {mode === 'popup' && (
      <button
        type="button"
        class={`button button--${variant}`}
        data-calendly-popup
        aria-label={label}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="4" width="18" height="18" rx="2"/>
          <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
          <line x1="3" y1="10" x2="21" y2="10"/>
        </svg>
        {label}
      </button>
    )}
    {mode === 'inline' && (
      <div class="calendly-inline-container" data-calendly-inline aria-label="Calendrier de réservation">
        <div class="calendly-inline-placeholder">
          <button type="button" class="button button--primary" data-calendly-inline-trigger>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            {label}
          </button>
        </div>
      </div>
    )}
  </div>
)}

<script>
  import { trackCalendly } from '../../scripts/analytics';

  const CALENDLY_URL = import.meta.env.PUBLIC_CALENDLY_URL ?? '';

  function loadCalendlyScript(): Promise<void> {
    return new Promise((resolve) => {
      if (document.getElementById('calendly-script')) { resolve(); return; }
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = 'https://assets.calendly.com/assets/external/widget.css';
      document.head.appendChild(link);
      const script = document.createElement('script');
      script.id = 'calendly-script';
      script.src = 'https://assets.calendly.com/assets/external/widget.js';
      script.async = true;
      script.onload = () => resolve();
      document.head.appendChild(script);
    });
  }

  // Popup buttons
  document.querySelectorAll('[data-calendly-popup]').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!CALENDLY_URL) return;
      trackCalendly('open');
      await loadCalendlyScript();
      // @ts-ignore
      if (window.Calendly) window.Calendly.initPopupWidget({ url: CALENDLY_URL });
    });
  });

  // Inline trigger buttons
  document.querySelectorAll('[data-calendly-inline-trigger]').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!CALENDLY_URL) return;
      trackCalendly('open');
      const container = btn.closest('[data-calendly-inline]');
      if (!container) return;
      await loadCalendlyScript();
      // Replace placeholder with inline widget
      container.innerHTML = '';
      container.style.minHeight = '700px';
      // @ts-ignore
      if (window.Calendly) {
        // @ts-ignore
        window.Calendly.initInlineWidget({ url: CALENDLY_URL, parentElement: container, prefill: {}, utm: {} });
      }
    });
  });

  // Track Calendly postMessage events
  window.addEventListener('message', (e) => {
    if (e.origin !== 'https://calendly.com') return;
    try {
      const data = typeof e.data === 'string' ? JSON.parse(e.data) : e.data;
      if (data?.event === 'calendly.event_scheduled') {
        trackCalendly('scheduled');
        // Mark as converted so popups don't reappear
        try { sessionStorage.setItem('clicom_converted', '1'); } catch {}
      }
    } catch {}
  });
</script>

<style>
  .calendly-wrap { display: inline-flex; }
  .calendly-wrap--inline { display: block; }
  .calendly-inline-container { width: 100%; }
  .calendly-inline-placeholder { display: flex; justify-content: flex-start; }
</style>
