---
// ConversionHub.astro — Centralise tous les widgets de conversion
import CookieBanner from './CookieBanner.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import ChatbotWidget from './ChatbotWidget.astro';
import ExitPopup from './ExitPopup.astro';
import ScrollPopup from './ScrollPopup.astro';

const gtmId = import.meta.env.PUBLIC_GTM_ID ?? '';
---

<CookieBanner />
<WhatsAppButton />
<ChatbotWidget />
<ExitPopup />
<ScrollPopup />

<script>
  import { initAnalytics } from '../../scripts/analytics';

  // Reopen consent event for footer link
  document.addEventListener("clicom:reopen-consent", () => {
      window.dispatchEvent(new Event("clicom:open-consent"));
  });

  initAnalytics(document.documentElement.dataset.gtmId ?? '');
  
</script>
<script is:inline define:vars={{ gtmId }}>document.documentElement.dataset.gtmId = gtmId;</script>
