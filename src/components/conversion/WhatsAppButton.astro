---
// WhatsAppButton.astro
const waNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? '';
const pathname = Astro.url.pathname;

const pageMessages: Record<string, string> = {
  '/creation-site-web/': 'Bonjour, je suis intéressé par la création d\'un site web avec CLICOM.',
  '/seo/': 'Bonjour, j\'aimerais en savoir plus sur vos services SEO.',
  '/referencement-ia/': 'Bonjour, je voudrais discuter du référencement IA avec CLICOM.',
  '/google-ads/': 'Bonjour, je souhaite en savoir plus sur Google Ads avec CLICOM.',
  '/intelligence-artificielle/': 'Bonjour, je m\'intéresse à vos solutions d\'intelligence artificielle.',
  '/automatisation/': 'Bonjour, je voudrais discuter d\'automatisation avec CLICOM.',
  '/social-ads/': 'Bonjour, je souhaite en savoir plus sur la publicité réseaux sociaux.',
  '/audit-gratuit/': 'Bonjour, je souhaite demander un audit gratuit de mon site.',
  '/contact/': 'Bonjour, j\'aimerais prendre contact avec CLICOM.',
};

const defaultMessage = 'Bonjour, j\'aimerais en savoir plus sur vos services numériques.';
const message = pageMessages[pathname] ?? defaultMessage;
const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`;
---

<a
  id="whatsapp-btn"
  href={waUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="wa-btn"
  aria-label="Contacter CLICOM sur WhatsApp"
  data-wa-btn
>
  <svg class="wa-btn__icon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
  <span class="wa-btn__label">WhatsApp</span>
</a>

<script>
  import { trackWhatsApp } from '../../scripts/analytics';

  document.querySelector('[data-wa-btn]')?.addEventListener('click', () => {
    trackWhatsApp(window.location.pathname);
  });
</script>

<style>
  .wa-btn {
    position: fixed;
    bottom: calc(88px + env(safe-area-inset-bottom));
    right: 24px;
    z-index: var(--z-whatsapp);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    border-radius: 999px;
    background: #25D366;
    color: white;
    box-shadow: 0 4px 20px rgba(37,211,102,.35);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    text-decoration: none;
  }
  .wa-btn:hover {
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 8px 28px rgba(37,211,102,.45);
  }
  .wa-btn__icon { flex-shrink: 0; }
  .wa-btn__label {
    font-size: .84rem;
    font-weight: 720;
    white-space: nowrap;
    max-width: 80px;
    overflow: hidden;
  }

  @media (max-width: 680px) {
    .wa-btn {
      bottom: calc(20px + env(safe-area-inset-bottom));
      right: 16px;
      padding: 11px 14px;
    }
    .wa-btn__label { display: none; }
  }
</style>
