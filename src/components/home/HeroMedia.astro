---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

const root = process.cwd();
const webmPath = resolve(root, 'public/videos/hero.webm');
const mp4Path = resolve(root, 'public/videos/hero.mp4');
const posterPath = resolve(root, 'public/images/hero-poster.webp');

const hasWebm = existsSync(webmPath);
const hasMp4 = existsSync(mp4Path);
const hasPoster = existsSync(posterPath);
const hasVideo = hasWebm || hasMp4;
const poster = hasPoster ? '/images/hero-poster.webp' : undefined;
---

<div class="hero-media" data-hero-media>
  <div class="hero-media__ambient hero-media__ambient--a"></div>
  <div class="hero-media__ambient hero-media__ambient--b"></div>
  <div class="hero-media__ambient hero-media__ambient--c"></div>

  {hasVideo ? (
    <video
      class="hero-media__video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
      poster={poster}
    >
      {hasWebm && <source src="/videos/hero.webm" type="video/webm" />}
      {hasMp4 && <source src="/videos/hero.mp4" type="video/mp4" />}
    </video>
  ) : (
    <svg class="hero-media__art" viewBox="0 0 1440 1080" role="presentation" aria-hidden="true">
      <defs>
        <linearGradient id="hero-media-line" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#081126" stop-opacity="0" />
          <stop offset="42%" stop-color="#2457FF" stop-opacity="0.82" />
          <stop offset="100%" stop-color="#22D3EE" stop-opacity="0.9" />
        </linearGradient>
        <linearGradient id="hero-media-fade" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#2457FF" stop-opacity="0.22" />
          <stop offset="100%" stop-color="#22D3EE" stop-opacity="0.02" />
        </linearGradient>
        <radialGradient id="hero-media-core" cx="50%" cy="46%" r="68%">
          <stop offset="0%" stop-color="#2457FF" stop-opacity="1" />
          <stop offset="60%" stop-color="#2457FF" stop-opacity="0.96" />
          <stop offset="100%" stop-color="#081126" stop-opacity="1" />
        </radialGradient>
        <filter id="hero-media-blur" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="18" />
        </filter>
      </defs>

      <rect width="1440" height="1080" fill="#081126" />
      <path class="hero-media__grid" d="M0 126H1440M0 252H1440M0 378H1440M0 504H1440M0 630H1440M0 756H1440M0 882H1440M126 0V1080M252 0V1080M378 0V1080M504 0V1080M630 0V1080M756 0V1080M882 0V1080M1008 0V1080M1134 0V1080M1260 0V1080M1386 0V1080" />

      <path class="hero-media__stroke hero-media__stroke--glow" d="M110 900C192 804 264 748 342 684C438 604 510 574 604 500C716 412 758 316 850 252C966 170 1084 128 1344 58" />
      <path class="hero-media__stroke hero-media__stroke--main" d="M110 900C192 804 264 748 342 684C438 604 510 574 604 500C716 412 758 316 850 252C966 170 1084 128 1344 58" />
      <path class="hero-media__stroke hero-media__stroke--secondary" d="M176 856C246 778 316 724 388 664C474 592 536 566 616 508C700 448 760 370 836 314C928 248 1030 186 1310 92" />

      <circle class="hero-media__halo" cx="642" cy="500" r="210" filter="url(#hero-media-blur)" />
      <circle class="hero-media__core-ring" cx="642" cy="500" r="166" />
      <circle class="hero-media__core-ring hero-media__core-ring--inner" cx="642" cy="500" r="108" />
      <circle class="hero-media__core-disc" cx="642" cy="500" r="122" />

      <path class="hero-media__plane hero-media__plane--left" d="M76 250L434 162L374 420L42 492Z" />
      <path class="hero-media__plane hero-media__plane--right" d="M1028 112L1386 78L1360 442L1084 408Z" />
      <path class="hero-media__plane hero-media__plane--bottom" d="M900 758L1410 686L1304 998L806 1048Z" />

      <g class="hero-media__ticks">
        <path d="M194 790h122" />
        <path d="M240 790l28-26" />
        <path d="M1074 202h126" />
        <path d="M1110 202l24 24" />
        <path d="M888 854h136" />
        <path d="M928 854l30-30" />
      </g>

      <g class="hero-media__bars">
        <rect x="320" y="740" width="16" height="160" rx="8" />
        <rect x="350" y="704" width="16" height="196" rx="8" />
        <rect x="380" y="660" width="16" height="240" rx="8" />
        <rect x="410" y="620" width="16" height="280" rx="8" />
      </g>

      <g class="hero-media__bars hero-media__bars--right">
        <rect x="1106" y="286" width="16" height="180" rx="8" />
        <rect x="1136" y="256" width="16" height="210" rx="8" />
        <rect x="1166" y="224" width="16" height="242" rx="8" />
      </g>
    </svg>
  )}

  <div class="hero-media__overlay">
    <div class="hero-media__vignette"></div>
    <div class="hero-media__reveal"></div>
    <div class="hero-media__grain"></div>
  </div>
</div>

<script>
  const media = document.querySelector<HTMLElement>('[data-hero-media]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (media && !reduceMotion) {
    let raf = 0;

    const update = (x: number, y: number) => {
      const rect = media.getBoundingClientRect();
      const px = ((x - rect.left) / rect.width - 0.5) * 2;
      const py = ((y - rect.top) / rect.height - 0.5) * 2;
      media.style.setProperty('--mx', px.toFixed(3));
      media.style.setProperty('--my', py.toFixed(3));
    };

    media.addEventListener('pointermove', (event) => {
      cancelAnimationFrame(raf);
      raf = window.requestAnimationFrame(() => update(event.clientX, event.clientY));
    });

    media.addEventListener('pointerleave', () => {
      media.style.setProperty('--mx', '0');
      media.style.setProperty('--my', '0');
    });
  }
</script>

<style>
  .hero-media {
    --mx: 0;
    --my: 0;
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-bottom-left-radius: 40px;
    border-bottom-right-radius: 40px;
    background: radial-gradient(circle at 50% 40%, rgba(36, 87, 255, 0.16), transparent 32%), var(--color-midnight);
  }

  .hero-media__ambient {
    position: absolute;
    border-radius: 50%;
    filter: blur(14px);
    pointer-events: none;
    transition: transform 180ms linear;
  }

  .hero-media__ambient--a {
    top: 8%;
    left: 10%;
    width: 24vw;
    height: 24vw;
    min-width: 220px;
    min-height: 220px;
    background: rgba(36, 87, 255, 0.18);
    transform:
      translate3d(calc(var(--mx) * 12px), calc(var(--my) * 10px), 0)
      scale(calc(1 + var(--hero-scroll) * -0.015));
  }

  .hero-media__ambient--b {
    top: 18%;
    right: 8%;
    width: 18vw;
    height: 18vw;
    min-width: 180px;
    min-height: 180px;
    background: rgba(34, 211, 238, 0.12);
    transform:
      translate3d(calc(var(--mx) * -10px), calc(var(--my) * 8px), 0)
      scale(calc(1 + var(--hero-scroll) * -0.012));
  }

  .hero-media__ambient--c {
    right: 12%;
    bottom: -4%;
    width: 26vw;
    height: 26vw;
    min-width: 240px;
    min-height: 240px;
    background: rgba(255, 255, 255, 0.04);
    transform:
      translate3d(calc(var(--mx) * 8px), calc(var(--my) * -8px), 0)
      scale(calc(1 + var(--hero-scroll) * -0.01));
  }

  .hero-media__video,
  .hero-media__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform:
      translate3d(calc(var(--mx) * 6px), calc(var(--my) * 6px), 0)
      scale(calc(1.02 - var(--hero-scroll) * 0.035))
      rotate(calc(var(--mx) * 0.35deg));
    transform-origin: center;
    will-change: transform;
  }

  .hero-media__art {
    overflow: visible;
  }

  .hero-media__grid {
    fill: none;
    stroke: rgba(255, 255, 255, 0.055);
    stroke-width: 1;
  }

  .hero-media__stroke {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-media__stroke--glow {
    stroke: url(#hero-media-fade);
    stroke-width: 82;
    opacity: 0.32;
    filter: blur(18px);
  }

  .hero-media__stroke--main {
    stroke: url(#hero-media-line);
    stroke-width: 12;
    stroke-dasharray: 12 16;
    animation: hero-media-flow 18s linear infinite;
  }

  .hero-media__stroke--secondary {
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 1.2;
    stroke-dasharray: 4 12;
    animation: hero-media-flow 24s linear infinite reverse;
  }

  .hero-media__halo {
    fill: rgba(36, 87, 255, 0.16);
  }

  .hero-media__core-ring {
    fill: none;
    stroke: rgba(255, 255, 255, 0.4);
    stroke-width: 1.2;
    stroke-dasharray: 10 14;
    animation: hero-media-spin 14s linear infinite;
  }

  .hero-media__core-ring--inner {
    opacity: 0.58;
    animation-duration: 11s;
    animation-direction: reverse;
  }

  .hero-media__core-disc {
    fill: url(#hero-media-core);
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 1;
  }

  .hero-media__plane {
    fill: url(#hero-media-fade);
    opacity: 0.38;
    transform-origin: center;
    animation: hero-media-drift 12s ease-in-out infinite;
  }

  .hero-media__plane--right { animation-delay: -2.8s; }
  .hero-media__plane--bottom { animation-delay: -5s; }

  .hero-media__ticks path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.24);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-dasharray: 3 10;
    animation: hero-media-flow 18s linear infinite;
  }

  .hero-media__bars rect {
    fill: url(#hero-bar);
    opacity: 0.68;
    transform-origin: bottom;
    animation: hero-media-breathe 7.8s ease-in-out infinite;
  }

  .hero-media__bars rect:nth-child(2) { animation-delay: -0.8s; }
  .hero-media__bars rect:nth-child(3) { animation-delay: -1.6s; }
  .hero-media__bars rect:nth-child(4) { animation-delay: -2.4s; }
  .hero-media__bars--right rect:nth-child(1) { animation-delay: -1.1s; }
  .hero-media__bars--right rect:nth-child(2) { animation-delay: -1.9s; }
  .hero-media__bars--right rect:nth-child(3) { animation-delay: -2.6s; }

  .hero-media__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-media__vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 36%, transparent 0 26%, rgba(8, 17, 38, 0.12) 64%, rgba(8, 17, 38, 0.56) 100%),
      linear-gradient(180deg, rgba(8, 17, 38, 0.08), rgba(8, 17, 38, 0.62));
  }

  .hero-media__reveal {
    position: absolute;
    inset: auto 0 0;
    height: 24%;
    background: linear-gradient(180deg, rgba(8, 17, 38, 0), var(--color-background));
  }

  .hero-media__grain {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(180deg, black, transparent 96%);
    mix-blend-mode: screen;
  }

  @keyframes hero-media-flow {
    to { stroke-dashoffset: -100; }
  }

  @keyframes hero-media-spin {
    to { stroke-dashoffset: 104; }
  }

  @keyframes hero-media-drift {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-8px) scale(1.01); }
  }

  @keyframes hero-media-breathe {
    0%, 100% { opacity: 0.54; transform: scaleY(0.82); }
    50% { opacity: 1; transform: scaleY(1); }
  }

  @media (max-width: 680px) {
    .hero-media__ambient--c {
      display: none;
    }

    .hero-media__reveal {
      height: 28%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media__stroke--main,
    .hero-media__stroke--secondary,
    .hero-media__core-ring,
    .hero-media__plane,
    .hero-media__bars rect,
    .hero-media__ticks path {
      animation: none;
    }
  }
</style>
