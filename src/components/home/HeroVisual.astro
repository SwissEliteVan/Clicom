---
---

<figure class="hero-visual" aria-hidden="true">
  <div class="hero-visual__shell">
    <div class="hero-visual__ambient hero-visual__ambient--a"></div>
    <div class="hero-visual__ambient hero-visual__ambient--b"></div>

    <div class="hero-visual__frame">
      <div class="hero-visual__bar">
        <span><i></i>Swiss digital canvas</span>
        <small>Growth / Data / Technology</small>
      </div>

      <div class="hero-visual__stage">
        <svg class="hero-visual__svg" viewBox="0 0 920 760" role="presentation" aria-hidden="true">
          <defs>
            <linearGradient id="hero-canvas-gradient" x1="0%" y1="100%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#081126" stop-opacity="0" />
              <stop offset="34%" stop-color="#2457FF" stop-opacity="0.22" />
              <stop offset="68%" stop-color="#22D3EE" stop-opacity="0.22" />
              <stop offset="100%" stop-color="#22D3EE" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="hero-canvas-stroke" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="#2457FF" />
              <stop offset="100%" stop-color="#22D3EE" />
            </linearGradient>
            <linearGradient id="hero-canvas-panel" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.92" />
              <stop offset="100%" stop-color="#EDF2FF" stop-opacity="0.82" />
            </linearGradient>
            <radialGradient id="hero-canvas-core" cx="50%" cy="48%" r="68%">
              <stop offset="0%" stop-color="#2457FF" stop-opacity="1" />
              <stop offset="58%" stop-color="#2457FF" stop-opacity="0.95" />
              <stop offset="100%" stop-color="#081126" stop-opacity="1" />
            </radialGradient>
            <filter id="hero-canvas-blur" x="-20%" y="-20%" width="140%" height="140%">
              <feGaussianBlur stdDeviation="14" />
            </filter>
          </defs>

          <g class="hero-visual__grid">
            <path d="M96 86H824" />
            <path d="M96 184H824" />
            <path d="M96 282H824" />
            <path d="M96 380H824" />
            <path d="M96 478H824" />
            <path d="M96 576H824" />
            <path d="M96 674H824" />
            <path d="M114 68V700" />
            <path d="M246 68V700" />
            <path d="M378 68V700" />
            <path d="M510 68V700" />
            <path d="M642 68V700" />
            <path d="M774 68V700" />
          </g>

          <path class="hero-visual__ribbon hero-visual__ribbon--glow" d="M120 620C182 560 220 514 270 476C326 434 390 428 452 390C514 351 543 296 604 256C676 210 740 180 826 98" />
          <path class="hero-visual__ribbon hero-visual__ribbon--stroke" d="M120 620C182 560 220 514 270 476C326 434 390 428 452 390C514 351 543 296 604 256C676 210 740 180 826 98" />

          <path class="hero-visual__contour hero-visual__contour--a" d="M172 628C246 564 282 518 332 476C392 426 452 424 520 376C588 328 622 284 694 238C734 214 784 172 844 96" />
          <path class="hero-visual__contour hero-visual__contour--b" d="M156 598C232 534 264 490 316 448C380 396 438 382 504 336C570 290 612 248 672 214C720 188 770 142 820 78" />

          <circle class="hero-visual__pulse" cx="452" cy="390" r="92" filter="url(#hero-canvas-blur)" />
          <circle class="hero-visual__core-ring" cx="452" cy="390" r="94" />
          <circle class="hero-visual__core-ring hero-visual__core-ring--inner" cx="452" cy="390" r="58" />
          <circle class="hero-visual__core-disc" cx="452" cy="390" r="72" />
          <text class="hero-visual__core-title" x="452" y="382" text-anchor="middle">CLICOM</text>
          <text class="hero-visual__core-subtitle" x="452" y="408" text-anchor="middle">growth engine</text>

          <g class="hero-visual__nodes">
            <circle cx="120" cy="620" r="5" />
            <circle cx="270" cy="476" r="5" />
            <circle cx="452" cy="390" r="6" />
            <circle cx="604" cy="256" r="5" />
            <circle cx="826" cy="98" r="5" />
          </g>

          <g class="hero-visual__micro">
            <path d="M166 560h86" />
            <path d="M218 560l22-26" />
            <path d="M706 172h86" />
            <path d="M744 172l26 26" />
            <path d="M606 594h84" />
            <path d="M640 594l22-22" />
          </g>

          <g class="hero-visual__plate hero-visual__plate--seo">
            <rect x="148" y="126" width="152" height="78" rx="22" fill="url(#hero-canvas-panel)" />
            <rect x="166" y="148" width="92" height="8" rx="4" fill="#081126" fill-opacity=".9" />
            <rect x="166" y="164" width="66" height="7" rx="3.5" fill="#2457FF" fill-opacity=".26" />
            <text x="166" y="146">SEO / content</text>
          </g>

          <g class="hero-visual__plate hero-visual__plate--ads">
            <rect x="632" y="132" width="152" height="78" rx="22" fill="url(#hero-canvas-panel)" />
            <rect x="650" y="154" width="84" height="8" rx="4" fill="#081126" fill-opacity=".9" />
            <rect x="650" y="170" width="92" height="7" rx="3.5" fill="#22D3EE" fill-opacity=".28" />
            <text x="650" y="152">ADS / reach</text>
          </g>

          <g class="hero-visual__plate hero-visual__plate--ia">
            <rect x="632" y="538" width="152" height="78" rx="22" fill="url(#hero-canvas-panel)" />
            <rect x="650" y="560" width="72" height="8" rx="4" fill="#081126" fill-opacity=".9" />
            <rect x="650" y="576" width="106" height="7" rx="3.5" fill="#2457FF" fill-opacity=".24" />
            <text x="650" y="558">IA / workflow</text>
          </g>

          <g class="hero-visual__data-rail">
            <rect x="116" y="696" width="688" height="16" rx="8" />
            <rect x="116" y="696" width="140" height="16" rx="8" />
            <rect x="310" y="696" width="112" height="16" rx="8" />
            <rect x="466" y="696" width="86" height="16" rx="8" />
            <rect x="586" y="696" width="98" height="16" rx="8" />
          </g>
        </svg>

        <div class="hero-visual__overlay">
          <div class="hero-visual__card hero-visual__card--left">
            <span>Leads</span>
            <strong>Connected pipeline</strong>
            <i></i>
          </div>

          <div class="hero-visual__card hero-visual__card--right">
            <span>Conversion</span>
            <strong>Optimized flow</strong>
            <i></i>
          </div>

          <div class="hero-visual__card hero-visual__card--bottom">
            <span>Visibility</span>
            <strong>SEO · ADS · IA</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</figure>

<style>
  .hero-visual {
    position: relative;
    min-width: 0;
    margin: 0;
  }

  .hero-visual__shell {
    position: relative;
    margin-left: -1.8%;
  }

  .hero-visual__ambient {
    position: absolute;
    border-radius: 50%;
    filter: blur(10px);
    pointer-events: none;
  }

  .hero-visual__ambient--a {
    top: 6%;
    right: 3%;
    width: 240px;
    height: 240px;
    background: rgba(36, 87, 255, 0.18);
  }

  .hero-visual__ambient--b {
    left: 7%;
    bottom: 4%;
    width: 320px;
    height: 320px;
    background: rgba(34, 211, 238, 0.12);
  }

  .hero-visual__frame {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border: 1px solid rgba(36, 87, 255, 0.14);
    border-radius: 36px;
    background:
      radial-gradient(circle at 50% 44%, rgba(36, 87, 255, 0.12), transparent 28%),
      radial-gradient(circle at 80% 16%, rgba(34, 211, 238, 0.12), transparent 22%),
      linear-gradient(180deg, rgba(8, 17, 38, 0.98), rgba(8, 17, 38, 0.92));
    box-shadow: 0 42px 120px rgba(8, 17, 38, 0.18);
    backdrop-filter: blur(14px);
  }

  .hero-visual__frame::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 66px 66px;
    mask-image: linear-gradient(180deg, black, transparent 92%);
    content: '';
    pointer-events: none;
  }

  .hero-visual__bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 62px;
    padding: 0 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: rgba(247, 249, 252, 0.7);
    font-size: 0.7rem;
    font-weight: 760;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-visual__bar span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: white;
  }

  .hero-visual__bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 0 5px rgba(34, 211, 238, 0.1);
  }

  .hero-visual__stage {
    position: relative;
    z-index: 1;
    min-height: 680px;
    padding: 8px 16px 16px;
  }

  .hero-visual__svg {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 656px;
    overflow: visible;
  }

  .hero-visual__grid path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.055);
    stroke-width: 1;
  }

  .hero-visual__ribbon {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-visual__ribbon--glow {
    stroke: url(#hero-canvas-gradient);
    stroke-width: 68;
    opacity: 0.42;
    filter: blur(12px);
  }

  .hero-visual__ribbon--stroke {
    stroke: url(#hero-canvas-stroke);
    stroke-width: 11;
    stroke-dasharray: 8 12;
    animation: hero-ribbon 18s linear infinite;
  }

  .hero-visual__contour {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 3 11;
  }

  .hero-visual__contour--a {
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 1.2;
    animation: hero-ribbon 24s linear infinite reverse;
  }

  .hero-visual__contour--b {
    stroke: rgba(34, 211, 238, 0.18);
    stroke-width: 1.1;
    animation: hero-ribbon 20s linear infinite;
  }

  .hero-visual__pulse {
    fill: rgba(36, 87, 255, 0.14);
  }

  .hero-visual__core-ring {
    fill: none;
    stroke: rgba(255, 255, 255, 0.42);
    stroke-width: 1.3;
    stroke-dasharray: 9 12;
    animation: hero-ring 16s linear infinite;
  }

  .hero-visual__core-ring--inner {
    opacity: 0.58;
    animation-duration: 11s;
    animation-direction: reverse;
  }

  .hero-visual__core-disc {
    fill: url(#hero-canvas-core);
    stroke: rgba(255, 255, 255, 0.12);
    stroke-width: 1;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .hero-visual__core-title,
  .hero-visual__core-subtitle {
    fill: white;
    font-family: 'Manrope Variable', Arial, sans-serif;
    text-rendering: geometricPrecision;
  }

  .hero-visual__core-title {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .hero-visual__core-subtitle {
    fill: rgba(247, 249, 252, 0.76);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .hero-visual__nodes circle {
    fill: var(--color-cyan);
    stroke: white;
    stroke-width: 3.5;
    filter: drop-shadow(0 0 11px rgba(34, 211, 238, 0.38));
    animation: hero-node 5.6s ease-in-out infinite;
  }

  .hero-visual__nodes circle:nth-child(2) { animation-delay: -0.9s; }
  .hero-visual__nodes circle:nth-child(3) { animation-delay: -1.8s; }
  .hero-visual__nodes circle:nth-child(4) { animation-delay: -2.6s; }
  .hero-visual__nodes circle:nth-child(5) { animation-delay: -3.5s; }

  .hero-visual__micro path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.3);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-dasharray: 2 8;
    animation: hero-ribbon 14s linear infinite;
  }

  .hero-visual__plate text {
    fill: #081126;
    font-family: 'Manrope Variable', Arial, sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-visual__data-rail rect {
    fill: rgba(255, 255, 255, 0.06);
  }

  .hero-visual__data-rail rect:nth-child(2),
  .hero-visual__data-rail rect:nth-child(3),
  .hero-visual__data-rail rect:nth-child(4),
  .hero-visual__data-rail rect:nth-child(5) {
    opacity: 0.86;
  }

  .hero-visual__data-rail rect:nth-child(2) { fill: rgba(36, 87, 255, 0.58); }
  .hero-visual__data-rail rect:nth-child(3) { fill: rgba(34, 211, 238, 0.5); }
  .hero-visual__data-rail rect:nth-child(4) { fill: rgba(36, 87, 255, 0.38); }
  .hero-visual__data-rail rect:nth-child(5) { fill: rgba(34, 211, 238, 0.36); }

  .hero-visual__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-visual__card {
    position: absolute;
    display: grid;
    gap: 8px;
    min-width: 168px;
    padding: 18px 18px 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 18px 36px rgba(8, 17, 38, 0.22);
    backdrop-filter: blur(14px);
    color: white;
  }

  .hero-visual__card span {
    color: rgba(247, 249, 252, 0.68);
    font-size: 0.62rem;
    font-weight: 760;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero-visual__card strong {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .hero-visual__card i {
    height: 2px;
    border-radius: 999px;
    background: var(--gradient-brand);
  }

  .hero-visual__card--left {
    top: 14%;
    left: 6%;
    transform: rotate(-3deg);
  }

  .hero-visual__card--right {
    top: 18%;
    right: 7%;
    transform: rotate(3deg);
  }

  .hero-visual__card--bottom {
    right: 12%;
    bottom: 10%;
    min-width: 210px;
    transform: rotate(-2deg);
  }

  @keyframes hero-ribbon {
    to { stroke-dashoffset: -72; }
  }

  @keyframes hero-ring {
    to { stroke-dashoffset: 84; }
  }

  @keyframes hero-node {
    0%, 100% { opacity: 0.82; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.14); }
  }

  @media (max-width: 1100px) {
    .hero-visual__shell {
      margin-left: 0;
    }

    .hero-visual__stage {
      min-height: 620px;
    }

    .hero-visual__svg {
      min-height: 596px;
    }
  }

  @media (max-width: 680px) {
    .hero-visual__frame {
      border-radius: 28px;
    }

    .hero-visual__bar {
      padding-inline: 16px;
    }

    .hero-visual__bar small {
      display: none;
    }

    .hero-visual__stage {
      min-height: 540px;
      padding: 8px 10px 10px;
    }

    .hero-visual__svg {
      min-height: 520px;
    }

    .hero-visual__card {
      min-width: 0;
      padding: 14px 14px 13px;
      border-radius: 18px;
    }

    .hero-visual__card--left {
      top: 12%;
      left: 4%;
    }

    .hero-visual__card--right {
      top: 12%;
      right: 4%;
    }

    .hero-visual__card--bottom {
      right: 6%;
      bottom: 9%;
      min-width: 170px;
    }

    .hero-visual__core-title {
      font-size: 15px;
    }

    .hero-visual__core-subtitle {
      font-size: 9px;
    }
  }

  @media (max-width: 390px) {
    .hero-visual__stage {
      min-height: 500px;
    }

    .hero-visual__svg {
      min-height: 482px;
    }

    .hero-visual__card {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-visual__ribbon--stroke,
    .hero-visual__contour,
    .hero-visual__core-ring,
    .hero-visual__nodes circle,
    .hero-visual__micro path,
    .hero-visual__card {
      animation: none;
    }
  }
</style>
