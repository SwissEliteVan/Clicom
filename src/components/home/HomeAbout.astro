---
import '../../styles/home/about.css';
const steps = [
  ['01','Comprendre','Diagnostiquer votre situation, vos priorités et vos objectifs pour définir un plan d’action pragmatique.'],
  ['02','Construire','Créer un socle solide : site performant, messages clairs, formulaires fiables et outils connectés.'],
  ['03','Activer','Lancer la visibilité (SEO, Google Ads, contenus) et automatiser le traitement des contacts.'],
  ['04','Améliorer','Mesurer les retours réels, optimiser les conversions et faire évoluer le système au rythme de votre croissance.'],
];
const stack = ['Astro','UX / UI','Front-end','SEO','Google Ads','Automatisation','CRM'];
---
<section id="apropos" class="about-section" aria-labelledby="about-title">
  <div class="container about-layout">
    <div class="section-heading" data-reveal>
      <div class="eyebrow">À propos</div>
      <h2 id="about-title">La précision suisse. Le rythme numérique.</h2>
      <p>Le numérique doit faire avancer l’entreprise. Nous concevons des systèmes clairs et cohérents : chaque décision renforce la visibilité, la confiance, la conversion ou l’efficacité opérationnelle.</p>
      <a class="text-link" href="/agence/">En savoir plus sur l’agence <span aria-hidden="true">→</span></a>
    </div>

    <div class="about-details">
      <div class="about-steps" data-reveal>
        {steps.map(([number, title, text]) => (
          <article>
            <span>{number}</span>
            <div><h3>{title}</h3><p>{text}</p></div>
          </article>
        ))}
      </div>
      <div class="about-foot" data-reveal>
        <div class="about-stack">
          <span>Stack &amp; expertises</span>
          <div class="about-stack__chips">{stack.map((item) => <b>{item}</b>)}</div>
        </div>
        <p class="about-availability"><i aria-hidden="true"></i> Disponible pour de nouveaux projets — premier échange de 30 minutes, sans engagement.</p>
      </div>
    </div>
  </div>
</section>
