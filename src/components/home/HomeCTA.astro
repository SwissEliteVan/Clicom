---
import Button from '../Button.astro';
---

<section class="home-cta" aria-labelledby="home-cta-title">
  <div class="container home-cta__panel" data-reveal data-reveal-type="scale">
    <div class="home-cta__halo home-cta__halo--one" aria-hidden="true"></div>
    <div class="home-cta__halo home-cta__halo--two" aria-hidden="true"></div>
    <div class="home-cta__grid" aria-hidden="true"></div>

    <div class="home-cta__copy">
      <span class="home-kicker">Prochaine étape</span>
      <h2 id="home-cta-title">Votre expertise mérite une présence digitale à sa hauteur.</h2>
      <p>Nous analysons votre visibilité, vos outils, vos contenus et votre suivi commercial pour définir les actions utiles : ce qui peut générer plus de demandes, faire gagner du temps et sécuriser votre activité.</p>
      <div class="home-cta__actions">
        <span data-magnetic><Button href="/audit-gratuit/">Demander mon diagnostic <span aria-hidden="true">↗</span></Button></span>
      </div>
    </div>

    <div class="home-cta__signal" aria-hidden="true">
      <span>CLICOM</span>
      <div><i></i><b></b><i></i></div>
      <small>PME DIGITAL SYSTEM READY</small>
    </div>

    <div class="home-cta__badges" aria-label="Informations pratiques">
      <span>Approche PME</span>
      <span>Sans promesse irréaliste</span>
      <span>Suisse romande</span>
    </div>
  </div>
</section>
