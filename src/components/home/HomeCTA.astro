---
import Button from '../Button.astro';
import CalendlyButton from '../conversion/CalendlyButton.astro';
import '../../styles/home/cta.css';
---
<section class="final-cta" aria-labelledby="final-cta-title">
  <div class="container">
    <div class="final-cta__panel" data-reveal>
      <div class="final-cta__grid" aria-hidden="true"></div>
      <div class="final-cta__copy">
        <div class="eyebrow eyebrow--cyan">Votre prochain pas numérique</div>
        <h2 id="final-cta-title">Un projet ou une priorité numérique ?</h2>
        <p>Parlons de votre activité et identifions les actions digitales qui peuvent réellement vous aider.</p>
        <div class="final-cta__actions">
          <CalendlyButton label="Réserver un échange gratuit de 30 minutes" fallbackHref="/contact/" />
          <Button href="/audit-gratuit/" variant="secondary">Demander un audit gratuit</Button>
        </div>
        <div class="final-cta__direct">
          <a href="mailto:hello@clicom.ch">hello@clicom.ch</a>
          <span aria-hidden="true">·</span>
          <a href="tel:+41788238950">078 823 89 50</a>
        </div>
      </div>
    </div>
  </div>
</section>
