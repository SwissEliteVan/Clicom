---
import '../../styles/home/expertise.css';
const pillars = [
  {number:'01',label:'Sites internet & conversion',title:'Construire un socle clair qui mène à l’action.',copy:'Architecture lisible, navigation fluide et contenus ciblés : des sites web conçus pour présenter votre offre et générer des prises de contact.',links:[['/creation-site-web/','Sites Internet'],['/branding/','Identité visuelle']]},
  {number:'02',label:'Référencement & visibilité',title:'Rendre votre entreprise trouvée localement.',copy:'Optimisation SEO et visibilité dans les réponses IA pour que vos futurs clients vous découvrent lorsqu’ils recherchent vos services en Suisse romande.',links:[['/seo/','Référencement naturel'],['/referencement-ia/','Visibilité IA']]},
  {number:'03',label:'Acquisition',title:'Cibler les besoins concrets sans gaspillage.',copy:'Campagnes Google Ads et réseaux sociaux calibrées pour capter des intentions réelles et rentabiliser votre investissement commercial.',links:[['/google-ads/','Publicité Google'],['/social-ads/','Publicité réseaux sociaux']]},
  {number:'04',label:'Automatisation & CRM',title:'Déclencher les bonnes actions sans surcharge.',copy:'Routage automatique des demandes, alertes d’équipe et synchronisation CRM : vos processus tournent sans friction, sous contrôle humain permanent.',links:[['/automatisation/','Automatisation'],['/email-marketing-crm/','Suivi commercial & CRM']]},
];
---
<section id="expertises" class="expertise-section" aria-labelledby="expertise-title">
  <div class="container">
    <div class="section-heading" data-reveal>
      <div class="eyebrow">Expertises</div>
      <h2 id="expertise-title">Les bonnes compétences, activées au bon moment.</h2>
      <p>Pas de catalogue rigide ni de prestations superflues : nous sélectionnons et combinons uniquement les expertises adaptées à votre niveau de maturité et à vos priorités réelles.</p>
    </div>

    <div class="expertise-list">
      {pillars.map((pillar) => (
        <article class="expertise-row" data-reveal>
          <span class="expertise-row__num" aria-hidden="true">{pillar.number}</span>
          <div class="expertise-row__main">
            <span class="expertise-row__label">{pillar.label}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.copy}</p>
          </div>
          <div class="expertise-row__links">
            {pillar.links.map(([href, label]) => <a href={href}>{label}<span aria-hidden="true">→</span></a>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
