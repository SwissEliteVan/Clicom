---
import Button from '../Button.astro';
import HeroVisual from './HeroVisual.astro';
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__grid" aria-hidden="true"></div>
  <div class="container home-hero__inner">
    <div class="home-hero__copy">
      <div class="eyebrow">Agence digitale suisse</div>
      <h1 id="home-title">
        Transformez votre digital<br />
        en moteur de <span class="gradient-text">croissance.</span>
      </h1>
      <p class="lead">
        Sites web, SEO, publicité et intelligence artificielle : Clicom construit les systèmes digitaux qui attirent, convertissent et accélèrent votre croissance.
      </p>
      <div class="button-row">
        <Button href="/contact#audit">Demander un audit gratuit <span aria-hidden="true">→</span></Button>
        <Button href="/services" variant="secondary">Découvrir nos services</Button>
      </div>
      <p class="hero-proof">
        <span aria-hidden="true">●</span>
        Web <i>·</i> SEO <i>·</i> Ads <i>·</i> IA <i>·</i> Automatisation
      </p>
    </div>

    <HeroVisual />
  </div>
</section>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    min-height: min(900px, calc(100vh - 82px));
    background:
      radial-gradient(circle at 78% 32%, rgba(36, 87, 255, 0.1), transparent 28%),
      linear-gradient(180deg, #fff, var(--color-background));
  }

  .home-hero__grid {
    position: absolute;
    inset: 0;
    opacity: 0.48;
    background-image:
      linear-gradient(rgba(8, 17, 38, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(8, 17, 38, 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
    pointer-events: none;
  }

  .home-hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    align-items: center;
    gap: clamp(44px, 6vw, 92px);
    padding-block: clamp(72px, 9vw, 118px);
  }

  .home-hero__copy {
    max-width: 680px;
  }

  .home-hero :global(.hero-visual) {
    justify-self: end;
    width: min(100%, 1120px);
  }

  h1 {
    font-size: clamp(3.35rem, 5vw, 5rem);
  }

  .lead {
    max-width: 650px;
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 34px 0 0;
    color: var(--color-text-muted);
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  .hero-proof > span {
    color: var(--color-primary);
    letter-spacing: -0.08em;
  }

  .hero-proof i {
    color: var(--color-border-strong);
    font-style: normal;
  }

  @media (max-width: 1100px) {
    .home-hero {
      min-height: auto;
    }

    .home-hero__inner {
      grid-template-columns: 1fr;
    }

    .home-hero__copy {
      max-width: 820px;
    }

    .home-hero :global(.hero-visual) {
      justify-self: stretch;
      width: 100%;
    }
  }

  @media (max-width: 680px) {
    .home-hero__inner {
      gap: 46px;
      padding-block: 62px 74px;
    }

    h1 {
      font-size: clamp(2.65rem, 12vw, 3.35rem);
    }

    h1 br {
      display: none;
    }

    .hero-proof {
      line-height: 1.7;
    }
  }
</style>
