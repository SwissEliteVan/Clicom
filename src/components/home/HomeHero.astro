---
import Button from '../Button.astro';
import PremiumMedia from './PremiumMedia.astro';
const nodes = [['SEO','VISIBILITÉ','search','15%','24%'],['ADS','ACQUISITION','ads','78%','18%'],['SITE','CONVERSION','web','28%','64%'],['CRM','SUIVI','crm','77%','68%'],['DATA / IA','PILOTAGE','monitor','72%','38%']] as const;
---
<section class="home-hero" data-hero aria-labelledby="home-title">
  <div class="home-hero__wash"></div><div class="home-hero__grid"></div><div class="home-hero__orb home-hero__orb--one"></div>
  <div class="container home-hero__inner">
    <div class="home-hero__meta"><span class="home-hero__badge"><i></i>Agence digitale · Suisse romande</span><span class="home-hero__availability">SWISS DIGITAL SYSTEM / 2026</span></div>
    <div class="home-hero__layout">
      <div><h1 id="home-title" class="home-hero__title"><span class="home-hero__title-line"><span>Le digital utile</span></span><span class="home-hero__title-line home-hero__title-line--accent"><span>aux PME.</span></span></h1><p class="home-hero__signature">Présence. Acquisition. Automatisation. Performance.</p><div class="home-hero__support"><p class="home-hero__lead">CLICOM relie site web, visibilité, campagnes, CRM et données pour créer un système digital clair, mesurable et réellement utile.</p><div class="home-hero__actions"><Button href="/audit-gratuit/">Demander un audit <span>↗</span></Button><Button href="#expertises" variant="secondary">Explorer les expertises</Button></div><div class="home-hero__proof"><span>Approche PME</span><span>Exécution suisse</span><span>Technologie maîtrisée</span></div></div></div>
      <div class="home-hero__visual" aria-label="Système digital CLICOM reliant SEO, publicité, site, CRM et données">
        <div class="home-hero__visual-head"><span><i></i>SYSTÈME ACTIF</span><span>CLICOM / PME</span></div>
        <div class="home-hero__network"><svg viewBox="0 0 600 520"><path d="M110 105C210 105 190 230 290 240M475 115C390 125 390 215 290 240M120 390C220 380 190 265 290 240M465 395C385 375 390 270 290 240M465 245H345"/></svg><div class="home-hero__core"><span>CLICOM</span><small>DIGITAL ENGINE</small></div>{nodes.map(([label,sub,type,x,y],index)=><div class="home-hero__node" style={`--node-x:${x};--node-y:${y}`}><i></i><span>{label}</span><small>{sub}</small><div class="home-hero__node-media" style={`--delay:${index * .8}s`}><PremiumMedia type={type} compact /></div></div>)}</div>
        <div class="home-hero__visual-foot"><span><i></i>DATA CONNECTED</span><span><i></i>SECURE</span></div>
      </div>
    </div>
  </div>
</section>
