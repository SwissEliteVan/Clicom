---
import Button from '../Button.astro';
import HeroMedia from './HeroMedia.astro';
---

<section class="home-hero" aria-labelledby="home-title">
  <HeroMedia />

  <div class="home-hero__shade" aria-hidden="true"></div>

  <div class="container home-hero__inner">
    <div class="home-hero__content">
      <div class="eyebrow home-hero__eyebrow">Agence digitale suisse</div>
      <h1 id="home-title">
        Transformez<br />
        votre digital<br />
        en croissance.
      </h1>
      <p class="lead home-hero__lead">
        Sites web, SEO, publicité et intelligence artificielle au service de votre croissance.
      </p>
      <div class="button-row home-hero__actions">
        <Button href="/contact#audit">Parler de mon projet <span aria-hidden="true">→</span></Button>
      </div>
    </div>

    <div class="home-hero__meta" aria-hidden="true">
      <span>Web</span>
      <span>SEO</span>
      <span>Ads</span>
      <span>IA</span>
    </div>
  </div>

  <div class="home-hero__transition" aria-hidden="true"></div>
</section>

<style>
  .home-hero {
    position: relative;
    overflow: hidden;
    min-height: max(760px, calc(100svh - 82px));
    color: white;
    background: var(--color-midnight);
  }

  .home-hero__shade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(8, 17, 38, 0.08), rgba(8, 17, 38, 0.62) 72%, rgba(8, 17, 38, 0.86)),
      radial-gradient(circle at 50% 24%, rgba(255, 255, 255, 0.05), transparent 36%);
    pointer-events: none;
  }

  .home-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    min-height: inherit;
    padding-block: clamp(92px, 12vw, 150px) clamp(34px, 5vw, 56px);
  }

  .home-hero__content {
    max-width: 980px;
    padding-right: clamp(0px, 6vw, 68px);
  }

  .home-hero__eyebrow {
    margin-bottom: 22px;
    color: rgba(247, 249, 252, 0.9);
  }

  .home-hero__eyebrow::before {
    background: var(--color-cyan);
    box-shadow: 0 0 0 5px rgba(34, 211, 238, 0.1);
  }

  h1 {
    max-width: 10ch;
    margin-bottom: 22px;
    color: white;
    font-size: clamp(4rem, 8vw, 8.75rem);
    line-height: 0.9;
    letter-spacing: -0.08em;
    text-transform: uppercase;
  }

  .home-hero__lead {
    max-width: 720px;
    color: rgba(247, 249, 252, 0.78);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
  }

  .home-hero__actions {
    margin-top: 30px;
  }

  .home-hero__actions :global(.button) {
    min-height: 54px;
    padding-inline: 22px;
    color: var(--color-midnight);
    background: white;
    border-color: rgba(255, 255, 255, 0.18);
  }

  .home-hero__actions :global(.button:hover) {
    background: rgba(247, 249, 252, 0.96);
  }

  .home-hero__meta {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-self: end;
    gap: 12px;
    padding-bottom: 20px;
    color: rgba(247, 249, 252, 0.72);
    font-size: 0.68rem;
    font-weight: 760;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home-hero__meta span {
    display: inline-flex;
    justify-content: flex-end;
  }

  .home-hero__transition {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    z-index: 2;
    height: 16vw;
    max-height: 180px;
    background: linear-gradient(180deg, rgba(8, 17, 38, 0), var(--color-background));
    pointer-events: none;
  }

  .home-hero :global(.hero-media) {
    z-index: 0;
  }

  @media (max-width: 1100px) {
    .home-hero {
      min-height: max(700px, calc(100svh - 82px));
    }

    .home-hero__inner {
      grid-template-columns: 1fr;
      align-items: end;
    }

    .home-hero__content {
      max-width: 840px;
      padding-right: 0;
    }

    .home-hero__meta {
      justify-self: start;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 16px;
      margin-top: 18px;
      padding-bottom: 0;
    }
  }

  @media (max-width: 680px) {
    .home-hero {
      min-height: max(660px, calc(100svh - 72px));
    }

    .home-hero__inner {
      padding-block: 72px 30px;
    }

    h1 {
      max-width: 9ch;
      font-size: clamp(3.25rem, 14vw, 4.35rem);
      line-height: 0.92;
    }

    .home-hero__lead {
      max-width: 30ch;
      font-size: 1rem;
    }

    .home-hero__meta {
      display: none;
    }

    .home-hero__transition {
      height: 22vw;
      max-height: 150px;
    }
  }
</style>
