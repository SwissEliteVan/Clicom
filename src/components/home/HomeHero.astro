---
import Button from '../Button.astro';
import ImmersiveMesh from '../visuals/ImmersiveMesh.astro';

const networkNodes = [
  { label: 'SITE', detail: 'Présence', x: '12%', y: '23%' },
  { label: 'SEO', detail: 'Visibilité locale', x: '17%', y: '72%' },
  { label: 'PME', detail: 'Objectif métier', x: '48%', y: '45%' },
  { label: 'CRM', detail: 'Prospects', x: '72%', y: '24%' },
  { label: 'IA', detail: 'Temps gagné', x: '77%', y: '73%' },
];

const maturity = ['Présence', 'Acquisition', 'Automatisation', 'Sécurité'];
---

<section class="home-hero" data-hero aria-labelledby="home-title">
  <div class="home-hero__media" data-hero-frame aria-hidden="true">
    <ImmersiveMesh />
  </div>
  <div class="home-hero__wash" aria-hidden="true"></div>
  <div class="home-hero__grid" aria-hidden="true"></div>
  <div class="home-hero__orb home-hero__orb--one" data-depth=".5" aria-hidden="true"></div>
  <div class="home-hero__orb home-hero__orb--two" data-depth=".9" aria-hidden="true"></div>

  <div class="container home-hero__inner">
    <div class="home-hero__meta" data-hero-detail>
      <span class="home-hero__badge"><i aria-hidden="true"></i>Partenaire digital · PME suisses</span>
      <span class="home-hero__availability">CLICOM / DIGITAL PME SYSTEMS</span>
    </div>

    <div class="home-hero__layout">
      <div class="home-hero__copy">
        <h1 id="home-title" class="home-hero__title">
          <span class="home-hero__title-line"><span>Le digital utile</span></span>
          <span class="home-hero__title-line home-hero__title-line--accent"><span>aux PME de Suisse romande.</span></span>
        </h1>

        <div class="home-hero__support">
          <p class="home-hero__lead" data-hero-copy>Nous créons des sites, des contenus, des campagnes et des outils numériques qui aident votre entreprise à gagner en visibilité, en efficacité et en croissance.</p>
          <p class="home-hero__signature" data-hero-copy>Votre expertise mérite une présence digitale à sa hauteur.</p>
          <div class="home-hero__actions" data-hero-cta>
            <span data-magnetic><Button href="/audit-gratuit/">Demander un diagnostic <span aria-hidden="true">↗</span></Button></span>
            <Button href="#systeme" variant="secondary">Voir l’approche PME</Button>
          </div>
          <div class="home-hero__proof" data-hero-detail>
            <span>Site & visibilité</span>
            <span>Automatisation responsable</span>
            <span>Sécurité & données</span>
          </div>
        </div>
      </div>

      <aside class="home-hero__visual" aria-label="Schéma du système digital CLICOM pour PME" data-depth=".35">
        <div class="home-hero__visual-head" data-hero-detail>
          <span><i aria-hidden="true"></i>PME DIGITAL MAP</span>
          <span>CLM / 2026</span>
        </div>

        <div class="home-hero__network" data-hero-network aria-hidden="true">
          <div class="home-hero__scan"></div>
          <svg viewBox="0 0 800 540" preserveAspectRatio="none">
            <path data-hero-connection pathLength="1" d="M110 125 C210 125 255 240 390 240" />
            <path data-hero-connection pathLength="1" d="M135 390 C245 390 265 255 390 240" />
            <path data-hero-connection pathLength="1" d="M390 240 C520 240 545 125 650 125" />
            <path data-hero-connection pathLength="1" d="M390 240 C525 240 555 395 660 395" />
            <path class="home-hero__connection--ghost" d="M650 125 C745 180 748 332 660 395" />
          </svg>

          {networkNodes.map((node, index) => (
            <div class:list={['home-hero__node', index === 2 && 'home-hero__node--core']} style={`--node-x:${node.x};--node-y:${node.y}`} data-hero-node>
              <i aria-hidden="true"></i>
              <span>{node.label}</span>
              <small>{node.detail}</small>
            </div>
          ))}

          <div class="home-hero__core" data-hero-node>
            <span>CLICOM</span>
            <small>PME ENGINE</small>
          </div>
        </div>

        <div class="home-hero__maturity" data-hero-detail aria-hidden="true">
          {maturity.map((item, index) => (
            <span style={`--i:${index}`}>{item}</span>
          ))}
        </div>

        <div class="home-hero__visual-foot" data-hero-detail>
          <span><i></i>Visibilité</span>
          <span><i></i>Prospects</span>
          <span><i></i>Protection</span>
        </div>
      </aside>
    </div>
  </div>

  <div class="home-hero__ticker" aria-hidden="true">
    <div class="home-hero__ticker-track">
      <div class="home-hero__ticker-group">
        <span>STRATÉGIE PME</span><i>✦</i><span>SITE</span><i>✦</i><span>SEO LOCAL</span><i>✦</i><span>PUBLICITÉ</span><i>✦</i><span>CRM</span><i>✦</i><span>IA RESPONSABLE</span><i>✦</i><span>SÉCURITÉ</span><i>✦</i>
      </div>
      <div class="home-hero__ticker-group" aria-hidden="true">
        <span>STRATÉGIE PME</span><i>✦</i><span>SITE</span><i>✦</i><span>SEO LOCAL</span><i>✦</i><span>PUBLICITÉ</span><i>✦</i><span>CRM</span><i>✦</i><span>IA RESPONSABLE</span><i>✦</i><span>SÉCURITÉ</span><i>✦</i>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/hero-motion';
</script>
