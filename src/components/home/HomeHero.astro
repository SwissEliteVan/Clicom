---
import Button from '../Button.astro';
import ImmersiveMesh from '../visuals/ImmersiveMesh.astro';
---

<section class="home-hero" data-hero aria-labelledby="home-title">
  <div class="home-hero__media-wrap" data-hero-frame><ImmersiveMesh /></div>
  <div class="home-hero__wash" aria-hidden="true"></div>

  <div class="container home-hero__inner">
    <div class="home-hero__topline" data-hero-detail>
      <span class="home-hero__badge"><i aria-hidden="true"></i>Agence numérique suisse · Suisse romande</span>
    </div>

    <div class="home-hero__content">
      <h1 id="home-title" class="home-hero__title">
        <span class="home-hero__title-line"><span>Votre site devient</span></span>
        <span class="home-hero__title-line home-hero__title-line--accent"><span>votre meilleur commercial.</span></span>
      </h1>
      <div class="home-hero__support">
        <p class="home-hero__copy" data-hero-copy>Clicom conçoit votre site web et pilote votre référencement, votre publicité et vos automatisations IA. Objectif&nbsp;: une présence en ligne qui vous amène des demandes qualifiées.</p>
        <div class="home-hero__actions" data-hero-cta data-magnetic>
          <Button href="/audit-gratuit/" aria-label="Demander un audit gratuit">Audit gratuit <span aria-hidden="true">↗</span></Button>
          <Button href="/services/" variant="secondary">Nos services</Button>
        </div>
        <p class="home-hero__reassure">Analyse de votre situation actuelle · Sans engagement</p>
      </div>
    </div>

    <div class="home-hero__footer" data-hero-detail>
      <span class="home-hero__scroll"><i></i>Défiler pour explorer</span>
      <span>Sites web · SEO · Publicité · IA</span>
    </div>
  </div>
</section>

<div class="hero-bridge" data-hero-bridge aria-hidden="true">
  <div class="hero-bridge__track">
    <div class="hero-bridge__sequence">
      <span>SITES WEB</span><i>✦</i><span>SEO</span><i>✦</i><span>PUBLICITÉ</span><i>✦</i><span>IA</span><i>✦</i>
    </div>
    <div class="hero-bridge__sequence" aria-hidden="true">
      <span>SITES WEB</span><i>✦</i><span>SEO</span><i>✦</i><span>PUBLICITÉ</span><i>✦</i><span>IA</span><i>✦</i>
    </div>
  </div>
</div>

<script>
  import '../../scripts/hero-motion';
</script>

<style>
  .home-hero { position: relative; min-height: 100svh; overflow: hidden; color: white; background: var(--color-midnight); isolation: isolate; }
  .home-hero__media-wrap { position: absolute; inset: 0; z-index: -2; overflow: hidden; clip-path: inset(0 0 0 0 round 0); transform-origin: center bottom; }
  .home-hero__wash { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(4,10,24,.62) 0%, rgba(4,10,24,.2) 46%, rgba(4,10,24,.04) 72%, transparent 100%), linear-gradient(180deg, rgba(5,12,28,.16), transparent 32%, rgba(5,12,28,.34)); pointer-events: none; }
  .home-hero__inner { position: relative; z-index: 1; display: grid; min-height: 100svh; grid-template-rows: auto 1fr auto; padding-top: clamp(108px, 12vh, 144px); padding-bottom: clamp(34px, 5vh, 56px); }
  .home-hero__topline, .home-hero__footer { display: flex; align-items: center; justify-content: space-between; gap: 18px; color: rgba(247,249,252,.72); font-size: .66rem; font-weight: 720; letter-spacing: .16em; text-transform: uppercase; }
  .home-hero__badge { display: inline-flex; align-items: center; gap: 10px; padding: 9px 16px; border: 1px solid rgba(255,255,255,.22); border-radius: 999px; color: rgba(255,255,255,.9); background: rgba(6,14,32,.34); backdrop-filter: blur(6px); }
  .home-hero__badge i { width: 6px; height: 6px; border-radius: 50%; background: var(--color-cyan); box-shadow: 0 0 0 4px rgba(34,211,238,.18); }
  .home-hero__content { display: flex; flex-direction: column; justify-content: center; padding-block: clamp(30px, 7vh, 86px); }
  .home-hero__title { width: 100%; max-width: 17ch; margin: 0; color: white; font-size: clamp(2.9rem, 6.2vw, 6.6rem); font-weight: 800; line-height: .92; letter-spacing: -.045em; text-transform: uppercase; text-wrap: balance; }
  .home-hero__title-line { display: block; overflow: hidden; padding-bottom: .09em; margin-bottom: -.09em; }
  .home-hero__title-line > span { display: block; will-change: transform; }
  .home-hero__title-line--accent { color: transparent; background: linear-gradient(96deg, #fff 12%, var(--color-cyan) 92%); -webkit-background-clip: text; background-clip: text; }
  .home-hero__support { display: grid; gap: clamp(20px, 2.6vh, 30px); justify-items: start; max-width: 62ch; margin-top: clamp(26px, 4.4vh, 48px); }
  .home-hero__copy { max-width: 48ch; margin: 0; color: rgba(247,249,252,.86); font-size: clamp(1.02rem, 1.2vw, 1.22rem); line-height: 1.6; }
  .home-hero__reassure { margin: 0; color: rgba(247,249,252,.62); font-size: .82rem; letter-spacing: .02em; }
  .home-hero__actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .home-hero__actions :global(.button) { min-width: 186px; min-height: 60px; border: 1px solid transparent; border-radius: 999px; font-size: 1.02rem; }
  .home-hero__actions :global(.button--primary) { color: var(--color-midnight); background: white; box-shadow: 0 16px 46px rgba(0,0,0,.26); }
  .home-hero__actions :global(.button--secondary) { border-color: rgba(255,255,255,.4); color: white; background: rgba(255,255,255,.06); box-shadow: none; }
  .home-hero__actions :global(.button--secondary:hover) { border-color: rgba(255,255,255,.75); background: rgba(255,255,255,.14); }
  .home-hero__actions :global(.button:focus-visible) { outline: 2px solid var(--color-cyan); outline-offset: 3px; }
  .home-hero__actions :global(.button span) { font-size: 1.05rem; }
  .home-hero__scroll { display: inline-flex; align-items: center; gap: 11px; }
  .home-hero__scroll i { position: relative; width: 26px; height: 1px; overflow: hidden; background: rgba(255,255,255,.25); }
  .home-hero__scroll i::after { position: absolute; inset: 0; background: var(--color-cyan); content: ''; animation: scroll-pulse 2s ease-in-out infinite; }
  .hero-bridge { position: relative; z-index: 3; width: 100%; overflow: hidden; margin-top: -1px; padding-block: clamp(18px, 2.2vw, 30px); color: var(--color-midnight); background: var(--color-background); transform-origin: top; }
  .hero-bridge::before { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(36,87,255,.08), transparent 28%, rgba(34,211,238,.08)); content: ''; }
  .hero-bridge__track { --bridge-gap: clamp(24px, 3vw, 52px); display: flex; width: max-content; align-items: center; gap: var(--bridge-gap); font-size: clamp(2.1rem, 4vw, 5rem); font-weight: 800; line-height: .9; letter-spacing: -.06em; white-space: nowrap; animation: bridge-marquee 28s linear infinite; will-change: transform; }
  .hero-bridge__sequence { display: flex; flex-shrink: 0; align-items: center; gap: var(--bridge-gap); }
  .hero-bridge__sequence span { color: transparent; -webkit-text-stroke: 1px rgba(8,17,38,.28); }
  .hero-bridge__sequence span:nth-of-type(2n) { color: var(--color-midnight); -webkit-text-stroke: 0; }
  .hero-bridge__sequence i { color: var(--color-primary); font-size: .28em; font-style: normal; }
  @keyframes scroll-pulse { 0% { transform: translateX(-105%); } 55%,100% { transform: translateX(105%); } }
  @keyframes bridge-marquee { to { transform: translateX(calc(-50% - var(--bridge-gap) / 2)); } }

  @media (max-width: 900px) {
    .home-hero__title { max-width: 20ch; font-size: clamp(2.6rem, 8.4vw, 4.6rem); }
  }
  @media (max-width: 680px) {
    .home-hero__wash { background: linear-gradient(180deg, rgba(4,10,24,.14) 0%, rgba(4,10,24,.06) 26%, rgba(4,10,24,.42) 58%, rgba(4,10,24,.74) 100%), linear-gradient(90deg, rgba(4,10,24,.46), rgba(4,10,24,.1) 88%); }
    .home-hero__inner { padding-top: 92px; padding-bottom: 26px; }
    .home-hero__footer > span:last-child { display: none; }
    .home-hero__badge { padding: 8px 13px; font-size: .6rem; letter-spacing: .12em; }
    .home-hero__content { justify-content: flex-end; padding-block: 26px 6vh; }
    .home-hero__title { max-width: 100%; font-size: clamp(2.05rem, 9.4vw, 2.9rem); line-height: .98; letter-spacing: -.035em; }
    .home-hero__title-line { overflow: visible; }
    .home-hero__support { gap: 18px; margin-top: 24px; }
    .home-hero__copy { max-width: 34ch; font-size: 1rem; line-height: 1.55; }
    .home-hero__reassure { font-size: .76rem; }
    .home-hero__actions { width: 100%; gap: 10px; }
    .home-hero__actions :global(.button) { flex: 1 1 100%; min-width: 0; min-height: 54px; }
    .hero-bridge { padding-block: 17px; }
  }
  @media (prefers-reduced-motion: reduce) { .home-hero__scroll i::after, .hero-bridge__track { animation: none; transform: none; } }
</style>
