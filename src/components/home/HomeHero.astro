---
import Button from '../Button.astro';
import Icon from '../Icon.astro';
---

<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__grid" aria-hidden="true"></div>
  <div class="container home-hero__inner">
    <div class="home-hero__copy">
      <div class="eyebrow">Agence digitale suisse</div>
      <h1 id="home-title">Transformez votre digital<br />en moteur de <span class="gradient-text">croissance.</span></h1>
      <p class="lead">Sites web, SEO, publicité et intelligence artificielle : Clicom construit les systèmes digitaux qui attirent, convertissent et accélèrent votre croissance.</p>
      <div class="button-row">
        <Button href="/contact#audit">Demander un audit gratuit <span aria-hidden="true">→</span></Button>
        <Button href="/services" variant="secondary">Découvrir nos services</Button>
      </div>
      <p class="hero-proof"><span aria-hidden="true">●──→</span> Web <i>·</i> SEO <i>·</i> Ads <i>·</i> IA <i>·</i> Automatisation</p>
    </div>

    <div class="growth-console" role="img" aria-label="Illustration d’un système reliant acquisition, visibilité, leads et automatisation">
      <div class="console-head"><span><i></i> Growth system</span><small>Stratégie connectée</small></div>
      <div class="console-map" aria-hidden="true">
        <svg viewBox="0 0 620 520" preserveAspectRatio="none"><path d="M104 111C180 111 187 186 264 186H342C420 186 424 111 505 111M104 396C180 396 184 326 264 326H342C421 326 425 396 505 396M302 186V326"/><circle cx="302" cy="256" r="5"/></svg>
      </div>
      <article class="console-card console-card--acquisition">
        <div class="console-card__title"><span class="mini-icon"><Icon name="target" /></span><div><small>Acquisition</small><strong>Canaux actifs</strong></div></div>
        <div class="channel-list"><span>SEO<i></i></span><span>ADS<i></i></span><span>SOCIAL<i></i></span></div>
      </article>
      <article class="console-card console-card--lead">
        <span class="status-dot"></span><div><small>Lead entrant</small><strong>Nouveau prospect</strong></div><span class="arrow">→</span>
      </article>
      <article class="console-card console-card--automation">
        <div class="console-card__title"><span class="mini-icon"><Icon name="automation" /></span><div><small>Automatisation</small><strong>Parcours connecté</strong></div></div>
        <ol><li>Lead</li><li>Qualification</li><li>CRM</li><li>Follow-up</li></ol>
      </article>
      <article class="console-card console-card--visibility">
        <small>Visibilité</small><div><span>Google</span><span>IA</span><span>Social</span></div>
      </article>
      <div class="console-core" aria-hidden="true"><span><Icon name="spark" /></span><small>Clicom</small></div>
    </div>
  </div>
</section>

<style>
  .home-hero { position: relative; min-height: min(900px, calc(100vh - 82px)); overflow: hidden; background: radial-gradient(circle at 78% 32%, rgba(36,87,255,.1), transparent 28%), linear-gradient(180deg, #fff, var(--color-background)); }
  .home-hero__grid { position: absolute; inset: 0; opacity: .48; background-image: linear-gradient(rgba(8,17,38,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(8,17,38,.035) 1px, transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(to bottom, black, transparent 90%); }
  .home-hero__inner { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, .93fr) minmax(520px, 1.07fr); align-items: center; gap: clamp(56px, 7vw, 104px); padding-block: clamp(72px, 9vw, 118px); }
  .home-hero__copy { max-width: 680px; }
  h1 { font-size: clamp(3.5rem, 5.2vw, 5rem); }
  .lead { max-width: 650px; }
  .hero-proof { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 34px 0 0; color: var(--color-text-muted); font-size: .76rem; font-weight: 650; letter-spacing: .02em; }
  .hero-proof > span { color: var(--color-primary); letter-spacing: -.08em; }
  .hero-proof i { color: var(--color-border-strong); font-style: normal; }
  .growth-console { position: relative; min-height: 620px; border: 1px solid rgba(36,87,255,.16); border-radius: 30px; background: rgba(255,255,255,.78); box-shadow: 0 38px 100px rgba(8,17,38,.14); backdrop-filter: blur(14px); container-type: inline-size; }
  .growth-console::before { position: absolute; inset: 56px 18px 18px; border: 1px solid rgba(36,87,255,.08); border-radius: 21px; background-image: radial-gradient(rgba(36,87,255,.16) 1px, transparent 1px); background-size: 20px 20px; content: ''; mask-image: radial-gradient(circle, black, transparent 78%); }
  .console-head { position: relative; z-index: 2; display: flex; min-height: 58px; align-items: center; justify-content: space-between; padding: 0 22px; border-bottom: 1px solid var(--color-border); color: var(--color-text-muted); font-size: .68rem; font-weight: 700; }
  .console-head span { display: flex; align-items: center; gap: 8px; color: var(--color-primary); }
  .console-head i { width: 7px; height: 7px; border-radius: 50%; background: var(--color-primary); box-shadow: 0 0 0 5px rgba(36,87,255,.1); }
  .console-map { position: absolute; inset: 58px 0 0; pointer-events: none; }
  .console-map svg { width: 100%; height: 100%; }
  .console-map path { fill: none; stroke: url(#none); stroke: rgba(36,87,255,.18); stroke-width: 1.4; stroke-dasharray: 7 8; }
  .console-map circle { fill: var(--color-cyan); filter: drop-shadow(0 0 7px rgba(34,211,238,.7)); animation: core-pulse 3s ease-in-out infinite; }
  .console-card { position: absolute; z-index: 2; padding: 18px; border: 1px solid var(--color-border); border-radius: 17px; background: rgba(255,255,255,.95); box-shadow: var(--shadow-card); }
  .console-card small { display: block; color: var(--color-text-muted); font-size: .61rem; font-weight: 700; letter-spacing: .09em; text-transform: uppercase; }
  .console-card strong { display: block; margin-top: 2px; color: var(--color-midnight); font-size: .8rem; }
  .console-card__title { display: flex; align-items: center; gap: 10px; }
  .mini-icon { display: grid; width: 34px; height: 34px; place-items: center; border-radius: 10px; color: var(--color-primary); background: var(--color-primary-soft); }
  .mini-icon :global(svg) { width: 17px; }
  .console-card--acquisition { top: 86px; left: 28px; width: 230px; animation: float-soft 6s ease-in-out infinite; }
  .channel-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 7px; margin-top: 18px; }
  .channel-list span { color: var(--color-text-muted); font-size: .55rem; font-weight: 750; }
  .channel-list i { display: block; height: 3px; margin-top: 6px; border-radius: 3px; background: var(--gradient-brand); }
  .console-card--lead { top: 96px; right: 25px; display: grid; grid-template-columns: auto 1fr auto; width: 230px; align-items: center; gap: 10px; animation: float-soft 7s ease-in-out -2s infinite; }
  .status-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--color-cyan); box-shadow: 0 0 0 6px rgba(34,211,238,.1); }
  .arrow { color: var(--color-primary); }
  .console-card--automation { right: 28px; bottom: 35px; width: 245px; animation: float-soft 8s ease-in-out -1s infinite; }
  .console-card--automation ol { display: grid; gap: 0; margin: 16px 0 0; padding: 0; list-style: none; }
  .console-card--automation li { position: relative; display: flex; min-height: 31px; align-items: center; padding-left: 22px; color: var(--color-text-muted); font-size: .66rem; font-weight: 650; }
  .console-card--automation li::before { position: absolute; left: 2px; width: 7px; height: 7px; border: 2px solid white; border-radius: 50%; background: var(--color-primary); box-shadow: 0 0 0 1px rgba(36,87,255,.3); content: ''; }
  .console-card--automation li:not(:last-child)::after { position: absolute; top: 20px; bottom: -7px; left: 5px; width: 1px; background: rgba(36,87,255,.22); content: ''; }
  .console-card--visibility { bottom: 45px; left: 28px; width: 220px; animation: float-soft 7.5s ease-in-out -3s infinite; }
  .console-card--visibility div { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }
  .console-card--visibility span { padding: 6px 9px; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-text-muted); font-size: .62rem; font-weight: 650; }
  .console-core { position: absolute; top: 50%; left: 50%; z-index: 3; display: grid; place-items: center; transform: translate(-50%,-50%); }
  .console-core span { display: grid; width: 74px; height: 74px; place-items: center; border: 8px solid white; border-radius: 24px; color: white; background: var(--color-primary); box-shadow: 0 20px 45px rgba(36,87,255,.28), 0 0 0 1px rgba(36,87,255,.1); }
  .console-core :global(svg) { width: 25px; }
  .console-core small { margin-top: 8px; color: var(--color-primary); font-size: .62rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  @keyframes float-soft { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  @keyframes core-pulse { 0%,100% { opacity: .45; } 50% { opacity: 1; } }

  @media (max-width: 1100px) { .home-hero { min-height: auto; } .home-hero__inner { grid-template-columns: 1fr; } .home-hero__copy { max-width: 820px; } .growth-console { width: min(100%, 760px); min-height: 590px; } }
  @media (max-width: 680px) { .home-hero__inner { gap: 50px; padding-block: 62px 74px; } h1 { font-size: clamp(2.65rem, 12vw, 3.25rem); } h1 br { display: none; } .hero-proof { line-height: 1.7; } .growth-console { min-height: 650px; border-radius: 24px; } .console-head small { display: none; } .console-map { display: none; } .console-core { top: 48%; } .console-card--acquisition { top: 80px; left: 16px; width: calc(100% - 32px); } .console-card--lead { top: 226px; right: 16px; width: calc(100% - 32px); } .console-card--visibility { bottom: 18px; left: 16px; width: calc(50% - 21px); } .console-card--automation { right: 16px; bottom: 18px; width: calc(50% - 21px); } .console-card--automation ol { margin-top: 12px; } .console-card--automation li { min-height: 27px; padding-left: 18px; font-size: .58rem; } }
  @media (max-width: 390px) { .growth-console { min-height: 680px; } .console-core { top: 45%; } .console-card--visibility, .console-card--automation { width: calc(100% - 32px); } .console-card--visibility { bottom: 184px; } }
  @media (prefers-reduced-motion: reduce) { .console-card, .console-map circle { animation: none; } }
</style>
