---
const steps = [
  ['01','COMPRENDRE','Diagnostiquer votre situation, vos priorités et vos objectifs pour définir un plan d’action pragmatique et adapté à votre réalité.'],
  ['02','CONSTRUIRE','Créer un socle solide : site web performant, messages clairs, formulaires fiables et outils connectés prêts à l’emploi.'],
  ['03','ACTIVER','Lancer la visibilité (SEO, Google Ads, contenus) et mettre en place les automatisations pour générer et traiter les contacts.'],
  ['04','AMÉLIORER','Mesurer les retours réels, optimiser les conversions et faire évoluer vos outils au rythme de la croissance de votre PME.'],
];
import '../../styles/home/method.css';
---

<section id="methode" class="home-section home-method" aria-labelledby="home-method-title" data-method-section>
  <div class="container">
    <div class="home-section-head home-section-head--light" data-reveal data-reveal-type="clip">
      <div>
        <span class="home-kicker">Méthode</span>
        <h2 id="home-method-title">Comprendre d'abord. Construire ensuite.</h2>
      </div>
      <p>Pensé pour les entreprises qui n'ont pas une équipe digitale de vingt personnes : nous intervenons comme une extension de votre équipe, avec clarté, méthode et sans jargon.</p>
    </div>

    <div class="home-method-track" data-home-method>
      <div class="home-method-track__rail" aria-hidden="true"><span data-method-progress></span></div>
      <div class="home-method-track__steps">
        {steps.map(([number,title,copy], index) => (
          <article class:list={['home-method-step', index === 0 && 'is-active']} data-method-step data-step-index={index} data-reveal data-reveal-type="slide">
            <span class="home-method-step__node" aria-hidden="true"></span>
            <span class="home-method-step__number">{number}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
<script>import '../../scripts/home-method-motion';</script>
