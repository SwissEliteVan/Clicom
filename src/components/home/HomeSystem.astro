---
import HomeSystemVisual from './HomeSystemVisual.astro';
import '../../styles/home-system-immersive.css';
const stages = [
  { number:'01', label:'PRÉSENCE DIGITALE', title:'Rendre votre entreprise visible et crédible.', copy:'Site Internet, identité, référencement local et contenus construisent une présence claire pour être trouvé, compris et contacté.', meta:'SITE INTERNET · RÉFÉRENCEMENT LOCAL · CONTENU' },
  { number:'02', label:'ACQUISITION', title:'Transformer la visibilité en demandes.', copy:'Les trajectoires se multiplient et convergent : référencement, publicité et pages d’arrivée relient l’attention à une prise de contact concrète.', meta:'VISIBILITÉ · DEMANDES · CONVERSION' },
  { number:'03', label:'AUTOMATISATION', title:'Organiser chaque demande sans perdre l’humain.', copy:'Les signaux reçus sont triés, qualifiés et distribués vers les bonnes actions pour accélérer le suivi et réduire les tâches répétitives.', meta:'REÇU · QUALIFIÉ · TRANSMIS · RELANCÉ' },
  { number:'04', label:'PERFORMANCE & SÉCURITÉ', title:'Mesurer, protéger et améliorer le système.', copy:'Le réseau devient stable et contrôlé : suivi des résultats, optimisation continue, sauvegardes et protection des accès renforcent sa fiabilité.', meta:'MESURÉ · OPTIMISÉ · PROTÉGÉ · SUIVI' },
];
---
<section id="systeme" class="home-section home-system-section home-section--dark" aria-labelledby="home-system-title" data-system-story>
  <div class="home-system-section__continuity" aria-hidden="true"><i></i></div>
  <div class="container">
    <div class="home-section-head home-system-section__head" data-reveal data-reveal-type="clip"><div><span class="home-kicker">Méthode PME 2026</span><h2 id="home-system-title">Votre présence digitale doit devenir un outil de travail.</h2></div><p>Nous partons de l’essentiel, puis nous construisons un système évolutif : visibilité, acquisition, automatisation, données et sécurité.</p></div>
    <div class="home-system-story">
      <HomeSystemVisual />
      <div class="home-system-story__steps">
        {stages.map((stage,index)=><article class:list={['home-system-stage-v2',index===0&&'is-active']} data-system-step data-stage-index={index}><div class="home-system-stage-v2__meta"><span>{stage.number}</span><small>{stage.label}</small></div><h3>{stage.title}</h3><p>{stage.copy}</p><span class="home-system-stage-v2__stack">{stage.meta}</span><div class="home-system-stage-v2__mini" aria-hidden="true">{Array.from({length:4},(_,i)=><i style={`--mini:${i}`}></i>)}</div></article>)}
      </div>
    </div>
  </div>
</section>
<script>import '../../scripts/home-system-motion';</script>
