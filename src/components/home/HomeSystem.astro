---
import HomeSystemVisual from './HomeSystemVisual.astro';
import '../../styles/home/system.css';
const stages = [
  { number:'01', label:'PRÉSENCE DIGITALE', title:'Rendre votre entreprise visible et crédible.', copy:'Site Internet rapide, identité soignée et référencement local pour être trouvé facilement, inspirer confiance et donner envie de vous contacter.', meta:'SITE WEB · IDENTITÉ · RÉFÉRENCEMENT LOCAL' },
  { number:'02', label:'ACQUISITION', title:'Transformer la visibilité en opportunités.', copy:'Référencement ciblé, publicité locale et pages de conversion conçus pour attirer des prospects qualifiés et déclencher des demandes.', meta:'SEO · GOOGLE ADS · CONVERSION' },
  { number:'03', label:'AUTOMATISATION', title:'Traiter chaque demande sans perdre de temps.', copy:'Centralisation des contacts, qualification instantanée et alertes automatiques pour répondre plus vite sans alourdir votre quotidien.', meta:'CRM · QUALIFICATION · NOTIFICATIONS · RELANCES' },
  { number:'04', label:'PERFORMANCE & SÉCURITÉ', title:'Mesurer, protéger et améliorer le système.', copy:'Suivi des résultats concrets, sauvegardes régulières, conformité et protection des accès pour garantir un système fiable et pérenne.', meta:'MESURE · SÉCURITÉ · SUIVI · AMÉLIORATION' },
];
---
<section id="systeme" class="home-section home-system-section home-section--dark" aria-labelledby="home-system-title" data-system-story>
  <div class="home-system-section__continuity" aria-hidden="true"><i></i></div>
  <div class="container">
    <div class="home-section-head home-system-section__head" data-reveal data-reveal-type="clip"><div><span class="home-kicker">Système digital</span><h2 id="home-system-title">Un seul partenaire pour construire un digital cohérent.</h2></div><p>Site web, visibilité, acquisition, CRM, automatisation, données et sécurité : au lieu d'accumuler des outils isolés, nous créons un système unifié où chaque composant renforce les autres.</p></div>
    <div class="home-system-story">
      <HomeSystemVisual />
      <div class="home-system-story__steps">
        {stages.map((stage,index)=><article class:list={['home-system-stage-v2',index===0&&'is-active']} data-system-step data-stage-index={index}><div class="home-system-stage-v2__meta"><span>{stage.number}</span><small>{stage.label}</small></div><h3>{stage.title}</h3><p>{stage.copy}</p><span class="home-system-stage-v2__stack">{stage.meta}</span><div class="home-system-stage-v2__mini" aria-hidden="true">{Array.from({length:4},(_,i)=><i style={`--mini:${i}`}></i>)}</div></article>)}
      </div>
    </div>
  </div>
</section>
<script>import '../../scripts/home-system-motion';</script>
