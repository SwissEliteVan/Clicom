---
import '../../styles/home/system.css';
const phases = ['Visibilité', 'Conversion', 'Traitement', 'Suivi'];
---
<section id="demonstration" class="flow-section" data-flow-section aria-labelledby="flow-title">
  <div class="container">
    <div class="flow-panel">
      <div class="flow-panel__grid" aria-hidden="true"></div>

      <div class="section-heading flow-panel__head" data-reveal="fade">
        <div class="eyebrow eyebrow--cyan">Démonstration de savoir-faire</div>
        <h2 id="flow-title">Comment le système transforme une recherche en client.</h2>
        <p>Chaque composant alimente le suivant : la visibilité attire, le site crédibilise, l’automatisation traite et le suivi transforme.</p>
      </div>

      <div class="flow-visual" data-reveal="fade" aria-hidden="true">
        <svg viewBox="0 0 980 240" fill="none" preserveAspectRatio="xMidYMid meet">
          <defs>
            <linearGradient id="flow-line-g" x1="0" y1="0" x2="1" y2="0">
              <stop stop-color="#1b44e4" stop-opacity="0.9" />
              <stop offset="1" stop-color="#22d3ee" stop-opacity="0.8" />
            </linearGradient>
          </defs>

          <path data-flow-path pathLength="1" d="M95 120 C 150 78, 175 78, 215 92" stroke="url(#flow-line-g)" stroke-width="1.6" />
          <path data-flow-path pathLength="1" d="M275 92 C 318 78, 340 78, 375 120" stroke="url(#flow-line-g)" stroke-width="1.6" />
          <path data-flow-path pathLength="1" d="M435 120 C 470 78, 495 78, 535 92" stroke="url(#flow-line-g)" stroke-width="1.6" />
          <path data-flow-path pathLength="1" d="M595 92 C 638 78, 660 78, 695 120" stroke="url(#flow-line-g)" stroke-width="1.6" />
          <path data-flow-path pathLength="1" d="M755 120 C 790 78, 815 78, 855 92" stroke="url(#flow-line-g)" stroke-width="1.6" />
          <path data-flow-path pathLength="1" d="M915 92 C 950 70, 950 170, 940 192" stroke="url(#flow-line-g)" stroke-width="1.6" />

          <g data-flow-node transform="translate(80 120)"><circle r="16" fill="#0d2047" stroke="#22d3ee" stroke-width="1.4" /><text x="0" y="44" text-anchor="middle">VISITEUR</text></g>
          <g data-flow-node transform="translate(245 92)"><circle r="16" fill="#0d2047" stroke="#22d3ee" stroke-width="1.4" /><text x="0" y="44" text-anchor="middle">RECHERCHE</text></g>
          <g data-flow-node transform="translate(405 120)"><circle r="16" fill="#0d2047" stroke="#1b44e4" stroke-width="1.4" /><text x="0" y="44" text-anchor="middle">SITE</text></g>
          <g data-flow-node transform="translate(565 92)"><circle r="16" fill="#0d2047" stroke="#1b44e4" stroke-width="1.4" /><text x="0" y="44" text-anchor="middle">FORMULAIRE</text></g>
          <g data-flow-node transform="translate(725 120)"><circle r="16" fill="#0d2047" stroke="#22d3ee" stroke-width="1.4" /><text x="0" y="44" text-anchor="middle">CRM</text></g>
          <g data-flow-node transform="translate(885 92)"><circle r="16" fill="#0d2047" stroke="#22d3ee" stroke-width="1.4" /><text x="0" y="44" text-anchor="middle">RELANCE</text></g>
          <g data-flow-node transform="translate(940 192)"><circle r="22" fill="rgba(34,211,238,.12)" stroke="#22d3ee" stroke-width="1.6" /><text x="0" y="44" text-anchor="middle" class="flow-node__client">CLIENT</text></g>

          <g>
            <circle r="4" fill="#22d3ee"><animateMotion dur="2.6s" repeatCount="indefinite" path="M95 120 C 150 78, 175 78, 215 92" /></circle>
          </g>
          <g>
            <circle r="4" fill="#22d3ee"><animateMotion dur="2.2s" repeatCount="indefinite" path="M275 92 C 318 78, 340 78, 375 120" begin=".3s" /></circle>
          </g>
          <g>
            <circle r="4" fill="#22d3ee"><animateMotion dur="2.8s" repeatCount="indefinite" path="M435 120 C 470 78, 495 78, 535 92" begin=".5s" /></circle>
          </g>
          <g>
            <circle r="4" fill="#22d3ee"><animateMotion dur="2.4s" repeatCount="indefinite" path="M595 92 C 638 78, 660 78, 695 120" begin=".7s" /></circle>
          </g>
          <g>
            <circle r="4" fill="#22d3ee"><animateMotion dur="2.7s" repeatCount="indefinite" path="M755 120 C 790 78, 815 78, 855 92" begin=".9s" /></circle>
          </g>
          <g>
            <circle r="4" fill="#49e390"><animateMotion dur="2.9s" repeatCount="indefinite" path="M915 92 C 950 70, 950 170, 940 192" begin="1.1s" /></circle>
          </g>
        </svg>
      </div>

      <ol class="flow-mobile" aria-hidden="true">
        <li><span>1</span>Visiteur</li>
        <li><span>2</span>Recherche</li>
        <li><span>3</span>Site</li>
        <li><span>4</span>Formulaire</li>
        <li><span>5</span>CRM</li>
        <li><span>6</span>Relance</li>
        <li><span>7</span>Client</li>
      </ol>

      <div class="flow-legend" data-reveal="fade">
        {phases.map((phase) => <span>{phase}</span>)}
      </div>
    </div>
  </div>
</section>
