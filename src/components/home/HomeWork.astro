---
import Button from '../Button.astro';
import { caseStudies } from '../../data/case-studies';
import '../../styles/home/work.css';
const studies = caseStudies;
---
<section id="realisations" class="work-section" aria-labelledby="work-title">
  <div class="container work-section__head">
    <div class="section-heading" data-reveal>
      <div class="eyebrow">Selected Work</div>
      <h2 id="work-title">Des projets conçus pour être utilisés, pas seulement présentés.</h2>
      <p>Chaque réalisation répond à un enjeu précis : structurer une offre lisible, inspirer confiance et guider le visiteur vers une prise de contact simple et fluide.</p>
    </div>
  </div>

  <div class="work-list">
    {studies.map((study, index) => (
      <article class:list={['work-item', index % 2 === 1 && 'work-item--reverse']} data-reveal>
        <a class="work-item__media" href={`/realisations/${study.slug}/`} tabindex="-1" aria-hidden="true">
          <img src={study.image.src} alt="" width={study.image.width} height={study.image.height} loading="lazy" decoding="async" />
        </a>
        <div class="work-item__body">
          <div class="work-item__meta">
            <span>Projet 0{index + 1}</span><i></i><small>{new Date(study.date).getFullYear()}</small><i></i><small>{study.sector}</small>
          </div>
          <h3><a href={`/realisations/${study.slug}/`}>{study.client}</a></h3>
          <p class="work-item__role">{study.services.map((s) => s.label).join(' · ')}</p>
          {study.results[0] && (
            <p class="work-item__result"><strong>{study.results[0].value}.</strong> {study.results[0].context}</p>
          )}
          <a class="text-link" href={`/realisations/${study.slug}/`}>Voir l’étude de cas <span aria-hidden="true">↗</span></a>
        </div>
      </article>
    ))}
  </div>

  <div class="container work-section__action" data-reveal>
    <Button href="/realisations/" variant="secondary">Voir toutes les réalisations <span aria-hidden="true">→</span></Button>
  </div>
</section>
