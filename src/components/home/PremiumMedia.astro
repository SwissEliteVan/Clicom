---
interface Props { type: 'web' | 'search' | 'ads' | 'crm' | 'monitor'; compact?: boolean; }
const { type, compact = false } = Astro.props;
const labels = {
  web: ['CLICOM / WEB', 'Site performant', '+ mobile'],
  search: ['SEARCH / LOCAL', 'Agence digitale suisse', 'Top 3'],
  ads: ['ACQUISITION', 'Demandes qualifiées', '+24%'],
  crm: ['CRM / AUTOMATION', 'Nouveau prospect', 'Qualifié'],
  monitor: ['PERFORMANCE', 'Tous les systèmes', 'Opérationnels'],
};
const [eyebrow, title, status] = labels[type];
---

<div class:list={['premium-media', `premium-media--${type}`, compact && 'premium-media--compact']} data-premium-media={type}>
  <div class="premium-media__bar"><span><i></i><i></i><i></i></span><small>{eyebrow}</small><b>•••</b></div>
  <div class="premium-media__body">
    <div class="premium-media__head"><div><small>Vue active</small><strong>{title}</strong></div><span>{status}</span></div>
    {type === 'web' && <div class="media-site"><div><small>PME SUISSE</small><b>Une présence digitale<br/>qui travaille.</b><i></i></div><aside><span></span><span></span><span></span></aside></div>}
    {type === 'search' && <div class="media-search"><div class="media-search__field">agence digitale suisse <b>⌕</b></div><article><small>clicom.ch</small><strong>Le digital utile aux PME</strong><p>Sites web · SEO · Ads · Automatisation</p></article><div class="media-map"><i></i><span>Lausanne</span><span>Genève</span></div></div>}
    {type === 'ads' && <div class="media-chart"><div class="media-chart__stats"><span><small>Prospects</small><b>128</b></span><span><small>Conversion</small><b>6.8%</b></span><span><small>CPA</small><b>CHF 42</b></span></div><svg viewBox="0 0 320 110" preserveAspectRatio="none"><path d="M0 91 C42 86 55 66 88 72 S135 47 166 54 S225 19 320 12"/><path class="area" d="M0 91 C42 86 55 66 88 72 S135 47 166 54 S225 19 320 12 L320 110 L0 110Z"/></svg></div>}
    {type === 'crm' && <div class="media-crm"><div><small>NOUVEAU</small><span>Demande reçue</span><b>Formulaire web</b></div><i>→</i><div><small>IA</small><span>Lead qualifié</span><b>Score 86 / 100</b></div><i>→</i><div><small>CRM</small><span>Suivi créé</span><b>Réponse &lt; 5 min</b></div></div>}
    {type === 'monitor' && <div class="media-monitor"><div class="media-monitor__ring"><span>99.9<small>%</small></span></div><ul><li><i></i>Site web <b>OK</b></li><li><i></i>Sauvegarde <b>À jour</b></li><li><i></i>SSL & accès <b>Protégés</b></li></ul></div>}
  </div>
</div>

<style>
  .premium-media{position:relative;overflow:hidden;border:1px solid rgba(255,255,255,.14);border-radius:18px;color:#f7f9fc;background:linear-gradient(145deg,rgba(16,31,67,.96),rgba(6,14,31,.98));box-shadow:0 24px 70px rgba(0,0,0,.24);font-family:Manrope,sans-serif}.premium-media::after{position:absolute;inset:0;opacity:.12;background-image:linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px);background-size:28px 28px;content:'';mask-image:linear-gradient(135deg,#000,transparent 72%);pointer-events:none}.premium-media__bar{position:relative;z-index:2;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:10px 13px;border-bottom:1px solid rgba(255,255,255,.09);color:rgba(255,255,255,.4);font-size:.5rem;letter-spacing:.12em}.premium-media__bar>span{display:flex;gap:4px}.premium-media__bar i{width:5px;height:5px;border-radius:50%;background:rgba(255,255,255,.24)}.premium-media__bar b{text-align:right}.premium-media__body{position:relative;z-index:1;padding:16px}.premium-media__head{display:flex;align-items:end;justify-content:space-between;gap:12px;margin-bottom:18px}.premium-media__head div{display:grid;gap:2px}.premium-media__head small{color:rgba(255,255,255,.4);font-size:.48rem;letter-spacing:.12em;text-transform:uppercase}.premium-media__head strong{font-size:.82rem}.premium-media__head>span{padding:5px 8px;border:1px solid rgba(34,211,238,.22);border-radius:99px;color:#67e8f9;background:rgba(34,211,238,.07);font-size:.5rem;font-weight:800}.media-site{display:grid;grid-template-columns:1fr 34%;gap:12px}.media-site>div{min-height:130px;padding:18px;border-radius:12px;background:linear-gradient(135deg,#f8fafc,#dfe8ff);color:#081126}.media-site small{font-size:.45rem;letter-spacing:.14em}.media-site b{display:block;margin-top:18px;font-size:1.05rem;line-height:1.05}.media-site i{display:block;width:54px;height:7px;margin-top:18px;border-radius:99px;background:#2457ff}.media-site aside{display:grid;gap:7px;padding:8px;border:1px solid rgba(255,255,255,.12);border-radius:16px;background:#0e1d3f}.media-site aside span{border-radius:7px;background:linear-gradient(135deg,rgba(36,87,255,.45),rgba(34,211,238,.12))}.media-search__field{padding:9px 12px;border-radius:99px;color:#081126;background:#fff;font-size:.62rem}.media-search__field b{float:right;color:#2457ff}.media-search article{margin:10px 0;padding:10px 12px;border-left:2px solid #22d3ee;background:rgba(255,255,255,.05)}.media-search article>*{display:block}.media-search article small{color:#67e8f9;font-size:.48rem}.media-search article strong{margin:4px 0;font-size:.72rem}.media-search article p{margin:0;color:rgba(255,255,255,.45);font-size:.5rem}.media-map{position:relative;height:48px;border-radius:9px;background:radial-gradient(circle at 60% 45%,rgba(34,211,238,.28),transparent 10%),linear-gradient(135deg,rgba(36,87,255,.18),rgba(255,255,255,.04))}.media-map span{position:absolute;font-size:.44rem}.media-map span:nth-of-type(1){left:18%;top:15px}.media-map span:nth-of-type(2){right:17%;bottom:8px}.media-chart__stats{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.media-chart__stats span{display:grid;padding:8px;border:1px solid rgba(255,255,255,.08);border-radius:9px}.media-chart__stats small{color:rgba(255,255,255,.42);font-size:.43rem}.media-chart__stats b{font-size:.72rem}.media-chart svg{width:100%;height:86px;margin-top:8px;overflow:visible}.media-chart path{fill:none;stroke:#22d3ee;stroke-width:2}.media-chart .area{fill:url(#none);fill:rgba(36,87,255,.13);stroke:none}.media-crm{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;align-items:center;gap:6px}.media-crm>div{display:grid;gap:4px;min-height:92px;padding:10px;border:1px solid rgba(255,255,255,.1);border-radius:10px;background:rgba(255,255,255,.04)}.media-crm small{color:#67e8f9;font-size:.42rem}.media-crm span{font-size:.6rem;font-weight:800}.media-crm b{color:rgba(255,255,255,.4);font-size:.45rem}.media-crm>i{color:#22d3ee;font-style:normal}.media-monitor{display:grid;grid-template-columns:105px 1fr;align-items:center;gap:16px}.media-monitor__ring{display:grid;aspect-ratio:1;place-items:center;border:8px solid rgba(34,211,238,.13);border-top-color:#22d3ee;border-radius:50%;box-shadow:0 0 28px rgba(34,211,238,.1)}.media-monitor__ring span{font-size:1.15rem;font-weight:800}.media-monitor__ring small{font-size:.55rem}.media-monitor ul{display:grid;gap:6px;margin:0;padding:0;list-style:none}.media-monitor li{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:6px;padding:7px;border-bottom:1px solid rgba(255,255,255,.07);font-size:.5rem}.media-monitor li i{width:5px;height:5px;border-radius:50%;background:#49e390;box-shadow:0 0 8px #49e390}.media-monitor li b{color:#49e390}.premium-media--compact .premium-media__body{padding:11px}.premium-media--compact .premium-media__head{margin-bottom:10px}.premium-media--compact .media-site>div{min-height:88px}.premium-media--compact .media-chart svg{height:54px}@media(max-width:520px){.media-crm{grid-template-columns:1fr}.media-crm>i{display:none}.media-monitor{grid-template-columns:78px 1fr}.premium-media__bar small{font-size:.42rem}}
</style>
