---
const fragments=['service','local','solution','besoin','proximité','entreprise','conseil','qualité','réponse','expertise','Lausanne','Genève','Suisse','utile','rapide','fiable','contenu','recherche','question','adresse','contact','activité','métier','région'];
---
<div class="expertise-media expertise-visibility" data-expertise-media="visibility" aria-hidden="true">
  <svg viewBox="0 0 620 420"><g data-visibility-lines>{Array.from({length:12},(_,i)=><path pathLength="1" d={`M${20+(i%4)*190} ${30+Math.floor(i/4)*170} Q310 ${90+(i%3)*105} ${255+(i%3)*55} ${178+(i%4)*28}`}/>)}</g><circle cx="310" cy="210" r="74"/><circle cx="310" cy="210" r="116"/></svg>
  <div class="expertise-visibility__field">{fragments.map((word,index)=><span data-visibility-fragment style={`--x:${(index*37)%91}%;--y:${(index*53)%87}%;--i:${index}`}>{word}</span>)}</div>
  <div class="expertise-visibility__core"><small>RECHERCHÉ</small><b>PERTINENT</b><span>VISIBLE</span><strong>TROUVÉ</strong></div>
</div>
