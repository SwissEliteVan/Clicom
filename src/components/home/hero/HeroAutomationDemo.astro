---
const steps = ['FORMULAIRE REÇU','CONTACT ENREGISTRÉ','COURRIEL ENVOYÉ','RAPPEL CRÉÉ','COMMERCIAL INFORMÉ'];
---
<section class="hero-demo hero-automation" data-scene="automation" tabindex="-1"><header><span>AUTOMATISATION</span><small>Chaîne d’actions</small></header><div class="hero-automation__flow">{steps.map((step,index)=><div class="hero-automation__step" data-automation-step><i></i><span>{step}</span><small>{index === 0 ? 'En cours' : 'En attente'}</small></div>)}</div></section>
