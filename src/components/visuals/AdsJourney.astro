---
const cards=[['RECHERCHE',65,205],['ANNONCE',220,145],['PAGE',382,85],['CONVERSION',552,145],['OPTIMISATION',718,205]];
---
<div class="ads-journey" data-visual-motion aria-hidden="true"><svg viewBox="0 0 900 380"><path class="journey-track" data-visual-path d="M125 228C190 228 176 168 236 168S342 108 398 108S510 168 568 168S658 228 734 228"/>{cards.map(([label,x,y],i)=><g class:list={['journey-card',{'conversion':i===3}]} data-visual-node><rect x={x} y={y} width="120" height="78" rx="16"/><text class="number" x={Number(x)+18} y={Number(y)+22}>{String(i+1).padStart(2,'0')}</text><text x={Number(x)+60} y={Number(y)+49} text-anchor="middle">{label}</text>{i===2&&<path class="landing-lines" d={`M${Number(x)+18} ${Number(y)+60}h84`}/>}</g>)}<path class="feedback" d="M778 285C778 338 278 344 278 282"/><circle class="journey-signal" r="5"/></svg></div><script>import '../../scripts/visuals/svg-motion';</script><style>
  .ads-journey, .ads-journey svg { width: 100%; min-height: 340px; }
  /* Level 3: Feedback return loop */
  .feedback { fill: none; stroke: rgba(36, 87, 255, 0.18); stroke-width: var(--visual-line-secondary); stroke-dasharray: 4 8; }
  /* Level 2: Main acquisition track & step cards */
  .journey-track { fill: none; stroke: var(--color-primary); stroke-width: var(--visual-line-active); }
  .journey-card rect { fill: #ffffff; stroke: rgba(36, 87, 255, 0.25); stroke-width: var(--visual-line-primary); filter: drop-shadow(0 8px 16px rgba(8, 17, 38, 0.05)); }
  .journey-card text { fill: var(--color-text-muted); font: 700 9px 'Manrope Variable', Manrope, sans-serif; letter-spacing: 0.09em; }
  .journey-card .number { fill: var(--color-primary); font-size: 8px; }
  .landing-lines { stroke: rgba(36, 87, 255, 0.15); stroke-width: var(--visual-line-secondary); }
  /* Level 1: Conversion goal step & signal */
  .journey-card.conversion rect { fill: rgba(34, 211, 238, 0.08); stroke: var(--color-cyan); stroke-width: var(--visual-line-active); }
  .journey-signal { fill: var(--color-cyan); offset-path: path('M125 228C190 228 176 168 236 168S342 108 398 108S510 168 568 168S658 228 734 228'); filter: drop-shadow(0 0 4px rgba(34, 211, 238, 0.65)); }
  .is-visual-active .journey-signal { animation: journey 9s ease-in-out infinite; }
  @keyframes journey {
    0%, 8% { offset-distance: 0; }
    92%, 100% { offset-distance: 100%; }
  }
  @media (max-width: 680px) {
    .ads-journey, .ads-journey svg { min-height: 240px; }
    .journey-card text { font-size: 8px; }
    .journey-signal { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .journey-signal { animation: none; }
  }
</style>
