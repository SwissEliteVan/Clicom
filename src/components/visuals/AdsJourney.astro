---
const cards=[['RECHERCHE',65,205],['ANNONCE',220,145],['LANDING',382,85],['CONVERSION',552,145],['OPTIMISATION',718,205]];
---
<div class="ads-journey" data-visual-motion aria-hidden="true"><svg viewBox="0 0 900 380"><path class="journey-track" data-visual-path d="M125 228C190 228 176 168 236 168S342 108 398 108S510 168 568 168S658 228 734 228"/>{cards.map(([label,x,y],i)=><g class:list={['journey-card',{'conversion':i===3}]} data-visual-node><rect x={x} y={y} width="120" height="78" rx="16"/><text class="number" x={Number(x)+18} y={Number(y)+22}>{String(i+1).padStart(2,'0')}</text><text x={Number(x)+60} y={Number(y)+49} text-anchor="middle">{label}</text>{i===2&&<path class="landing-lines" d={`M${Number(x)+18} ${Number(y)+60}h84`}/>}</g>)}<path class="feedback" d="M778 285C778 338 278 344 278 282"/><circle class="journey-signal" r="5"/></svg></div><script>import '../../scripts/visuals/svg-motion';</script><style>.ads-journey,.ads-journey svg{width:100%;min-height:340px}.journey-track,.feedback{fill:none;stroke:rgba(36,87,255,.26);stroke-width:var(--visual-line-primary)}.journey-track{stroke:#2457ff;stroke-width:var(--visual-line-active)}.feedback{stroke-dasharray:4 8}.journey-card rect{fill:white;stroke:rgba(36,87,255,.3);stroke-width:var(--visual-line-primary);filter:drop-shadow(0 10px 18px rgba(8,17,38,.06))}.journey-card.conversion rect{fill:rgba(34,211,238,.1);stroke:#22d3ee}.journey-card text{fill:#58657a;font:700 9px Manrope,sans-serif;letter-spacing:.08em}.journey-card .number{fill:#2457ff;font-size:8px}.landing-lines{stroke:rgba(36,87,255,.18);stroke-width:var(--visual-line-secondary)}.journey-signal{fill:#22d3ee;offset-path:path('M125 228C190 228 176 168 236 168S342 108 398 108S510 168 568 168S658 228 734 228');filter:drop-shadow(0 0 5px #22d3ee)}.is-visual-active .journey-signal{animation:journey 9s ease-in-out infinite}@keyframes journey{0%,8%{offset-distance:0}92%,100%{offset-distance:100%}}@media(max-width:680px){.ads-journey,.ads-journey svg{min-height:240px}.journey-card text{font-size:8px}.journey-signal{display:none}}@media(prefers-reduced-motion:reduce){.journey-signal{animation:none}}</style>
