---
const nodes=[['CONTENU',120,110,24],['ENTITÉS',330,80,30],['CONTEXTE',455,205,42],['MOTEURS',680,92,30],['RÉPONSE',780,250,25],['SOURCE',220,275,18],['MARQUE',585,292,20]];
---
<div class="knowledge" data-visual-motion aria-hidden="true"><svg viewBox="0 0 900 380" focusable="false"><g class="knowledge-grid"><path d="M40 95H860M40 190H860M40 285H860M190 35V345M450 35V345M710 35V345"/></g><g class="knowledge-links"><path data-visual-path d="M120 110L330 80L455 205L680 92L780 250L585 292L455 205L220 275L120 110M330 80L680 92M220 275L585 292"/></g>{nodes.map(([label,x,y,r],i)=><g class:list={['knowledge-node',{'core':i===2}]} data-visual-node><circle cx={x} cy={y} r={r}/><circle class="dot" cx={x} cy={y} r="4"/><text x={x} y={Number(y)+Number(r)+20} text-anchor="middle">{label}</text></g>)}<circle class="knowledge-pulse" cx="455" cy="205" r="54"/></svg></div><script>import '../../scripts/visuals/svg-motion';</script><style>
  .knowledge, .knowledge svg { width: 100%; min-height: 340px; }
  /* Level 3: Grid backdrop */
  .knowledge-grid path { fill: none; stroke: rgba(255, 255, 255, 0.045); stroke-width: var(--visual-line-secondary); }
  /* Level 2: Semantic links */
  .knowledge-links path { fill: none; stroke: var(--color-cyan); stroke-opacity: 0.4; stroke-width: var(--visual-line-primary); }
  .knowledge-node circle { fill: #0b1833; stroke: rgba(34, 211, 238, 0.35); stroke-width: var(--visual-line-primary); }
  .knowledge-node .dot { fill: var(--color-cyan); stroke: none; }
  .knowledge-node text { fill: rgba(255, 255, 255, 0.72); font: 700 9px 'Manrope Variable', Manrope, sans-serif; letter-spacing: 0.11em; }
  /* Level 1: Central Core Node */
  .knowledge-node.core circle:first-child { fill: rgba(36, 87, 255, 0.22); stroke: var(--color-cyan); stroke-width: var(--visual-line-active); filter: drop-shadow(0 0 10px rgba(34, 211, 238, 0.38)); }
  .knowledge-pulse { fill: none; stroke: var(--color-cyan); stroke-width: var(--visual-line-secondary); opacity: 0; transform-origin: 455px 205px; }
  .is-visual-active .knowledge-pulse { animation: knowledge-pulse 6s ease-in-out infinite; }
  @keyframes knowledge-pulse {
    0%, 100% { opacity: 0; transform: scale(0.8); }
    45% { opacity: 0.3; }
    80% { opacity: 0; transform: scale(1.3); }
  }
  @media (max-width: 680px) {
    .knowledge, .knowledge svg { min-height: 240px; }
    .knowledge-node text { font-size: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .knowledge-pulse { animation: none; }
  }
</style>
