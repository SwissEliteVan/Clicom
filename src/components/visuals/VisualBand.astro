---
import VisualSystem from './VisualSystem.astro';
interface Props{type:'services'|'audit'|'editorial';eyebrow:string;title:string;text:string}
const{type,eyebrow,title,text}=Astro.props;
---
<section class:list={['system-band',`system-band--${type}`]} aria-labelledby={`system-${type}`}><div class="container system-band__layout"><div><div class="eyebrow">{eyebrow}</div><h2 id={`system-${type}`}>{title}</h2><p>{text}</p></div><div class="system-band__visual"><VisualSystem {type}/></div></div></section>
<style>.system-band{padding-block:clamp(5rem,9vw,8rem);overflow:hidden;background:var(--color-primary-soft)}.system-band__layout{display:grid;grid-template-columns:.7fr 1.3fr;align-items:center;gap:clamp(42px,8vw,110px)}.system-band__visual{overflow:hidden;border:1px solid rgba(36,87,255,.16);border-radius:var(--radius-surface);background:rgba(255,255,255,.72);box-shadow:var(--shadow-card)}.system-band p{max-width:550px}.system-band--editorial{background:white}.system-band--editorial .system-band__visual{box-shadow:none}@media(max-width:900px){.system-band__layout{grid-template-columns:1fr}}@media(max-width:680px){.system-band{padding-block:4rem}}</style>
