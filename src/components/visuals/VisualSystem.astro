---
interface Props{type:'web'|'seo'|'geo'|'ads'|'automation'|'services'|'audit'|'editorial'}
const{type}=Astro.props;
const data={seo:['PAGES','EXPLORATION','INDEX','POSITION','CONVERSION'],ads:['RECHERCHE','ANNONCE','PAGE','CONVERSION','OPTIMISATION'],automation:['DÉCLENCHEUR','TRAITEMENT','DÉCISION','ACTION'],services:['ACQUISITION','CRÉATION','TECHNOLOGIE'],audit:['SITE','SEO','PUBLICITÉ','RÉSEAUX','IA','CONVERSION'],editorial:['SIGNAL','ANALYSE','DÉCISION'],geo:['CONTENU','ENTITÉS','CONTEXTE','MOTEURS','RÉPONSE'],web:['ORDINATEUR','TABLETTE','MOBILE']}[type];
const count=data.length;const points=Array.from({length:count},(_,i)=>{const x=90+i*(720/Math.max(1,count-1));const y=type==='geo'?180+Math.sin(i*1.8)*82:type==='services'?180+(i===1?-85:50):type==='audit'?180+Math.sin(i*1.7)*100:180+Math.sin(i*1.35)*50;return[x,y]});const route=points.map((p,i)=>`${i?'L':'M'}${p[0]} ${p[1]}`).join(' ');
---
<div class:list={['visual-system',`visual-system--${type}`]} data-visual-motion aria-hidden="true"><svg viewBox="0 0 900 380"><defs><linearGradient id={`vs-${type}`}><stop stop-color="#2457FF"/><stop offset="1" stop-color="#22D3EE"/></linearGradient></defs><g class="grid"><path d="M40 80H860M40 180H860M40 280H860"/><path d="M120 35V335M340 35V335M560 35V335M780 35V335"/></g><path class="ghost" d={route}/><path class="route" data-visual-path d={route} stroke={`url(#vs-${type})`}/>{points.map(([x,y],i)=><g class:list={['node',{'core':i===Math.floor(count/2)}]} data-visual-node><circle cx={x} cy={y} r={type==='audit'?48:i===Math.floor(count/2)?34:22}/><circle class="dot" cx={x} cy={y} r="4"/><text x={x} y={y+58} text-anchor="middle">{data[i]}</text></g>)}</svg></div>
<script>import '../../scripts/visuals/svg-motion';</script>
<style>
  .visual-system, svg { width: 100%; min-height: 330px; }
  svg { display: block; height: 100%; }
  /* Level 3: Background grid */
  .grid path { fill: none; stroke: rgba(36, 87, 255, 0.07); }
  /* Level 2: Trajectory path & standard nodes */
  .ghost { fill: none; stroke: rgba(36, 87, 255, 0.16); stroke-width: 1.4; }
  .route { fill: none; stroke-width: 2.2; stroke-linecap: round; }
  .node circle { fill: rgba(255, 255, 255, 0.94); stroke: rgba(36, 87, 255, 0.25); stroke-width: var(--visual-line-primary); }
  .node .dot { fill: var(--color-primary); stroke: none; }
  text { fill: var(--color-text-muted); font: 700 11px 'Manrope Variable', Manrope, sans-serif; letter-spacing: 0.1em; }
  /* Level 1: Core Node */
  .node.core circle { fill: rgba(36, 87, 255, 0.1); stroke: var(--color-cyan); stroke-width: var(--visual-line-active); filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.45)); }
  .node.core .dot { fill: var(--color-cyan); }
  :global(.visual-band--dark) text { fill: rgba(255, 255, 255, 0.72); }
  :global(.visual-band--dark) .node circle { fill: #0b1833; }
  .visual-system--web .node circle { rx: 12; }
  .visual-system--audit .node circle { fill: none; stroke-dasharray: 3 6; }
  .visual-system--editorial .grid { opacity: 0.45; }
  @media (max-width: 680px) {
    .visual-system, svg { min-height: 240px; }
    text { font-size: 9px; }
  }
</style>
