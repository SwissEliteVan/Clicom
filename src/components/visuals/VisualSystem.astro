---
interface Props{type:'web'|'seo'|'geo'|'ads'|'automation'|'services'|'audit'|'editorial'}
const{type}=Astro.props;
const data={seo:['PAGES','CRAWL','INDEX','POSITION','CONVERSION'],ads:['RECHERCHE','ANNONCE','LANDING','CONVERSION','OPTIMISATION'],automation:['TRIGGER','TRAITEMENT','DÉCISION','ACTION'],services:['ACQUISITION','CRÉATION','TECHNOLOGIE'],audit:['SITE','SEO','ADS','SOCIAL','IA','CONVERSION'],editorial:['SIGNAL','ANALYSE','DÉCISION'],geo:['CONTENU','ENTITÉS','CONTEXTE','MOTEURS','RÉPONSE'],web:['DESKTOP','TABLETTE','MOBILE']}[type];
const count=data.length;const points=Array.from({length:count},(_,i)=>{const x=90+i*(720/Math.max(1,count-1));const y=type==='geo'?180+Math.sin(i*1.8)*82:type==='services'?180+(i===1?-85:50):type==='audit'?180+Math.sin(i*1.7)*100:180+Math.sin(i*1.35)*50;return[x,y]});const route=points.map((p,i)=>`${i?'L':'M'}${p[0]} ${p[1]}`).join(' ');
---
<div class:list={['visual-system',`visual-system--${type}`]} data-visual-motion aria-hidden="true"><svg viewBox="0 0 900 380"><defs><linearGradient id={`vs-${type}`}><stop stop-color="#2457FF"/><stop offset="1" stop-color="#22D3EE"/></linearGradient></defs><g class="grid"><path d="M40 80H860M40 180H860M40 280H860"/><path d="M120 35V335M340 35V335M560 35V335M780 35V335"/></g><path class="ghost" d={route}/><path class="route" data-visual-path d={route} stroke={`url(#vs-${type})`}/>{points.map(([x,y],i)=><g class:list={['node',{'core':i===Math.floor(count/2)}]} data-visual-node><circle cx={x} cy={y} r={type==='audit'?48:i===Math.floor(count/2)?34:22}/><circle class="dot" cx={x} cy={y} r="4"/><text x={x} y={y+58} text-anchor="middle">{data[i]}</text></g>)}</svg></div>
<script>import '../../scripts/visuals/svg-motion';</script>
<style>.visual-system,svg{width:100%;min-height:330px}svg{display:block;height:100%}.grid path{fill:none;stroke:rgba(36,87,255,.07)}.ghost,.route{fill:none;stroke:rgba(36,87,255,.18);stroke-width:1.4}.route{stroke-width:2.3;stroke-linecap:round}.node circle{fill:rgba(255,255,255,.92);stroke:rgba(36,87,255,.3)}.node.core circle{fill:rgba(36,87,255,.13);stroke:#22D3EE;filter:drop-shadow(0 0 13px rgba(34,211,238,.5))}.node .dot{fill:#2457FF;stroke:none}.node.core .dot{fill:#22D3EE}text{fill:#58657a;font:700 11px Manrope,sans-serif;letter-spacing:.1em}:global(.visual-band--dark) text{fill:rgba(255,255,255,.7)}:global(.visual-band--dark) .node circle{fill:#0b1833}.visual-system--web .node circle{rx:12}.visual-system--audit .node circle{fill:none;stroke-dasharray:3 6}.visual-system--editorial .grid{opacity:.55}@media(max-width:680px){.visual-system,svg{min-height:240px}text{font-size:9px}}</style>
