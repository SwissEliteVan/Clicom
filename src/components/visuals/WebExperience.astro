---
import FlowVisual from './FlowVisual.astro';
---
<div class="web-experience"><FlowVisual kind="seo" labels={['DESKTOP','TABLETTE','MOBILE']} /></div>
<style>.web-experience{width:100%;transform:perspective(900px) rotateX(3deg);transform-origin:center}.web-experience :global(.flow-node:nth-of-type(2)){transform:scale(.84)}.web-experience :global(.flow-node:nth-of-type(3)){transform:scale(.68)}</style>
