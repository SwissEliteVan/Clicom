---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConversionHub from '../components/conversion/ConversionHub.astro';

const gtmId = import.meta.env.PUBLIC_GTM_ID ?? '';

interface Props {
  title?: string;
  description?: string;
  canonical?: string | URL;
  ogImage?: string | URL;
  noindex?: boolean;
  noindexFollow?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Clicom — Agence numérique suisse orientée croissance',
  description: descriptionProp,
  canonical: canonicalProp,
  ogImage = '/og-clicom.png',
  noindex = false,
  noindexFollow = false,
  structuredData,
} = Astro.props;

const descriptions: Record<string, string> = {
  '/': 'CLICOM accompagne les entreprises suisses avec des sites web performants, du SEO, des campagnes Ads et des solutions d’automatisation par l’IA.',
  '/services': 'Sites web, SEO, visibilité dans les moteurs IA, publicité, contenu et automatisation : les expertises CLICOM au service de votre croissance.',
  '/solutions': 'CLICOM relie automatisation, CRM, acquisition et socle web pour créer des systèmes numériques fiables, adaptés à vos objectifs commerciaux.',
  '/realisations': 'Découvrez l’approche CLICOM pour concevoir des projets numériques qui relient visibilité, acquisition, conversion et efficacité opérationnelle.',
  '/agence': 'CLICOM réunit stratégie, création, technologie et acquisition pour aider les entreprises suisses à construire une croissance en ligne plus lisible.',
  '/ressources': 'Des ressources CLICOM pour mieux cadrer votre visibilité, votre acquisition en ligne et les automatisations utiles à votre organisation.',
  '/contact': 'Contactez CLICOM pour échanger sur votre site web, votre visibilité, vos campagnes ou vos automatisations et demander un premier audit numérique.',
};
const routeKey = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const description = descriptions[routeKey] ?? descriptionProp ?? 'CLICOM accompagne les entreprises avec des solutions numériques conçues pour attirer, convertir, automatiser et accélérer leur croissance.';
const siteOrigin = Astro.site ?? Astro.url.origin;
const pathname = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/$/, '')}/`;
const canonical = canonicalProp ? new URL(canonicalProp, siteOrigin) : new URL(pathname, siteOrigin);
const socialImage = new URL(ogImage, siteOrigin);
const robots = noindexFollow ? 'noindex,follow' : noindex ? 'noindex,nofollow' : 'index,follow';
---

<!doctype html>
<html lang="fr-CH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CH" />
    <meta property="og:site_name" content="CLICOM" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CLICOM — Agence numérique suisse" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="theme-color" content="#F7F9FC" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
<body class:list={{ 'home-page': Astro.url.pathname === '/' }}>
  {gtmId && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>}
  <a class="skip-link" href="#contenu">Aller au contenu</a>
  <Header />
  <main id="contenu"><slot /></main>
  <Footer />
  <ConversionHub />
</body>
</html>
