<style>.audit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3)}.audit-grid article>span{display:block;margin-bottom:28px;color:var(--color-primary);font-size:.75rem;font-weight:780}.audit-value{background:var(--color-primary-soft)}.value-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(44px,8vw,100px);align-items:center}.value-grid ul{display:grid;gap:0;margin:0;padding:0;border-top:1px solid rgba(36,87,255,.18);list-style:none}.value-grid li{display:flex;gap:14px;padding:17px 0;border-bottom:1px solid rgba(36,87,255,.18);font-weight:650}.value-grid li span{color:var(--color-primary)}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3)}.steps article{padding:30px;border:1px solid var(--color-dark-border);border-radius:var(--radius-card);background:rgba(255,255,255,.05)}.steps article>span{color:var(--color-cyan);font-size:.75rem;font-weight:780}.steps h3{margin-top:34px}.audit-form{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(50px,8vw,110px)}.form-intro{display:grid;gap:3px;padding-bottom:20px;border-bottom:1px solid var(--color-border)}.form-intro strong{font-size:1.15rem}.form-intro span{color:var(--color-text-muted);font-size:.8rem}.trust{display:flex;flex-wrap:wrap;gap:8px;margin-block:26px}.trust span{padding:7px 10px;border:1px solid var(--color-border);border-radius:999px;color:var(--color-text-muted);font-size:.76rem;font-weight:680}.calendly-option{padding:24px;margin-block:20px;border:1px solid var(--color-border);border-radius:var(--radius-card);background:white}.calendly-option h3{font-size:1.1rem;font-weight:720}.direct-contact{font-size:.94rem}.form-honeypot{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}.form-status{min-height:1.5em;margin:0;font-size:.9rem;font-weight:650}.form-status.is-success{color:#067647}.form-status.is-error{color:#b42318}.privacy{margin:0;font-size:.78rem}.privacy a{color:var(--color-primary);text-decoration:underline}@media(max-width:90