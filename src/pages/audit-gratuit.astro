---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import CalendlyButton from '../components/conversion/CalendlyButton.astro';
import AuditScanner from '../components/visuals/AuditScanner.astro';

const analyses=[['Site web','Clarté de l’offre, expérience mobile et performance.'],['SEO','Fondations techniques et visibilité organique.'],['Google Ads','Ciblage, messages et mesure des campagnes.'],['Réseaux sociaux','Positionnement, plateformes et régularité.'],['Conversion','Appels à l’action et points de friction.'],['IA & automatisation','Opportunités pragmatiques pour vos processus.']];
const deliverables=['Une lecture claire de votre présence en ligne','Les freins et opportunités prioritaires','Des pistes concrètes à exploiter vite','Une proposition de prochaines étapes'];
const steps=[['01','Vous partagez votre contexte','Objectif, offre et principal enjeu.'],['02','CLICOM analyse les leviers','Nous examinons vos points de contact clés.'],['03','Vous recevez votre audit','Une première lecture directement exploitable.']];
---
<Layout title="Audit numérique gratuit — CLICOM Suisse" description="Demandez un audit gratuit de votre site, SEO, Google, publicité, réseaux sociaux et opportunités IA avec CLICOM.">
  <PageHero eyebrow="Audit gratuit" title="Identifiez vos meilleurs leviers de <span class='gradient-text'>croissance en ligne.</span>" intro="Un audit gratuit et sans engagement : vous repartez avec des priorités concrètes avant d’investir." primary="#audit" primaryLabel="Demander mon audit →" secondary="/methode/" secondaryLabel="Notre méthode" />

  <section class="audit-diagnostic" aria-hidden="true"><div class="container"><div class="audit-diagnostic__media"><div class="audit-diagnostic__scanner"><AuditScanner /></div></div></div></section>

  <section class="section section--white"><div class="container"><div class="section-heading"><div class="eyebrow">Ce que nous analysons</div><h2>Six dimensions qui influencent votre <span class="accent">croissance.</span></h2><p>Une analyse ciblée sur les leviers pertinents pour votre situation, sans ajouter d’actions inutiles.</p></div><div class="audit-grid">{analyses.map(([title,text])=><article><span>{title}</span><p>{text}</p></article>)}</div></div></section>

  <section class="section audit-value"><div class="container"><div class="section-heading"><div class="eyebrow">Ce que vous recevez</div><h2>Une première lecture <span class="accent">directement exploitable.</span></h2></div><ul class="value-list">{deliverables.map(item=><li><span>→</span>{item}</li>)}</ul></div></section>

  <section class="section section--dark"><div class="container"><div class="section-heading"><div class="eyebrow">Comment ça se passe</div><h2>Un processus simple et <span class="gradient-text">transparent.</span></h2></div><div class="steps">{steps.map(([number,title,text])=><article><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

  <section class="section" id="audit"><div class="container audit-form"><div class="audit-form__intro"><div class="eyebrow">Votre demande</div><h2>Parlons de vos <span class="accent">objectifs.</span></h2><p>Indiquez votre priorité et, si possible, l’adresse de votre site pour un échange plus utile.</p><div class="trust"><span>Méthode claire</span><span>Priorités transparentes</span><span>Orienté résultats</span></div><div class='calendly-option'><h3>Réservez directement un créneau</h3><CalendlyButton mode='inline' label='Choisir un créneau de 30 min' variant='primary' /></div><p class='direct-contact'>Ou contactez-nous directement :<br/><a href="tel:+41788238950"><strong>+41 78 823 89 50</strong></a> · <a href="mailto:hello@clicom.ch"><strong>hello@clicom.ch</strong></a></p></div><form class="card form" action="/api/contact" method="post" data-contact-form><div class="form-intro"><strong>Demander un audit gratuit</strong><span>Les champs marqués sont nécessaires pour vous répondre.</span></div><div class="form-grid"><div class="field"><label for="nom">Nom *</label><input id="nom" name="nom" autocomplete="name" maxlength="100" required /></div><div class="field"><label for="entreprise">Entreprise</label><input id="entreprise" name="entreprise" autocomplete="organization" maxlength="120" /></div><div class="field"><label for="site">Site internet</label><input id="site" name="site" type="url" maxlength="300" placeholder="https://" /></div><div class="field"><label for="email">E-mail *</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required /></div><div class="field field--full"><label for="tel">Téléphone</label><input id="tel" name="telephone" type="tel" autocomplete="tel" maxlength="40" /></div><div class="field field--full"><label for="objectif">Votre objectif ou principal défi *</label><textarea id="objectif" name="objectif" minlength="10" maxlength="3000" placeholder="Décrivez brièvement votre priorité actuelle." required></textarea></div><div class="form-honeypot" aria-hidden="true"><label for="website">Ne pas remplir ce champ</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div></div><Button type="submit">Demander un audit gratuit →</Button><p class="form-status" data-form-status role="status" aria-live="polite"></p><p class="privacy">Vos informations sont utilisées uniquement pour étudier votre demande et vous répondre. <a href="/politique-de-confidentialite/">Politique de confidentialité</a>.</p></form></div></section>
</Layout>
<script>import '../scripts/contact-form';</script>
<style>
  .audit-diagnostic{padding-block:2rem 2.5rem;overflow:hidden;background:linear-gradient(180deg,var(--color-background),white)}
  .audit-diagnostic__media{position:relative;display:grid;min-height:300px;overflow:hidden;place-items:center;border:1px solid rgba(36,87,255,.12);border-radius:20px;background:radial-gradient(circle at 50% 48%,rgba(36,87,255,.18),transparent 42%),linear-gradient(145deg,#081126,#0b1833);box-shadow:var(--shadow-featured);isolation:isolate}
  .audit-diagnostic__media::after{position:absolute;inset:0;z-index:0;background-image:linear-gradient(rgba(34,211,238,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(34,211,238,.045) 1px,transparent 1px);background-size:32px 32px;mask-image:radial-gradient(circle at center,#000,transparent 76%);content:'';pointer-events:none}
  .audit-diagnostic__scanner{position:relative;z-index:1;width:96%;filter:drop-shadow(0 22px 46px rgba(0,0,0,.28))}
  .audit-diagnostic__scanner :global(svg){min-height:220px}
  .audit-grid{display:grid;grid-template-columns:1fr;gap:var(--space-3)}
  .audit-grid article{padding:22px;border:1px solid var(--color-border);border-radius:var(--radius-card);background:white}
  .audit-grid article>span{display:block;margin-bottom:10px;color:var(--color-primary);font-size:.72rem;font-weight:780;letter-spacing:.08em}
  .audit-value{background:var(--color-primary-soft)}
  .value-list{display:grid;gap:0;margin:0;padding:0;border-top:1px solid rgba(36,87,255,.18);list-style:none}
  .value-list li{display:flex;gap:12px;padding:15px 0;border-bottom:1px solid rgba(36,87,255,.18);font-weight:650;font-size:.95rem}
  .value-list li span{color:var(--color-primary);font-weight:780}
  .steps{display:grid;grid-template-columns:1fr;gap:var(--space-3)}
  .steps article{padding:24px;border:1px solid var(--color-dark-border);border-radius:var(--radius-card);background:rgba(255,255,255,.05)}
  .steps article>span{color:var(--color-cyan);font-size:.75rem;font-weight:780}
  .steps h3{margin-top:14px;font-size:1.05rem}
  .audit-form{display:grid;grid-template-columns:1fr;gap:36px}
  .form-intro{display:grid;gap:3px;padding-bottom:18px;border-bottom:1px solid var(--color-border)}
  .form-intro strong{font-size:1.15rem}
  .form-intro span{color:var(--color-text-muted);font-size:.8rem}
  .trust{display:flex;flex-wrap:wrap;gap:8px;margin-block:20px}
  .trust span{padding:7px 10px;border:1px solid var(--color-border);border-radius:999px;color:var(--color-text-muted);font-size:.74rem;font-weight:680}
  .calendly-option{padding:20px;margin-block:18px;border:1px solid var(--color-border);border-radius:var(--radius-card);background:white}
  .calendly-option h3{font-size:1.05rem;font-weight:720;margin-bottom:14px}
  .direct-contact{font-size:.92rem;margin-top:18px}
  .form-honeypot{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}
  .form-status{min-height:1.5em;margin:0;font-size:.9rem;font-weight:650}
  .form-status.is-success{color:#067647}
  .form-status.is-error{color:#b42318}
  .privacy{margin:0;font-size:.78rem}
  .privacy a{color:var(--color-primary);text-decoration:underline}
  @media(min-width:600px){.audit-grid{grid-template-columns:repeat(2,1fr)}.steps{grid-template-columns:repeat(3,1fr)}.audit-form{grid-template-columns:.8fr 1.2fr;gap:clamp(50px,8vw,110px)}}
  @media(min-width:680px){.audit-diagnostic{padding-block:clamp(2.5rem,5vw,4.5rem)}.audit-diagnostic__media{min-height:clamp(340px,40vw,520px);border-radius:var(--radius-surface)}.audit-diagnostic__scanner{width:min(86%,920px)}.audit-diagnostic__scanner :global(svg){min-height:280px}}
</style>