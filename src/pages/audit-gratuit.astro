---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
const analyses=[['Site','Clarté, expérience, performance et conversion.'],['SEO','Fondations techniques, visibilité et contenus.'],['Google','Présence organique, locale et publicitaire.'],['Publicité','Ciblage, messages, tracking et pages de destination.'],['Réseaux sociaux','Positionnement, formats et régularité.'],['Concurrence','Repères de marché et espaces de différenciation.'],['Opportunités IA','Usages pragmatiques pour la visibilité et les processus.']];
---
<Layout title="Audit digital gratuit — CLICOM Suisse" description="Demandez un audit gratuit de votre site, SEO, Google, publicité, réseaux sociaux, concurrence et opportunités IA avec CLICOM.">
  <PageHero eyebrow="Audit gratuit" title="Identifier vos meilleurs leviers de <span class='gradient-text'>croissance digitale.</span>" intro="Un premier regard structuré sur votre présence digitale pour clarifier les priorités et préparer un échange utile." primary="#audit" primaryLabel="Demander mon audit →" secondary="/methode/" secondaryLabel="Découvrir notre méthode" />
  <section class="section section--white"><div class="container"><div class="section-heading"><div class="eyebrow">Analyse</div><h2>Une lecture à <span class="accent">360°.</span></h2><p>Nous observons les points de contact qui influencent votre visibilité, votre conversion et votre capacité à accélérer.</p></div><div class="audit-grid">{analyses.map(([title,text],i)=><article class="card"><span>0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
  <section class="section" id="audit"><div class="container audit-form"><div><div class="eyebrow">Votre projet</div><h2>Commençons par le bon <span class="accent">diagnostic.</span></h2><p>Quelques informations suffisent pour préparer une première lecture de votre situation.</p><p><a href="tel:+41788238950"><strong>+41 78 823 89 50</strong></a><br/><a href="mailto:hello@clicom.ch"><strong>hello@clicom.ch</strong></a></p></div><form class="card form" action="/api/contact" method="post" data-contact-form><div class="form-grid"><div class="field"><label for="nom">Nom</label><input id="nom" name="nom" autocomplete="name" maxlength="100" required /></div><div class="field"><label for="entreprise">Entreprise</label><input id="entreprise" name="entreprise" autocomplete="organization" maxlength="120" /></div><div class="field"><label for="site">Site internet</label><input id="site" name="site" type="url" maxlength="300" /></div><div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required /></div><div class="field field--full"><label for="tel">Téléphone</label><input id="tel" name="telephone" type="tel" autocomplete="tel" maxlength="40" /></div><div class="field field--full"><label for="objectif">Objectif</label><textarea id="objectif" name="objectif" minlength="10" maxlength="3000" required></textarea></div><div class="form-honeypot" aria-hidden="true"><label for="website">Ne pas remplir ce champ</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div></div><Button type="submit">Recevoir mon audit →</Button><p class="form-status" data-form-status role="status" aria-live="polite"></p><p class="privacy">En envoyant ce formulaire, vous acceptez l’utilisation de vos informations pour répondre à votre demande. <a href="/politique-de-confidentialite/">Politique de confidentialité</a>.</p></form></div></section>
</Layout>
<script>import '../scripts/contact-form';</script>
<style>.audit-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-3)}.audit-grid article>span{display:block;margin-bottom:28px;color:var(--color-primary);font-size:.75rem;font-weight:780}.audit-form{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(50px,8vw,110px)}.form-honeypot{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}.form-status{min-height:1.5em;margin:0;font-size:.9rem;font-weight:650}.form-status.is-success{color:#067647}.form-status.is-error{color:#b42318}.privacy{margin:0;font-size:.78rem}.privacy a{color:var(--color-primary);text-decoration:underline}@media(max-width:900px){.audit-grid{grid-template-columns:repeat(2,1fr)}.audit-form{grid-template-columns:1fr}}@media(max-width:580px){.audit-grid{grid-template-columns:1fr}}</style>
