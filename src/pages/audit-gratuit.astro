---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import CalendlyButton from '../components/conversion/CalendlyButton.astro';
import AuditScanner from '../components/visuals/AuditScanner.astro';

const analyses=[['Site web','Clarté de l’offre, expérience mobile, performance et parcours.'],['SEO','Fondations techniques, visibilité organique et contenus prioritaires.'],['Google Ads','Ciblage, messages, mesure et cohérence des pages de destination.'],['Réseaux sociaux','Positionnement, choix des plateformes, formats et régularité.'],['Conversion','Appels à l’action, réassurance et points de friction avant la demande.'],['IA & automatisation','Opportunités pragmatiques pour la visibilité, les prospects et les processus.']];
const deliverables=['Une première lecture structurée de votre présence en ligne','Les principaux freins et opportunités observés','Des priorités adaptées à vos objectifs et à vos ressources','Des pistes concrètes à approfondir lors d’un échange'];
const steps=[['01','Vous présentez votre contexte','Objectif, offre, site actuel et principal enjeu.'],['02','CLICOM analyse les leviers','Nous examinons les points de contact pertinents pour votre situation.'],['03','Nous échangeons sur les priorités','Vous recevez une première lecture claire et les prochaines étapes possibles.']];
---
<Layout title="Audit numérique gratuit — CLICOM Suisse" description="Demandez un audit gratuit de votre site, SEO, Google, publicité, réseaux sociaux, concurrence et opportunités IA avec CLICOM.">
  <PageHero eyebrow="Audit gratuit" title="Identifier vos meilleurs leviers de <span class='gradient-text'>croissance en ligne.</span>" intro="Recevez une première analyse de votre présence en ligne pour comprendre les priorités avant d’investir davantage." primary="#audit" primaryLabel="Demander un audit gratuit →" secondary="/methode/" secondaryLabel="Découvrir notre méthode" />

  <section class="audit-diagnostic" aria-hidden="true"><div class="container"><div class="audit-diagnostic__media"><div class="audit-diagnostic__scanner"><AuditScanner /></div></div></div></section>

  <section class="section section--white"><div class="container"><div class="section-heading"><div class="eyebrow">Ce que nous analysons</div><h2>Six dimensions qui influencent votre <span class="accent">croissance.</span></h2><p>L’analyse se concentre sur les leviers pertinents pour votre situation. Elle ne cherche pas à ajouter des actions inutiles.</p></div><div class="audit-grid">{analyses.map(([title,text],i)=><article class="card"><span>0{i+1}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
  <section class="section audit-value"><div class="container value-grid"><div><div class="eyebrow">Ce que vous recevez</div><h2>Une première lecture <span class="accent">directement exploitable.</span></h2><p>Vous repartez avec des repères pour décider de la suite, sans promesse excessive ni recommandation standardisée.</p></div><ul>{deliverables.map(item=><li><span>→</span>{item}</li>)}</ul></div></section>
  <section class="section section--dark"><div class="container"><div class="section-heading"><div class="eyebrow">La suite</div><h2>Un processus simple et <span class="gradient-text">transparent.</span></h2></div><div class="steps">{steps.map(([number,title,text])=><article><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
  <section class="section" id="audit"><div class="container audit-form"><div><div class="eyebrow">Votre demande</div><h2>Parlons de vos <span class="accent">objectifs.</span></h2><p>Indiquez votre priorité et, si possible, l’adresse de votre site. Ces éléments nous permettent de préparer un échange plus utile.</p><div class="trust"><span>Méthode claire</span><span>Priorités transparentes</span><span>Approche orientée objectifs</span></div><div class="audit-direct-meeting"><strong>Vous préférez en parler directement ?</strong><p>Réservez directement un échange de 30 minutes sans formulaire préalable.</p><CalendlyButton label="Réserver un échange de 30 min →" variant="secondary" fallbackHref="/contact/" /></div><p class="direct-contact">Contact direct :<br/><a href="tel:+41788238950"><strong>078 823 89 50</strong></a><br/><a href="mailto:hello@clicom.ch"><strong>hello@clicom.ch</strong></a></p></div><form class="card form" action="/api/contact" method="post" data-contact-form><div class="form-intro"><strong>Demander un audit gratuit</strong><span>Les champs marqués sont nécessaires pour vous répondre.</span></div><div class="form-grid"><div class="field"><label for="nom">Nom *</label><input id="nom" name="nom" autocomplete="name" maxlength="100" required /></div><div class="field"><label for="entreprise">Entreprise</label><input id="entreprise" name="entreprise" autocomplete="organization" maxlength="120" /></div><div class="field"><label for="site">Site internet</label><input id="site" name="site" type="url" maxlength="300" placeholder="https://" /></div><div class="field"><label for="email">E-mail *</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required /></div><div class="field field--full"><label for="tel">Téléphone</label><input id="tel" name="telephone" type="tel" autocomplete="tel" maxlength="40" /></div><div class="field field--full"><label for="objectif">Votre objectif ou principal défi *</label><textarea id="objectif" name="objectif" minlength="10" maxlength="3000" placeholder="Décrivez brièvement votre priorité actuelle." required></textarea></div><div class="form-honeypot" aria-hidden="true"><label for="website">Ne pas remplir ce champ</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div></div><Button type="submit">Demander un audit gratuit →</Button><p class="form-status" data-form-status role="status" aria-live="polite"></p><p class="privacy">Vos informations sont utilisées uniquement pour étudier votre demande et vous répondre. <a href="/politique-de-confidentialite/">Politique de confidentialité</a>.</p></form></div></section>
</Layout>
<script>import '../scripts/contact-form';</script>
<style>
  .audit-diagnostic{padding-block:clamp(2.5rem,5vw,4.5rem);overflow:hidden;background:linear-gradient(180deg,var(--color-background),white)}
  .audit-diagnostic__media{position:relative;display:grid;min-height:clamp(340px,40vw,520px);overflow:hidden;place-items:center;border:1px solid rgba(36,87,255,.12);border-radius:var(--radius-surface);background:radial-gradient(circle at 50% 48%,rgba(36,87,255,.18),transparent 42%),linear-gradient(145deg,#081126,#0b1833);box-shadow:var(--shadow-featured);isolation:isolate}
  .audit-diagnostic__media::after{position:absolute;inset:0;z-index:0;background-image:linear-gradient(rgba(34,211,238,.045) 1px,transparent 1px),linear-gradient(90deg,rgba(34,211,238,.045) 1px,transparent 1px);background-size:32px 32px;mask-image:radial-gradient(circle at center,#000,transparent 76%);content:'';pointer-events:none}

  .audit-diagnostic__scanner{position:relative;z-index:1;width:min(86%,920px);filter:drop-shadow(0 22px 46px rgba(0,0,0,.28))}
  .audit-diagnostic__scanner :global(svg){min-height:280px}
  @media(max-width:680px){.audit-diagnostic{padding-block:2rem 3.5rem}.audit-diagnostic__media{min-height:320px;border-radius:20px}.audit-diagnostic__scanner{width:96%}.audit-diagnostic__scanner :global(svg){min-height:220px}}
</style>
<style>.audit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3)}.audit-grid article>span{display:block;margin-bottom:28px;color:var(--color-primary);font-size:.75rem;font-weight:780}.audit-value{background:var(--color-primary-soft)}.value-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(44px,8vw,100px);align-items:center}.value-grid ul{display:grid;gap:0;margin:0;padding:0;border-top:1px solid rgba(36,87,255,.18);list-style:none}.value-grid li{display:flex;gap:14px;padding:17px 0;border-bottom:1px solid rgba(36,87,255,.18);font-weight:650}.value-grid li span{color:var(--color-primary)}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-3)}.steps article{padding:30px;border:1px solid var(--color-dark-border);border-radius:var(--radius-card);background:rgba(255,255,255,.05)}.steps article>span{color:var(--color-cyan);font-size:.75rem;font-weight:780}.steps h3{margin-top:34px}.audit-form{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(50px,8vw,110px)}.form-intro{display:grid;gap:3px;padding-bottom:20px;border-bottom:1px solid var(--color-border)}.form-intro strong{font-size:1.15rem}.form-intro span{color:var(--color-text-muted);font-size:.8rem}.trust{display:flex;flex-wrap:wrap;gap:8px;margin-block:26px}.trust span{padding:7px 10px;border:1px solid var(--color-border);border-radius:999px;color:var(--color-text-muted);font-size:.76rem;font-weight:680}.audit-direct-meeting{margin-block:20px;padding:16px 18px;border-left:3px solid var(--color-primary);background:var(--color-primary-soft);border-radius:0 8px 8px 0}.audit-direct-meeting strong{display:block;margin-bottom:4px;font-size:.92rem;color:var(--color-midnight)}.audit-direct-meeting p{margin:0 0 12px;font-size:.85rem;color:var(--color-text-muted)}.audit-direct-meeting :global(.button){font-size:.82rem;padding:8px 14px}.direct-contact{font-size:.94rem}.form-honeypot{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}.form-status{min-height:1.5em;margin:0;font-size:.9rem;font-weight:650}.form-status.is-success{color:#067647}.form-status.is-error{color:#b42318}.privacy{margin:0;font-size:.78rem}.privacy a{color:var(--color-primary);text-decoration:underline}@media(max-width:900px){.audit-grid{grid-template-columns:repeat(2,1fr)}.value-grid,.audit-form{grid-template-columns:1fr}}@media(max-width:680px){.steps{grid-template-columns:1fr}}@media(max-width:580px){.audit-grid{grid-template-columns:1fr}.form>.button{width:100%}}</style>
