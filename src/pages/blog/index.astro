---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import blogImage from '../../assets/editorial/blog-editorial.webp';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Blog ingénierie & marketing digital — CLICOM Suisse"
  description="Analyses, repères et retours d’expérience pour piloter la stratégie numérique de votre entreprise en Suisse romande."
>
  <PageHero
    eyebrow="Publication & Analyses"
    title="Des repères pour décider avec plus de clarté."
    intro="SEO, acquisition, automatisation, conception web et conversion : des analyses conçues pour passer des questions aux décisions utiles."
    primary="/audit-gratuit/"
    primaryLabel="Demander un audit →"
    secondary="/ressources/"
    secondaryLabel="Voir les ressources"
    showBand={false}
  />

  <section class="blog-cover" aria-hidden="true">
    <div class="container">
      <div class="blog-cover__frame">
        <img src={blogImage.src} alt="" width={blogImage.width} height={blogImage.height} loading="eager" fetchpriority="high" decoding="async" />
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">Dossiers &amp; Articles</div>
        <h2>Comprendre avant d’accélérer.</h2>
      </div>

      <div class="blog-stream">
        {posts.map((post, idx) => (
          <article class:list={['blog-entry', { 'blog-entry--featured': idx === 0 }]}>
            <div class="blog-entry__meta">
              <span class="blog-entry__cat">{post.data.category}</span>
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('fr-CH', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
            </div>
            <h3>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            <p>{post.data.description}</p>
            <a class="text-link" href={`/blog/${post.id}/`}>
              Lire l’article <span>→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CTA href="/audit-gratuit/" title="Besoin d’une lecture adaptée à votre entreprise ?" />
</Layout>

<style>
  .blog-cover {
    padding-top: var(--space-4);
    background: #ffffff;
  }
  .blog-cover__frame {
    position: relative;
    width: 100%;
    height: clamp(300px, 35vw, 460px);
    overflow: hidden;
    border-radius: var(--radius-surface);
    border: 1px solid var(--color-border);
  }
  .blog-cover__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .blog-stream {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(36px, 5vw, 64px) clamp(28px, 4vw, 56px);
  }
  .blog-entry {
    display: flex;
    flex-direction: column;
    padding-top: 24px;
    border-top: 1px solid var(--color-border-strong);
  }
  .blog-entry--featured {
    grid-column: 1 / -1;
    padding-top: 32px;
  }
  .blog-entry--featured h3 {
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    max-width: 26ch;
  }
  .blog-entry--featured p {
    font-size: 1.125rem;
    max-width: 65ch;
  }
  .blog-entry__meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 12px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .blog-entry__cat {
    color: var(--color-primary);
  }
  .blog-entry h3 {
    margin: 0 0 12px;
    font-size: clamp(1.4rem, 2vw, 1.75rem);
    line-height: 1.2;
    color: var(--color-midnight);
  }
  .blog-entry h3 a {
    color: inherit;
    transition: color var(--transition-fast);
  }
  .blog-entry h3 a:hover {
    color: var(--color-primary);
  }
  .blog-entry p {
    margin: 0 0 16px;
    font-size: 0.96rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .blog-entry .text-link {
    margin-top: auto;
  }

  @media (max-width: 760px) {
    .blog-stream {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
