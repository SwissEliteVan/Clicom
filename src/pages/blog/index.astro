---
import { getCollection } from 'astro:content';import Layout from '../../layouts/Layout.astro';import PageHero from '../../components/PageHero.astro';import CTA from '../../components/CTA.astro';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Layout title="Blog marketing digital — CLICOM Suisse" description="Guides et analyses CLICOM sur le SEO, Google Ads, le référencement IA, les sites web et la conversion."><PageHero eyebrow="Blog" title="Des repères pour décider avec <span class='gradient-text'>plus de clarté.</span>" intro="SEO, publicité, IA, sites web et conversion : des articles conçus pour passer des questions aux actions utiles." primary="/audit-gratuit/" primaryLabel="Demander un audit →" secondary="/ressources/" secondaryLabel="Voir les ressources"/><section class="section section--white"><div class="container"><div class="section-heading"><div class="eyebrow">Articles</div><h2>Comprendre avant <span class="accent">d’accélérer.</span></h2></div><div class="post-grid">{posts.map(post=><article class="card card--interactive"><div class="post-meta"><span>{post.data.category}</span><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('fr-CH',{day:'numeric',month:'short',year:'numeric'})}</time></div><h2>{post.data.title}</h2><p>{post.data.description}</p><a class="text-link" href={`/blog/${post.id}/`}>Lire l’article <span>→</span></a></article>)}</div></div></section><CTA href="/audit-gratuit/" title="Besoin d’une lecture adaptée à votre entreprise ?"/></Layout>
<style>.post-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-3)}.post-grid article{isolation:isolate}.post-grid article:first-child{grid-column:1/-1;background:linear-gradient(145deg,#fff,var(--color-primary-soft))}.post-grid h2{font-size:clamp(1.65rem,2.5vw,2.35rem);transition:color var(--transition-fast)}.post-meta{display:flex;justify-content:space-between;gap:20px;margin-bottom:30px;color:var(--color-text-muted);font-size:.75rem;font-weight:720;text-transform:uppercase;letter-spacing:.08em}.post-meta span{color:var(--color-primary)}@media(hover:hover) and (pointer:fine){.post-grid article:hover h2{color:var(--color-primary-dark)}}@media(max-width:700px){.post-grid{grid-template-columns:1fr}.post-grid article:first-child{grid-column:auto}}</style>
