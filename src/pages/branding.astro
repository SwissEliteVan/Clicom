---
import CommercialPage from '../components/CommercialPage.astro';
const problems=[{title:'Une marque difficile à distinguer',text:'Le positionnement et les messages ressemblent trop aux alternatives du marché.'},{title:'Une identité incohérente',text:'Les supports utilisent des codes, des tons et des niveaux de qualité différents.'},{title:'Une évolution mal accompagnée',text:'L’entreprise a changé, mais son identité ne raconte plus son ambition.'}];
const services=[{title:'Positionnement',text:'Territoire, différence, audiences, promesse et preuves.'},{title:'Logo',text:'Signe identifiable et déclinaisons adaptées aux usages utiles.'},{title:'Identité visuelle',text:'Système graphique cohérent au-delà du seul logo.'},{title:'Charte de marque',text:'Règles d’utilisation pour maintenir la cohérence dans le temps.'},{title:'Couleurs & typographie',text:'Choix lisibles, distinctifs et adaptés aux supports.'},{title:'Tone of voice',text:'Principes éditoriaux pour faire reconnaître la marque dans ses messages.'}];
const process=[{title:'Comprendre',text:'Explorer vision, marché et perceptions.'},{title:'Positionner',text:'Clarifier différence et promesse.'},{title:'Créer',text:'Concevoir l’identité et ses règles.'},{title:'Déployer',text:'Adapter la marque aux supports prioritaires.'}];
const faq=[{question:'Une identité visuelle se limite-t-elle au logo ?',answer:'Non. Elle comprend aussi couleurs, typographies, compositions, iconographie et règles de cohérence.'},{question:'Pouvez-vous faire évoluer une marque existante ?',answer:'Oui. L’évolution peut être progressive ou structurante selon les acquis et le repositionnement attendu.'},{question:'Le branding inclut-il les textes ?',answer:'Le positionnement, les messages clés et le tone of voice peuvent faire partie du périmètre.'}];
---
<CommercialPage title="Branding et identité visuelle — CLICOM Suisse" description="Positionnement, logo, identité visuelle, charte, couleurs, typographie et tone of voice pour une marque cohérente." eyebrow="Branding" h1="Donner à votre ambition une marque <span class='gradient-text'>claire et reconnaissable.</span>" intro="CLICOM relie positionnement, identité et langage pour construire une marque capable de soutenir votre croissance." {problems} solution="Nous clarifions ce que la marque doit exprimer, puis construisons un système visuel et éditorial cohérent sur les supports prioritaires." {services} {process} benefits={['Un positionnement plus facile à comprendre','Une identité distinctive et cohérente','Des règles utilisables par vos équipes','Des supports alignés sur une même marque','Une base solide pour le site et les campagnes']} {faq} links={[{href:'/creation-site-web/',label:'Création de site web'},{href:'/creation-contenu/',label:'Contenu'},{href:'/reseaux-sociaux/',label:'Réseaux sociaux'}]} />
