---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
---

<Layout title="Contact & audit gratuit — Clicom">
  <PageHero eyebrow="Contact" title="Parlons de votre prochain <span class='gradient-text'>accélérateur.</span>" intro="Expliquez-nous votre objectif. Nous reviendrons vers vous avec une première lecture claire." />
  <section class="section section--white" id="audit">
    <div class="container contact">
      <div>
        <div class="eyebrow">Audit gratuit</div>
        <h2>Commençons par le bon <span class="accent">diagnostic.</span></h2>
        <p>Quelques informations suffisent pour préparer un échange utile.</p>
        <p><a href="tel:+41788238950"><strong>078 823 89 50</strong></a><br /><a href="mailto:hello@clicom.ch"><strong>hello@clicom.ch</strong></a></p>
        <div class="motif">●────→</div>
      </div>
      <form class="card form" action="mailto:hello@clicom.ch" method="post" enctype="text/plain">
        <div class="form-grid">
          <div class="field"><label for="nom">Nom</label><input id="nom" name="Nom" autocomplete="name" required /></div>
          <div class="field"><label for="entreprise">Entreprise</label><input id="entreprise" name="Entreprise" autocomplete="organization" /></div>
          <div class="field"><label for="site">Site internet</label><input id="site" name="Site" type="url" /></div>
          <div class="field"><label for="email">Email</label><input id="email" name="Email" type="email" autocomplete="email" required /></div>
          <div class="field field--full"><label for="tel">Téléphone</label><input id="tel" name="Téléphone" type="tel" autocomplete="tel" /></div>
          <div class="field field--full"><label for="objectif">Objectif</label><textarea id="objectif" name="Objectif" required></textarea></div>
        </div>
        <Button type="submit">Recevoir mon audit →</Button>
      </form>
    </div>
  </section>
</Layout>

<style>
  .contact { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(50px, 8vw, 110px); }
  .form > .button { justify-self: start; }
  @media (max-width: 850px) { .contact { grid-template-columns: 1fr; } .form > .button { width: 100%; } }
</style>
