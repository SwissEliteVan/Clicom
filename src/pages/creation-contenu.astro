  solution="Produire davantage n’est pas un objectif en soi. Le contenu doit rendre votre offre plus compréhensible, renforcer la confiance et faciliter la suite du parcours."
  {services}
  {process}
  benefits={[
    'Des messages plus clairs pour les prospects comme pour les équipes',
    'Des contenus reliés aux offres, aux recherches et aux campagnes',
    'Une production mieux réutilisée sur les canaux pertinents',
    'Un rythme éditorial compatible avec vos ressources',
    'Des choix guidés par le rôle de chaque contenu, pas par le volume',
  ]}
