---
import CommercialPage from '../components/CommercialPage.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://clicom.ch/creation-contenu/#service',
      name: 'Création de contenu stratégique pour PME en Suisse',
      provider: {
        '@type': 'Organization',
        name: 'CLICOM',
        url: 'https://clicom.ch/',
      },
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Suisse romande',
      },
      description: 'Rédaction de pages d’offres, articles SEO, guides d’autorité et argumentaires de vente pour PME en Suisse romande.',
      serviceType: 'Création de contenu stratégique',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://clicom.ch/creation-contenu/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://clicom.ch/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://clicom.ch/services' },
        { '@type': 'ListItem', position: 3, name: 'Création de contenu', item: 'https://clicom.ch/creation-contenu/' },
      ],
    },
  ],
};

const problems = [
  {
    title: 'Une expertise réelle mais difficile à exprimer avec clarté',
    text: 'Vos prestations sont d’excellente qualité, mais vos textes sont trop techniques ou confus pour un décideur non spécialiste en phase de choix.',
  },
  {
    title: 'Des contenus qui décrivent sans donner envie d’agir',
    text: 'Beaucoup de texte pour peu d’impact, sans hiérarchie des bénéfices client, sans preuves concrètes ni appels à l’action incitatifs.',
  },
  {
    title: 'Une production dispersée et jamais réutilisée',
    text: 'Réécrire séparément pour le site, les e-mails et les réseaux sociaux sans ligne directrice commune fait perdre du temps et affaiblit le message.',
  },
];

const services = [
  { title: 'Pages d’offres & Landing pages de conversion', text: 'Structurer vos propositions commerciales avec des arguments limpides, des preuves rassurantes et des boutons d’action visibles.' },
  { title: 'Articles d’autorité & Contenus SEO', text: 'Répondre précisément aux questions et intentions de recherche de vos futurs clients pour capter du trafic qualifié sur Google.' },
  { title: 'Études de cas & Récits de réalisations', text: 'Mettre en valeur vos réussites et résultats concrets en Suisse romande pour lever les hésitations avant la prise de contact.' },
  { title: 'Contenus professionnels pour réseaux sociaux', text: 'Décliner votre expertise en publications régulières sur LinkedIn pour maintenir votre notoriété auprès de votre réseau.' },
  { title: 'Séquences d’e-mails & Messages de relance', text: 'Rédiger des messages bienveillants et pertinents pour accompagner les prospects après l’envoi d’un devis.' },
  { title: 'Gabarits & Argumentaires pour vos équipes', text: 'Fournir à vos collaborateurs des trames de présentation et des réponses types pour homogénéiser vos échanges commerciaux.' },
];

const process = [
  { title: 'Cadrer', text: 'Identifier les questions fréquentes, les critères de décision et les freins de vos clients cibles.' },
  { title: 'Hiérarchiser', text: 'Sélectionner les sujets et formats qui soutiennent directement vos objectifs d’acquisition et de vente.' },
  { title: 'Rédiger', text: 'Écrire avec un ton professionnel, direct, accessible et débarrassé de tout jargon creux.' },
  { title: 'Optimiser', text: 'Intégrer les mots-clés stratégiques, le balisage sémantique et les déclencheurs de conversion.' },
  { title: 'Décliner', text: 'Réutiliser les messages clés sur votre site web, vos campagnes publicitaires et vos e-mails de suivi.' },
];

const decisionGuide = {
  eyebrow: 'Intégration au système',
  title: 'Le contenu comme carburant du système digital CliCom.',
  intro: 'Un bon contenu n’a pas besoin de tout dire : il doit jouer un rôle précis dans le parcours de vos prospects.',
  items: [
    { title: 'Alimente la Présence', text: 'Rend vos pages web convaincantes, agréables à lire et rassurantes dès les premières secondes de visite.' },
    { title: 'Génère l’Acquisition', text: 'Positionne votre entreprise comme référence sur Google (SEO) en répondant aux vraies interrogations du marché.' },
    { title: 'Soutient l’Automatisation', text: 'Fournit les textes des e-mails, devis et alertes transmis automatiquement à vos prospects et clients.' },
  ],
};

const faq = [
  {
    question: 'Comment travaillez-vous avec nos équipes internes pour rédiger ?',
    answer: 'Nous réalisons des entretiens courts avec vos experts métier pour capter votre valeur, vos anecdotes et vos arguments réels, puis nous nous chargeons de la mise en forme éditoriale et de l’optimisation.',
  },
  {
    question: 'Les contenus sont-ils optimisés pour le référencement naturel (SEO) ?',
    answer: 'Oui. Chaque contenu destiné au web est structuré autour des intentions de recherche réelles de votre cible, tout en préservant une lecture naturelle et agréable pour les humains.',
  },
  {
    question: 'Pouvez-vous reprendre et améliorer des textes existants ?',
    answer: 'Tout à fait. Un audit éditorial permet d’identifier les pages existantes à clarifier, enrichir ou réorganiser pour maximiser leur impact commercial sans tout réécrire de zéro.',
  },
  {
    question: 'Quelle est la fréquence de publication recommandée ?',
    answer: 'Nous privilégions toujours la régularité et la pertinence par rapport au volume. Un rythme tenable (par exemple 1 à 2 contenus stratégiques par mois) apporte de bien meilleurs résultats qu’une surproduction discontinue.',
  },
];
---

<CommercialPage
  title="Création de contenu stratégique pour PME | CLICOM Suisse"
  description="Rédaction de pages d’offres, articles SEO, guides et contenus commerciaux pour PME en Suisse romande. Des contenus clairs pour expliquer, convaincre et convertir."
  pillarTag="Pilier 01 / 02 · Présence & Acquisition"
  eyebrow="Création de contenu"
  h1="Des contenus clairs qui aident vos prospects à <span class='gradient-text'>comprendre, comparer et décider.</span>"
  intro="CliCom transforme votre savoir-faire technique en argumentaires limpides et percutants pour votre site web, votre référencement naturel et vos campagnes d’acquisition."
  {problems}
  solution="Produire du volume n’est pas un objectif en soi. Chaque contenu doit avoir un rôle précis dans votre système commercial : éclairer une question, lever une objection et faciliter la prise de contact."
  {services}
  {process}
  benefits={[
    'Une proposition de valeur claire qui met en valeur votre savoir-faire',
    'Des pages d’offres structurées pour transformer les visites en contacts',
    'Un meilleur positionnement sur les recherches clés de votre secteur',
    'Des argumentaires réutilisables par l’ensemble de vos équipes',
    'Un gain de temps significatif sur la production de vos supports',
  ]}
  {faq}
  links={[
    { href: '/services/', label: 'Le système complet CliCom' },
    { href: '/creation-site-web/', label: 'Création de site web' },
    { href: '/seo/', label: 'Référencement naturel' },
    { href: '/social-ads/', label: 'Publicité Social Ads' },
  ]}
  problemEyebrow="Pourquoi le contenu compte"
  problemsTitle="Un bon contenu réduit l’effort nécessaire pour faire confiance et choisir."
  offerTitle="Construire un socle éditorial au service de vos objectifs commerciaux."
  processTitle="De votre expertise brute à des formats utiles sur les bons canaux."
  benefitsTitle="Une prise de parole plus cohérente et plus rentable pour votre PME."
  faqTitle="Les questions utiles avant d’organiser votre production de contenu."
  {decisionGuide}
  heroPrimaryLabel="Parler de votre stratégie éditoriale"
  heroSecondary="#approach"
  heroSecondaryLabel="Voir les formats possibles"
  heroPrimaryCalendly={true}
  ctaTitle="Donnez un rôle plus clair et rentable à vos contenus."
  ctaText="Réservez un échange de 30 minutes pour identifier les pages et messages qui peuvent mieux soutenir vos offres et votre visibilité en Suisse romande."
  ctaLabel="Réserver un échange gratuit de 30 minutes"
  ctaCalendly={true}
  {structuredData}
/>
