---
import CommercialPage from '../components/CommercialPage.astro';
import webImage from '../assets/editorial/creation-site-web-responsive-suisse.webp';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://clicom.ch/creation-site-web/#service',
      name: 'Création de site web pour PME en Suisse romande',
      provider: {
        '@type': 'Organization',
        name: 'CLICOM',
        url: 'https://clicom.ch/',
      },
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Suisse romande',
      },
      description: 'Conception et développement de sites web ultra-rapides, ergonomiques et orientés conversion pour les PME en Suisse romande.',
      serviceType: 'Création de sites web',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://clicom.ch/creation-site-web/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://clicom.ch/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://clicom.ch/services' },
        { '@type': 'ListItem', position: 3, name: 'Création de site web', item: 'https://clicom.ch/creation-site-web/' },
      ],
    },
  ],
};

const problems = [
  {
    title: 'Un site esthétique mais difficile à utiliser pour décider',
    text: 'Le design attire le regard, sans expliquer assez vite votre différence, vos preuves ou la démarche à suivre pour demander un devis.',
  },
  {
    title: 'Des parcours mobiles et des messages confus',
    text: 'Les offres sont mal hiérarchisées, le temps de chargement décourage les prospects et les formulaires créent des frictions inutiles.',
  },
  {
    title: 'Une base technique fermée qui bloque l’évolution',
    text: 'Lenteur, maintenance complexe, SEO technique incomplet ou absence de tracking empêchent de relier le site à votre CRM et à vos campagnes.',
  },
];

const services = [
  { title: 'Cadrage stratégique & Arborescence', text: 'Clarifier vos offres prioritaires, vos cibles en Suisse romande et les parcours de décision avant de dessiner.' },
  { title: 'UX & Rédaction persuasive', text: 'Organiser les argumentaires, preuves et appels à l’action pour réduire l’effort de compréhension des visiteurs.' },
  { title: 'Design responsive sur-mesure', text: 'Concevoir une interface élégante et crédible, pensée en priorité pour l’expérience mobile et tablette.' },
  { title: 'Développement Astro haute performance', text: 'Mettre en œuvre un socle moderne, sécurisé et ultra-rapide, sans dépendance lourde ni surcoût caché.' },
  { title: 'SEO technique & Balisage sémantique', text: 'Intégrer vitesse, structure de données, balisage Schema.org et bonnes pratiques d’indexation dès la conception.' },
  { title: 'Formulaires & Connexion CRM', text: 'Relier chaque prise de contact à votre outil de suivi commercial pour un traitement immédiat et mesurable.' },
];

const process = [
  { title: 'Comprendre', text: 'Cadrer vos offres, vos clients idéaux, vos contenus disponibles et vos contraintes techniques métier.' },
  { title: 'Structurer', text: 'Définir l’arborescence, les parcours de conversion et la hiérarchie des messages clés.' },
  { title: 'Concevoir', text: 'Traduire votre positionnement en interfaces claires, crédibles et parfaitement adaptées à chaque écran.' },
  { title: 'Développer', text: 'Intégrer le site sur un moteur moderne, brancher les formulaires et configurer les outils de mesure.' },
  { title: 'Lancer & Suivre', text: 'Tester, sécuriser la mise en ligne, vérifier le tracking et planifier les améliorations continues.' },
];

const decisionGuide = {
  eyebrow: 'Intégration au système',
  title: 'Comment votre site s’intègre dans le système digital CliCom.',
  intro: 'Un site web efficace ne vit pas isolé : il est le socle sur lequel s’appuient votre acquisition et vos flux de suivi.',
  items: [
    { title: 'Socle de l’Acquisition', text: 'Vos campagnes Google Ads et votre référencement naturel mènent vers des pages optimisées pour convertir le trafic en opportunités.' },
    { title: 'Déclencheur de l’Automatisation', text: 'Chaque formulaire soumis transmet instantanément les données qualifiées dans votre CRM et alerte la bonne personne.' },
    { title: 'Mesure de la Performance', text: 'Les prises de contact sont trackées avec rigueur pour évaluer la rentabilité réelle de vos investissements digitaux.' },
  ],
};

const faq = [
  {
    question: 'Combien coûte la création ou la refonte d’un site web pour une PME ?',
    answer: 'Le budget dépend du périmètre, du nombre de pages, de la complexité des intégrations et du niveau d’accompagnement éditorial. Nous cadrons ces éléments ensemble avant de proposer une proposition transparente et détaillée.',
  },
  {
    question: 'Combien de temps faut-il pour créer un site internet ?',
    answer: 'Le calendrier dépend du périmètre, de la disponibilité des contenus et des validations. Un planning réaliste avec des jalons précis est défini dès la phase de cadrage.',
  },
  {
    question: 'Puis-je conserver mon nom de domaine et mes adresses e-mails ?',
    answer: 'Oui. La conservation de votre domaine et la continuité de votre messagerie sont systématiquement assurées et vérifiées dans notre plan de mise en ligne.',
  },
  {
    question: 'Qui possède le site après sa mise en ligne ?',
    answer: 'Vous êtes 100 % propriétaire de votre site web, de son code source et de ses contenus. Vous disposez d’une totale autonomie sans abonnement captif.',
  },
  {
    question: 'Pouvez-vous moderniser un site web existant ?',
    answer: 'Oui. Nous auditons votre site existant pour identifier ce qui fonctionne, corriger les points de friction et organiser une refonte progressive ou complète selon vos priorités.',
  },
];
---

<CommercialPage
  title="Création de site web orienté conversion pour PME | CLICOM Suisse"
  description="Sites web sur-mesure pour PME en Suisse romande : ergonomie, design moderne, vitesse Astro et parcours orientés conversion pour générer des demandes utiles."
  pillarTag="Pilier 01 · Présence digitale"
  eyebrow="Création de site web"
  h1="Un site web conçu pour <span class='accent'>convaincre, rassurer et générer des demandes.</span>"
  intro="CliCom conçoit des sites web sur-mesure pour les PME romandes : proposition de valeur limpide, navigation mobile fluide et structure technique optimisée pour transformer vos visiteurs en contacts qualifiés."
  {problems}
  solution="Votre site ne doit pas être une simple vitrine statique : c’est le point central de votre système digital. Il doit crédibiliser votre savoir-faire et faciliter la prise de contact sur tous les écrans."
  {services}
  {process}
  benefits={[
    'Une proposition de valeur comprise en quelques secondes par vos visiteurs',
    'Des demandes de devis plus fréquentes et mieux qualifiées',
    'Une vitesse de chargement instantanée sur mobile et ordinateur',
    'Un socle SEO technique robuste pensé dès la conception du projet',
    'Une connexion directe avec vos outils commerciaux et votre CRM',
  ]}
  {faq}
  links={[
    { href: '/services/', label: 'Le système complet CliCom' },
    { href: '/seo/', label: 'SEO & Visibilité' },
    { href: '/branding/', label: 'Branding & Identité' },
    { href: '/automatisation/', label: 'Automatisation des flux' },
  ]}
  problemEyebrow="Pourquoi un site peut rester inefficace"
  problemsTitle="La confiance se construit dans les détails du parcours."
  offerTitle="Concevoir un site qui relie image, performance et conversion."
  processTitle="Du cadrage à la mise en ligne, sans rupture entre stratégie et technique."
  benefitsTitle="Un site plus clair pour vos visiteurs et plus rentable pour votre PME."
  faqTitle="Les questions à éclaircir avant de lancer un projet web."
  {decisionGuide}
  heroPrimaryLabel="Parler de votre projet de site"
  heroSecondary="#approach"
  heroSecondaryLabel="Découvrir notre démarche"
  heroPrimaryCalendly={true}
  ctaTitle="Faisons de votre site un outil commercial plus clair."
  ctaText="Réservez un échange de 30 minutes pour discuter de votre site actuel, de votre projet et des priorités qui peuvent améliorer le parcours de vos visiteurs."
  ctaLabel="Réserver un échange gratuit de 30 minutes"
  ctaCalendly={true}
  editorialImage={webImage}
  {structuredData}
/>
