  {process}
  benefits={[
    'Une base de contacts plus claire et plus utilisable',
    'Des relances mieux reliées aux étapes du parcours',
    'Des communications plus pertinentes selon le contexte',
    'Une meilleure continuité entre marketing, vente et service client',
    'Des opportunités et des relations plus faciles à suivre',
  ]}
  {faq}
  links={[
    { href: '/automatisation/', label: 'Automatisation' },
    { href: '/creation-contenu/', label: 'Création de contenu' },
    { href: '/intelligence-artificielle/', label: 'Intelligence artificielle' },
  ]}
