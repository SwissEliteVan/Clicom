---
import CommercialPage from '../components/CommercialPage.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://clicom.ch/email-marketing-crm/#service',
      name: 'CRM et E-mail marketing pour PME en Suisse',
      provider: {
        '@type': 'Organization',
        name: 'CLICOM',
        url: 'https://clicom.ch/',
      },
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Suisse romande',
      },
      description: 'Organisation de base de contacts, pipeline commercial visuel et séquences e-mail de relance pour PME en Suisse romande.',
      serviceType: 'CRM et E-mail marketing',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://clicom.ch/email-marketing-crm/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://clicom.ch/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://clicom.ch/services' },
        { '@type': 'ListItem', position: 3, name: 'CRM & E-mail marketing', item: 'https://clicom.ch/email-marketing-crm/' },
      ],
    },
  ],
};

const problems = [
  {
    title: 'Des contacts éparpillés entre boîtes e-mails et tableurs',
    text: 'Informations commerciales, devis envoyés et historiques d’échange vivent dans des fichiers isolés sans vision centralisée.',
  },
  {
    title: 'Un suivi commercial qui dépend de la mémoire de chacun',
    text: 'Les prospects qui ne signent pas tout de suite sortent du radar, tandis que les relances restent difficiles à coordonner au quotidien.',
  },
  {
    title: 'Des communications de masse identiques pour des besoins différents',
    text: 'Envoyer les mêmes e-mails génériques sans tenir compte de l’intérêt réel, du secteur ou de l’état d’avancement de la relation.',
  },
];

const services = [
  { title: 'Configuration CRM & Pipeline commercial visuel', text: 'Structurer vos contacts, entreprises, montants d’affaires et étapes de vente selon votre cycle commercial réel.' },
  { title: 'Capture & Qualification automatique des demandes', text: 'Enregistrer directement les formulaires web avec les informations de contexte utiles pour orienter le premier contact.' },
  { title: 'Segmentation exploitable de la base clients', text: 'Créer des groupes de contacts pertinents selon leurs intérêts, leur maturité ou leur historique pour des messages ciblés.' },
  { title: 'Séquences d’e-mails & Scénarios de relance', text: 'Programmer des e-mails courtois et personnalisés après une demande de devis, un rendez-vous ou une étape clé.' },
  { title: 'Passation fluide entre marketing et vente', text: 'Rendre visibles les prochaines actions et faciliter la collaboration entre vos collaborateurs commerciaux.' },
  { title: 'Tableaux de bord d’activité & Mesure du taux de signature', text: 'Suivre le volume d’opportunités en cours, les délais de conversion et la valeur de votre pipeline.' },
];

const process = [
  { title: 'Cartographier', text: 'Analyser vos outils actuels, votre cycle de vente et les moments où des opportunités sont perdues.' },
  { title: 'Structurer', text: 'Définir les champs clés, nettoyer les listes de contacts et configurer les étapes du pipeline commercial.' },
  { title: 'Segmenter', text: 'Organiser les listes et critères pour adresser des communications pertinentes et non intrusives.' },
  { title: 'Activer les flux', text: 'Rédiger les modèles d’e-mails, paramétrer les relances automatiques et former vos équipes.' },
  { title: 'Piloter & Optimiser', text: 'Analyser les taux d’ouverture, de réponse et de signature pour affiner continuellement les scénarios.' },
];

const decisionGuide = {
  eyebrow: 'Intégration au système',
  title: 'Le CRM comme moteur relationnel du système CliCom.',
  intro: 'Le CRM et l’e-mail marketing fonctionnent lorsqu’ils apportent la bonne information ou la bonne relance au moment le plus opportun.',
  items: [
    { title: 'Nouveau lead & Demande de devis', text: 'Accuser réception instantanément, attribuer la tâche au bon commercial et planifier la relance avec contexte.' },
    { title: 'Accueil & Suivi client', text: 'Accompagner les premières étapes de la collaboration et partager les informations utiles après la signature.' },
    { title: 'Fidélisation & Réactivation', text: 'Recontacter vos clients existants avec une proposition pertinente au moment où un nouveau besoin émerge.' },
  ],
};

const faq = [
  {
    question: 'Quel CRM choisir pour une PME en Suisse romande ?',
    answer: 'Le bon choix dépend du nombre d’utilisateurs, de la complexité de votre cycle de vente et de vos logiciels existants. Nous sélectionnons des outils simples, intuitifs et rapidement adoptés par vos équipes sans usine à gaz.',
  },
  {
    question: 'Peut-on travailler avec notre outil CRM actuel ?',
    answer: 'Oui, très souvent. Nous analysons la structure actuelle, nettoyons les données et configurons les automatisations manquantes sur votre outil existant avant d’envisager toute migration.',
  },
  {
    question: 'Quelle est la différence entre une newsletter et une séquence e-mail de suivi ?',
    answer: 'Une newsletter est un envoi d’actualités périodique à l’ensemble de votre liste. Une séquence e-mail est un flux automatisé qui se déclenche suite à une action précise d’un prospect (ex: demande de devis, téléchargement de guide) pour l’accompagner dans sa décision.',
  },
  {
    question: 'Comment éviter que les e-mails de relance soient perçus comme intrusifs ?',
    answer: 'En limitant les messages à des contenus utiles et bienveillants (conseils, réponses aux questions fréquentes, proposition d’aide), en espaçant raisonnablement les envois et en respectant le rythme de décision du client.',
  },
];
---

<CommercialPage
  title="CRM & E-mail marketing pour PME | CLICOM Suisse"
  description="Organisation de vos contacts, structuration de pipeline commercial et scénarios e-mail de suivi pour PME en Suisse romande. Suivez chaque opportunité avec méthode."
  pillarTag="Pilier 03 · Automatisation"
  eyebrow="E-mail marketing & CRM"
  h1="Organiser vos contacts et suivre chaque opportunité avec un <span class='accent'>CRM clair et des e-mails utiles.</span>"
  intro="CliCom aide les PME romandes à structurer leur base de contacts, clarifier leur pipeline commercial et déployer des scénarios e-mail pertinents pour accompagner chaque prospect jusqu’à la signature."
  {problems}
  solution="L’e-mail marketing et le CRM ne servent pas à envoyer du spam : ils permettent de savoir où en est chaque relation, d’intervenir au bon moment avec le bon message et de réduire le risque de laisser une opportunité commerciale sans réponse."
  {services}
  {process}
  benefits={[
    'Une vision centralisée et en temps réel de toutes vos opportunités commerciales',
    'Des relances structurées qui augmentent le taux de signature de vos offres',
    'Un historique d’échange clair et partagé au sein de votre équipe',
    'Des communications ciblées et perçues comme professionnelles par vos prospects',
    'Un suivi précis de la rentabilité de vos actions d’acquisition',
  ]}
  {faq}
  links={[
    { href: '/services/', label: 'Le système complet CliCom' },
    { href: '/automatisation/', label: 'Automatisation des flux' },
    { href: '/creation-contenu/', label: 'Création de contenu' },
    { href: '/creation-site-web/', label: 'Création de site web' },
  ]}
  problemEyebrow="Pourquoi la relation commerciale se perd trop souvent"
  problemsTitle="Le bon suivi commence par une information fiable et une prochaine action claire."
  offerTitle="Relier données, relances et collaborateurs autour du parcours d’achat."
  processTitle="Une méthode qui organise vos échanges avant de les automatiser."
  benefitsTitle="Des contacts mieux suivis et un pipeline commercial plus prévisible."
  faqTitle="Les questions utiles avant de structurer votre CRM et vos e-mails."
  {decisionGuide}
  heroPrimaryLabel="Faire le point sur votre CRM"
  heroSecondary="#approach"
  heroSecondaryLabel="Voir les scénarios possibles"
  heroPrimaryCalendly={true}
  ctaTitle="Faisons le point sur vos contacts, vos relances et votre pipeline."
  ctaText="Réservez un échange de 30 minutes pour identifier les étapes où votre CRM et vos e-mails peuvent apporter le plus de rigueur commerciale à votre PME."
  ctaLabel="Réserver un échange gratuit de 30 minutes"
  ctaCalendly={true}
  variant="reverse"
  {structuredData}
/>
