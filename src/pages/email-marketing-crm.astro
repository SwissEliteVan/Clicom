  heroPrimaryLabel="Parler de votre CRM"
  heroSecondary="#approach"
  heroSecondaryLabel="Voir les scénarios possibles"
  heroPrimaryCalendly={true}
  ctaTitle="Faisons le point sur vos contacts, vos relances et votre pipeline."
