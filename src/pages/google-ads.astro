---
import CommercialPage from '../components/CommercialPage.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://clicom.ch/google-ads/#service',
      name: 'Gestion de campagnes Google Ads pour PME en Suisse',
      provider: {
        '@type': 'Organization',
        name: 'CLICOM',
        url: 'https://clicom.ch/',
      },
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Suisse romande',
      },
      description: 'Gestion de campagnes Google Ads orientées retour sur investissement et demandes qualifiées pour PME en Suisse romande.',
      serviceType: 'Publicité en ligne (Google Ads)',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://clicom.ch/google-ads/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://clicom.ch/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://clicom.ch/services' },
        { '@type': 'ListItem', position: 3, name: 'Google Ads', item: 'https://clicom.ch/google-ads/' },
      ],
    },
  ],
};

const problems = [
  {
    title: 'Un budget qui part en clics sans générer de contacts réels',
    text: 'Les dépenses progressent chaque mois, mais la qualité des demandes et les affaires conclues restent difficiles à relier aux investissements.',
  },
  {
    title: 'Des campagnes trop larges qui ciblent les mauvaises intentions',
    text: 'Mots-clés et zones géographiques se dispersent au lieu de concentrer vos ressources sur les décideurs proches de passer commande en Suisse.',
  },
  {
    title: 'Des pages de destination qui font fuir après le clic',
    text: 'Une annonce attractive ne compense pas une page lente, confuse ou inadaptée au mobile qui ne donne pas confiance pour faire une demande.',
  },
];

const services = [
  { title: 'Cadrage des offres & Stratégie de rentabilité', text: 'Définir les prestations à promouvoir, les zones géographiques utiles et les conversions qui créent une vraie valeur business.' },
  { title: 'Campagnes sur le réseau de recherche (Search)', text: 'Capter précisément les requêtes qui traduisent une intention d’achat immédiate avec une structure lisible.' },
  { title: 'Mots-clés, annonces & Exclusions négatives', text: 'Relier le vocabulaire exact de vos clients à des messages percutants et éliminer tout trafic non pertinent.' },
  { title: 'Landing pages optimisées pour convertir', text: 'Concevoir des pages de destination rapides et convaincantes, en parfaite cohérence avec la promesse de l’annonce.' },
  { title: 'Tracking des conversions & Mesure rigoureuse', text: 'Configurer la mesure des appels téléphoniques, des formulaires de devis et des prises de rendez-vous.' },
  { title: 'Optimisation continue & Arbitrages budgétaires', text: 'Ajuster régulièrement les enchères, les textes et les budgets selon la qualité constatée des opportunités.' },
];

const process = [
  { title: 'Cadrer', text: 'Analyser vos offres, vos marges, votre cycle de vente et votre zone d’intervention en Suisse romande.' },
  { title: 'Instrumenter', text: 'Vérifier et configurer la mesure des conversions avant de dépenser le moindre franc en média.' },
  { title: 'Construire', text: 'Bâtir la structure des campagnes, rédiger les annonces et aligner les pages de destination.' },
  { title: 'Lancer', text: 'Démarrer avec un budget maîtrisé pour observer les premiers signaux de conversion réels.' },
  { title: 'Optimiser', text: 'Arbitrer avec régularité pour réduire le coût par contact utile et développer les campagnes les plus rentables.' },
];

const decisionGuide = {
  eyebrow: 'Intégration au système',
  title: 'Google Ads dans l’écosystème d’acquisition PME.',
  intro: 'Google Ads active une source de leads immédiate pendant que le SEO consolide votre autorité organique.',
  items: [
    { title: 'Vitesse de déclenchement', text: 'Permet de tester immédiatement l’appétit du marché pour une nouvelle offre ou un nouveau secteur géographique.' },
    { title: 'Exige une Présence solide', text: 'La rentabilité de vos annonces dépend directement de la clarté et de la vitesse de votre site web.' },
    { title: 'Connexion directe au CRM', text: 'Chaque prospect issu de la publicité est instantanément enregistré et transmis à vos commerciaux.' },
  ],
};

const faq = [
  {
    question: 'Quel budget publicitaire mensuel faut-il prévoir pour Google Ads ?',
    answer: 'Le budget média dépend de votre secteur, du volume de recherche local et de la valeur d’un nouveau client. Nous le calibrons ensemble lors du cadrage, avec un budget de test maîtrisé sans engagement rigide.',
  },
  {
    question: 'Faut-il obligatoirement créer des pages spécifiques (landing pages) ?',
    answer: 'Pas systématiquement pour chaque mot-clé, mais la page d’arrivée doit répondre précisément à la recherche de l’internaute. Renvoyer du trafic payant vers une page d’accueil générale réduit fortement le taux de conversion.',
  },
  {
    question: 'Pouvez-vous garantir un coût par acquisition (CPA) fixe ?',
    answer: 'Non, car les coûts d’enchères varient selon la concurrence et le marché. En revanche, nous mettons en place une mesure rigoureuse et optimisons continuellement les variables maîtrisables pour maximiser votre rentabilité.',
  },
  {
    question: 'Combien de temps faut-il pour mettre en ligne des campagnes Google Ads ?',
    answer: 'Le lancement intervient généralement en 1 à 2 semaines, une fois les offres cadrées, les pages de destination prêtes et le système de tracking des conversions vérifié.',
  },
];
---

<CommercialPage
  title="Google Ads pour PME en Suisse romande : campagnes ciblées | CLICOM"
  description="Gestion de campagnes Google Ads orientées retour sur investissement pour PME suisses. Ciblez des recherches qualifiées et mesurez vos demandes de devis."
  pillarTag="Pilier 02 · Acquisition"
  eyebrow="Google Ads"
  h1="Transformer une intention de recherche existante en <span class='accent'>opportunités commerciales.</span>"
  intro="CliCom structure vos campagnes Google Ads autour de vos offres réelles, de la qualité des contacts générés et de la conversion concrète après le clic en Suisse romande."
  {problems}
  solution="La rentabilité d’une campagne publicitaire dépend autant de la page de destination, de la clarté de l’offre et du suivi commercial que des réglages techniques de votre compte Google Ads."
  {services}
  {process}
  benefits={[
    'Des budgets concentrés sur les intentions de recherche les plus rentables',
    'Des annonces et des pages de destination parfaitement alignées',
    'Une mesure exacte des demandes de devis et appels téléphoniques',
    'Des arbitrages fondés sur la valeur des opportunités, pas sur les seuls clics',
    'Un pilotage transparent adapté aux priorités commerciales de votre PME',
  ]}
  {faq}
  links={[
    { href: '/services/', label: 'Le système complet CliCom' },
    { href: '/creation-site-web/', label: 'Création de site web' },
    { href: '/seo/', label: 'SEO naturel' },
    { href: '/social-ads/', label: 'Publicité sur les réseaux sociaux' },
  ]}
  problemEyebrow="Pourquoi les campagnes déçoivent parfois"
  problemsTitle="Le clic n’est qu’un début : l’enjeu est ce qu’il déclenche ensuite."
  offerTitle="Un dispositif d’acquisition complet, pas seulement un compte d’annonces."
  processTitle="Une méthode qui relie campagne, page et conversion utile."
  benefitsTitle="Plus de clarté pour investir et optimiser au bon endroit."
  faqTitle="Les questions utiles avant d’investir dans Google Ads."
  {decisionGuide}
  heroPrimaryLabel="Faire le point sur vos campagnes Ads"
  heroSecondary="#approach"
  heroSecondaryLabel="Voir notre méthode"
  heroPrimaryCalendly={true}
  ctaTitle="Évaluons si Google Ads est le bon levier pour votre PME."
  ctaText="Réservez un échange de 30 minutes pour parler de votre offre, de vos pages et des conditions indispensables à une campagne publicitaire rentable."
  ctaLabel="Réserver un échange gratuit de 30 minutes"
  ctaCalendly={true}
  variant="reverse"
  {structuredData}
/>
