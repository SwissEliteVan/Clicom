---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeSystem from '../components/home/HomeSystem.astro';
import HomeExpertise from '../components/home/HomeExpertise.astro';
import HomeMethod from '../components/home/HomeMethod.astro';
import HomeWork from '../components/home/HomeWork.astro';
import HomeFAQ from '../components/home/HomeFAQ.astro';
import HomeCTA from '../components/home/HomeCTA.astro';
import '../styles/home.css';
import '../styles/home-motion.css';
import '../styles/home-v2.css';

const title = 'Clicom | Agence numérique suisse — Web, SEO, Ads & automatisation';
const description = 'CLICOM aide les PME et indépendants en Suisse romande à relier site web, SEO, publicité, automatisation et IA pour générer davantage d’opportunités commerciales.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': 'https://clicom.ch/#organization',
      name: 'CLICOM',
      url: 'https://clicom.ch/',
      email: 'hello@clicom.ch',
      telephone: '+41788238950',
      description,
      areaServed: { '@type': 'Country', name: 'Suisse' },
      serviceType: [
        'Création de sites web',
        'SEO',
        'Référencement IA',
        'Google Ads',
        'Publicité sur les réseaux sociaux',
        'Automatisation',
        'CRM et e-mail marketing',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://clicom.ch/#website',
      url: 'https://clicom.ch/',
      name: 'CLICOM',
      inLanguage: 'fr-CH',
      publisher: { '@id': 'https://clicom.ch/#organization' },
    },
  ],
};
---

<Layout {title} {description} {structuredData}>
  <div class="home-shell">
    <HomeHero />
    <HomeSystem />
    <HomeExpertise />
    <HomeMethod />
    <HomeWork />
    <HomeFAQ />
    <HomeCTA />
  </div>
</Layout>
