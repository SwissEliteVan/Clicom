---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeSystem from '../components/home/HomeSystem.astro';
import HomeExpertise from '../components/home/HomeExpertise.astro';
import HomeMethod from '../components/home/HomeMethod.astro';
import HomeWork from '../components/home/HomeWork.astro';
import HomeFAQ from '../components/home/HomeFAQ.astro';
import HomeCTA from '../components/home/HomeCTA.astro';
import '../styles/home.css';
import '../styles/home-motion.css';
import '../styles/home-v2.css';
import '../styles/home-v3.css';

const title = 'Clicom | Le digital utile aux PME de Suisse romande';
const description = 'CLICOM accompagne les PME suisses avec des sites, contenus, campagnes, automatisations, données et solutions sécurisées pour gagner en visibilité, efficacité et croissance.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': 'https://clicom.ch/#organization',
      name: 'CLICOM',
      url: 'https://clicom.ch/',
      email: 'hello@clicom.ch',
      telephone: '+41788238950',
      description,
      areaServed: { '@type': 'Country', name: 'Suisse' },
      slogan: 'Votre expertise mérite une présence digitale à sa hauteur.',
      serviceType: [
        'Stratégie digitale pour PME',
        'Création de sites web',
        'SEO local et référencement naturel',
        'Publicité en ligne',
        'Création de contenus',
        'Automatisation et intelligence artificielle',
        'CRM et gestion des prospects',
        'Maintenance et sécurité',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://clicom.ch/#website',
      url: 'https://clicom.ch/',
      name: 'CLICOM',
      inLanguage: 'fr-CH',
      publisher: { '@id': 'https://clicom.ch/#organization' },
    },
  ],
};
---

<Layout {title} {description} {structuredData}>
  <div class="home-shell">
    <HomeHero />
    <HomeSystem />
    <HomeExpertise />
    <HomeMethod />
    <HomeWork />
    <HomeFAQ />
    <HomeCTA />
  </div>
</Layout>
