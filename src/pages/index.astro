---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeFAQ from '../components/home/HomeFAQ.astro';
import EditorialImage from '../components/EditorialImage.astro';

// Images pour la homepage
import agenceFuturiste from '../assets/editorial/agence-digitale-futuriste.jpg';
import consultantStrategie from '../assets/editorial/consultant-digital-strategie.png';
import dashboardCroissance from '../assets/editorial/dashboard-croissance-digital.jpg';
import dashboardHolographique from '../assets/editorial/dashboard-holographique-data.jpg';
import expertMarketing from '../assets/editorial/expert-marketing-digital.jpg';
import gainTempsAdmin from '../assets/editorial/gain-de-temps-administratif-pme.jpeg';
import webResponsive from '../assets/editorial/web-responsive.webp';
import geoKnowledge from '../assets/editorial/geo-knowledge.webp';
import aiEditorial from '../assets/editorial/ai-editorial.webp';
import portfolioNatPatoune from '../assets/editorial/portfolio-nat-patoune.webp';
import portfolioRikunali from '../assets/editorial/portfolio-rikunali.webp';
import bureauFlatlay from '../assets/editorial/bureau-flatlay-document.png';
import ecosystemeNumerique from '../assets/editorial/ecosysteme-numerique.png';
import referencementVisibilite from '../assets/editorial/referencement-visibilite-web.png';
import creationSiteWeb from '../assets/editorial/creation-site-web-performant.png';
import marketingDigital from '../assets/editorial/marketing-digital-strategie.jpg';
import avisPositif from '../assets/editorial/avis-positif-boutique-geneve-augmentation-ventes-nfc.png';

const title = 'Clicom | Agence numérique suisse — Web, SEO, Ads & IA';
const description = 'Clicom accompagne les entreprises avec des sites web performants, du SEO, Google Ads, Publicité sur les réseaux sociaux et des solutions d\'intelligence artificielle et d\'automatisation.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': 'https://clicom.ch/#organization',
      name: 'CLICOM',
      url: 'https://clicom.ch/',
      email: 'hello@clicom.ch',
      telephone: '+41788238950',
      description,
      areaServed: { '@type': 'Country', name: 'Suisse' },
      serviceType: ['Création de sites web', 'SEO', 'Référencement IA', 'Google Ads', 'Publicité sur les réseaux sociaux', 'Automatisation IA', 'CRM et e-mail marketing'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://clicom.ch/#website',
      url: 'https://clicom.ch/',
      name: 'CLICOM',
      inLanguage: 'fr-CH',
      publisher: { '@id': 'https://clicom.ch/#organization' },
    },
  ],
};

type ServiceIcon = 'search' | 'cursor' | 'chart' | 'globe' | 'automation' | 'target' | 'code' | 'spark';
interface HomeService { icon: ServiceIcon; title: string; text: string; href: string; class?: string; }

const services: HomeService[] = [
  { icon: 'code', title: 'Sites web', text: 'Des expériences rapides et convaincantes pensées pour transformer les visiteurs en prospects.', href: '/services#web', class: 'service--wide' },
  { icon: 'search', title: 'SEO & Référencement IA', text: 'Renforcez votre visibilité sur Google et dans les nouveaux environnements de recherche générative.', href: '/services#seo', class: 'service--tall' },
  { icon: 'cursor', title: 'Google Ads', text: 'Captez la demande existante avec des campagnes orientées acquisition et rentabilité.', href: '/services#ads' },
  { icon: 'target', title: 'Publicité sur les réseaux sociaux', text: 'Touchez les bonnes audiences avec des campagnes Meta, LinkedIn et autres plateformes pertinentes.', href: '/services#ads' },
  { icon: 'spark', title: 'Réseaux sociaux & contenu', text: 'Construisez une présence cohérente avec des contenus pensés pour attirer l\'attention et créer de la confiance.', href: '/services#contenu', class: 'service--wide' },
  { icon: 'globe', title: 'Intelligence artificielle', text: 'Intégrez l\'IA là où elle améliore réellement vos processus marketing et commerciaux.', href: '/solutions#ia' },
  { icon: 'automation', title: 'Automatisation & CRM', text: 'Connectez vos prospects, vos e-mails et votre CRM pour réduire les tâches manuelles et améliorer le suivi.', href: '/solutions#crm', class: 'service--dark' },
];
---

<Layout {title} {description} {structuredData}>
  <HomeHero />

  <!-- Section 1 — Introduction / Approche -->
  <section class="home-intro" aria-labelledby="intro-title">
    <div class="container home-intro__grid" data-reveal>
      <div class="home-intro__index" data-reveal-item><span>01</span><i></i><span>Notre approche</span></div>
      <h2 id="intro-title" data-reveal-item>Le numérique ne devrait pas être une suite d'actions isolées.</h2>
      <div class="home-intro__copy" data-reveal-item>
        <p>Nous concevons des systèmes où chaque point de contact attire, convertit et nourrit le suivant.</p>
        <a class="text-link" href="/agence">Découvrir Clicom <span>↗</span></a>
      </div>
    </div>
    <div class="home-intro__visual" data-reveal>
      <div class="home-intro__image-row">
        <EditorialImage src={agenceFuturiste} alt="Agence digitale futuriste — innovation et technologie" ratio="1/1" ratioMobile="1/1" position="center" eager />
        <EditorialImage src={consultantStrategie} alt="Consultant digital en stratégie de croissance" ratio="3/2" ratioMobile="4/3" position="center" />
      </div>
    </div>
  </section>

  <!-- Section 2 — Problème / Système Clicom -->
  <section class="section problem" aria-labelledby="problem-title">
    <div class="container" data-reveal>
      <div class="problem__heading" data-reveal-item>
        <div>
          <div class="eyebrow">Le problème</div>
          <h2 id="problem-title">Votre marketing doit générer des clients.<br /><span class="accent">Pas seulement de la visibilité.</span></h2>
        </div>
        <p>Une présence en ligne ne suffit pas si elle n'attire pas les bonnes personnes, ne transforme pas les visiteurs en prospects et ne permet pas de suivre les opportunités commerciales.</p>
      </div>
      <div class="problem-system" data-reveal-item>
        <div class="frictions">
          {[
            ['01','Site internet','Un site qui reçoit des visiteurs mais génère peu de demandes.'],
            ['02','Visibilité','Des concurrents plus visibles sur Google.'],
            ['03','Publicité','Des campagnes dont la rentabilité est difficile à mesurer.'],
            ['04','Prospects','Des demandes qui ne sont pas suivies suffisamment rapidement.'],
            ['05','Outils','Des outils qui ne communiquent pas entre eux.'],
            ['06','Temps','Trop de tâches marketing répétitives.'],
          ].map(([number,label,text]) => <article><span>{number}</span><small>{label}</small><p>{text}</p></article>)}
        </div>
        <div class="system-answer">
          <div class="answer-mark" aria-hidden="true"><span></span><i></i><b>→</b></div>
          <span class="tag">Système Clicom</span>
          <h3>Relier les leviers pour créer un parcours cohérent.</h3>
          <p>Clicom relie stratégie, acquisition, conversion et automatisation dans un seul système de croissance.</p>
          <a class="text-link" href="/solutions">Découvrir les solutions <span>→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3 — Expertises / Services (Bento Grid) -->
  <section class="section section--white services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">Expertises</div>
        <h2 id="services-title">Tout ce qu'il faut pour accélérer votre croissance en ligne.</h2>
        <p>Des expertises complémentaires, activées selon vos objectifs plutôt que selon une formule préétablie.</p>
      </div>
      <div class="services-bento">
        <!-- Sites web -->
        <article class="service-card service--wide" style={`--service-bg: url(${webResponsive.src})`}>
          <div class="service-card__bg" aria-hidden="true"></div>
          <div class="service-card__top">
            <span class="icon-box"><Icon name="code" /></span>
            <span aria-hidden="true" class="service-card__number">01</span>
          </div>
          <h3>Sites web</h3>
          <p>Des expériences rapides et convaincantes pensées pour transformer les visiteurs en prospects.</p>
          <a href="/services#web">Explorer ce service <span aria-hidden="true">→</span></a>
          <div class="service-signal" aria-hidden="true"><i></i><span></span><b>→</b></div>
        </article>
        <!-- SEO & Référencement IA -->
        <article class="service-card service--tall" style={`--service-bg: url(${geoKnowledge.src})`}>
          <div class="service-card__bg" aria-hidden="true"></div>
          <div class="service-card__top">
            <span class="icon-box"><Icon name="search" /></span>
            <span aria-hidden="true" class="service-card__number">02</span>
          </div>
          <h3>SEO & Référencement IA</h3>
          <p>Renforcez votre visibilité sur Google et dans les nouveaux environnements de recherche générative.</p>
          <a href="/services#seo">Explorer ce service <span aria-hidden="true">→</span></a>
        </article>
        <!-- Google Ads -->
        <article class="service-card" style={`--service-bg: url(${dashboardCroissance.src})`}>
          <div class="service-card__bg" aria-hidden="true"></div>
          <div class="service-card__top">
            <span class="icon-box"><Icon name="cursor" /></span>
            <span aria-hidden="true" class="service-card__number">03</span>
          </div>
          <h3>Google Ads</h3>
          <p>Captez la demande existante avec des campagnes orientées acquisition et rentabilité.</p>
          <a href="/services#ads">Explorer ce service <span aria-hidden="true">→</span></a>
        </article>
        <!-- Publicité sur les réseaux sociaux -->
        <article class="service-card" style={`--service-bg: url(${dashboardHolographique.src})`}>
          <div class="service-card__bg" aria-hidden="true"></div>
          <div class="service-card__top">
            <span class="icon-box"><Icon name="target" /></span>
            <span aria-hidden="true" class="service-card__number">04</span>
          </div>
          <h3>Publicité sur les réseaux sociaux</h3>
          <p>Touchez les bonnes audiences avec des campagnes Meta, LinkedIn et autres plateformes pertinentes.</p>
          <a href="/services#ads">Explorer ce service <span aria-hidden="true">→</span></a>
        </article>
        <!-- Réseaux sociaux & contenu -->
        <article class="service-card service--wide" style={`--service-bg: url(${marketingDigital.src})`}>
          <div class="service-card__bg" aria-hidden="true"></div>
          <div class="service-card__top">
            <span class="icon-box"><Icon name="spark" /></span>
            <span aria-hidden="true" class="service-card__number">05</span>
          </div>
          <h3>Réseaux sociaux & contenu</h3>
          <p>Construisez une présence cohérente avec des contenus pensés pour attirer l'attention et créer de la confiance.</p>
          <a href="/services#contenu">Explorer ce service <span aria-hidden="true">→</span></a>
          <div class="service-signal" aria-hidden="true"><i></i><span></span><b>→</b></div>
        </article>
        <!-- Intelligence artificielle -->
        <article class="service-card" style={`--service-bg: url(${aiEditorial.src})`}>
          <div class="service-card__bg" aria-hidden="true"></div>
          <div class="service-card__top">
            <span class="icon-box"><Icon name="globe" /></span>
            <span aria-hidden="true" class="service-card__number">06</span>
          </div>
          <h3>Intelligence artificielle</h3>
          <p>Intégrez l'IA là où elle améliore réellement vos processus marketing et commerciaux.</p>
          <a href="/solutions#ia">Explorer ce service <span aria-hidden="true">→</span></a>
        </article>
        <!-- Automatisation & CRM -->
        <article class="service-card service--dark" style={`--service-bg: url(${gainTempsAdmin.src})`}>
          <div class="service-card__bg" aria-hidden="true"></div>
          <div class="service-card__top">
            <span class="icon-box"><Icon name="automation" /></span>
            <span aria-hidden="true" class="service-card__number">07</span>
          </div>
          <h3>Automatisation & CRM</h3>
          <p>Connectez vos prospects, vos e-mails et votre CRM pour réduire les tâches manuelles et améliorer le suivi.</p>
          <a href="/solutions#crm">Explorer ce service <span aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <!-- Section 4 — Méthode Clicom -->
  <section class="section growth" aria-labelledby="growth-title">
    <div class="container">
      <div class="growth__head">
        <div>
          <div class="eyebrow">Méthode Clicom</div>
          <h2 id="growth-title">Un système de croissance,<br />pas une collection de prestations.</h2>
        </div>
        <p>Chaque étape alimente la suivante. Le suivi permet ensuite d'identifier ce qui doit être conservé, corrigé ou renforcé.</p>
      </div>
      <div class="growth__media" data-reveal>
        <EditorialImage src={expertMarketing} alt="Expert marketing digital analysant des données de performance" ratio="21/9" ratioMobile="4/3" position="center 30%" />
      </div>
      <div class="growth-pipeline">
        {[
          ['01','Attirer',['Référencement','Publicité','Réseaux sociaux','Contenu']],
          ['02','Convertir',['Expérience utilisateur','Pages de conversion','Rédaction persuasive','Suivi des conversions']],
          ['03','Automatiser',['CRM','E-mail','Intelligence artificielle','Automatisations']],
          ['04','Accélérer',['Données','Tests','Optimisation','Développement']],
        ].map(([number,title,items], index) => <article><div class="pipeline-index"><span>{number}</span>{index < 3 && <i aria-hidden="true">→</i>}</div><h3>{title}</h3><ul>{(items as string[]).map(item => <li>{item}</li>)}</ul></article>)}
      </div>
    </div>
  </section>

  <!-- Section 5 — SEO / Visibilité IA -->
  <section class="section section--dark visibility" aria-labelledby="visibility-title">
    <div class="container visibility__layout">
      <div class="visibility__copy">
        <div class="eyebrow">Visibilité 2026</div>
        <h2 id="visibility-title">La recherche change.<br />Votre visibilité doit évoluer avec elle.</h2>
        <p class="lead">Le SEO améliore votre référencement sur les moteurs de recherche. Le GEO et l'AEO optimisent vos contenus pour les nouvelles réponses générées par l'intelligence artificielle.</p>
        <div class="visibility-tags">{['SEO','GEO','AEO','Recherche','Visibilité IA','Contenu structuré'].map(item => <span>{item}</span>)}</div>
        <a class="text-link" href="/services#seo">Découvrir le référencement <span>→</span></a>
      </div>
      <div class="visibility__visual">
        <EditorialImage src={referencementVisibilite} alt="Référencement et visibilité web — SEO, GEO, AEO" ratio="3/2" ratioMobile="4/3" position="center" />
      </div>
    </div>
  </section>

  <!-- Section 6 — Sites web -->
  <section class="section web-section" aria-labelledby="web-title">
    <div class="container web-layout">
      <div class="web-copy">
        <div class="eyebrow">Sites web</div>
        <h2 id="web-title">Votre site ne doit pas seulement être beau.<br /><span class="accent">Il doit convertir.</span></h2>
        <p>La création web associe clarté du message, qualité de l'expérience et fondations techniques solides.</p>
        <div class="feature-grid">
          {['Stratégie','Expérience utilisateur','Adapté à tous les écrans','Performance','SEO technique','Conversion','Suivi des conversions','Sécurité'].map(item => <span><i aria-hidden="true"></i>{item}</span>)}
        </div>
        <Button href="/services#web" variant="dark">Découvrir les sites web <span aria-hidden="true">→</span></Button>
      </div>
      <div class="web-visual">
        <EditorialImage src={creationSiteWeb} alt="Création de site web performant et responsive" ratio="3/2" ratioMobile="4/3" position="center" />
      </div>
    </div>
  </section>

  <!-- Section 7 — Google Ads / Acquisition -->
  <section class="section section--white ads" aria-labelledby="ads-title">
    <div class="container">
      <div class="ads__heading">
        <div>
          <div class="eyebrow">Acquisition payante</div>
          <h2 id="ads-title">Achetez de la visibilité.<br /><span class="accent">Mesurez de la performance.</span></h2>
        </div>
        <p>Chaque campagne doit relier une audience, une intention, une création, une page et un suivi exploitable.</p>
      </div>
      <div class="ads-grid">
        <article>
          <div class="ads-card__head">
            <span class="icon-box"><Icon name="search" /></span>
            <div><small>Intention</small><h3>Google Ads</h3></div>
          </div>
          <ul><li>Réseau de recherche</li><li>Performance Max</li><li>Reciblage</li><li>Suivi des conversions</li><li>Optimisation</li></ul>
          <a class="text-link" href="/services#ads">Découvrir Google Ads <span>→</span></a>
        </article>
        <div class="funnel" aria-label="Parcours illustratif d'une campagne">
          <span>Campagne</span><i></i><span>Clic</span><i></i><span>Page de conversion</span><i></i><span>Prospect</span><i></i><strong>CRM</strong>
        </div>
        <article>
          <div class="ads-card__head">
            <span class="icon-box"><Icon name="cursor" /></span>
            <div><small>Audience</small><h3>Publicité sur les réseaux sociaux</h3></div>
          </div>
          <ul><li>Meta Ads</li><li>LinkedIn Ads</li><li>Audiences</li><li>Créations publicitaires</li><li>Reciblage</li></ul>
          <a class="text-link" href="/services#ads">Découvrir la publicité sociale <span>→</span></a>
        </article>
      </div>
    </div>
  </section>

  <!-- Section 8 — Automatisation -->
  <section class="section automation" aria-labelledby="automation-title">
    <div class="container automation__layout">
      <div class="automation__copy">
        <div class="eyebrow">Automatisation</div>
        <h2 id="automation-title">Votre marketing peut continuer à travailler pendant que vous faites autre chose.</h2>
        <p class="lead">Les automatisations sont conçues selon les besoins réels, les outils disponibles et les contrôles humains nécessaires.</p>
        <Button href="/solutions#ia">Découvrir l'automatisation <span aria-hidden="true">→</span></Button>
      </div>
      <div class="automation__visual">
        <EditorialImage src={ecosystemeNumerique} alt="Écosystème numérique connecté — automatisation et CRM" ratio="1/1" ratioMobile="1/1" position="center" />
      </div>
    </div>
  </section>

  <!-- Section 9 — Pour qui (Audiences) -->
  <section class="section section--white audiences" aria-labelledby="audience-title">
    <div class="container">
      <div class="section-heading section-heading--center">
        <div class="eyebrow">Pour qui</div>
        <h2 id="audience-title">Pensé pour les entreprises qui veulent accélérer.</h2>
        <p>L'approche s'adapte au niveau de maturité, aux ressources et aux priorités de chaque organisation.</p>
      </div>
      <div class="audience-grid">
        {['PME','Indépendants','Entreprises locales','E-commerce','Immobilier','Services professionnels'].map((item,index) => <div><span>0{index+1}</span><strong>{item}</strong><i aria-hidden="true">→</i></div>)}
      </div>
      <div class="audience-visual" data-reveal>
        <EditorialImage src={avisPositif} alt="Avis positif d'une boutique genevoise — augmentation des ventes" ratio="21/9" ratioMobile="4/3" position="center" />
      </div>
    </div>
  </section>

  <!-- Section 10 — Réalisations -->
  <section class="section work" aria-labelledby="work-title">
    <div class="container work__panel">
      <div>
        <div class="eyebrow">Réalisations</div>
        <h2 id="work-title">Des projets présentés avec contexte et transparence.</h2>
        <p>Les réalisations Clicom sont partagées lorsque le contexte, l'approche et les informations publiables permettent de comprendre le travail effectué — sans résultat inventé.</p>
        <div class="button-row">
          <Button href="/contact#audit">Parler de votre projet <span aria-hidden="true">↗</span></Button>
          <Button href="/realisations" variant="secondary">Notre approche des réalisations</Button>
        </div>
      </div>
      <div class="work-gallery">
        <EditorialImage src={portfolioNatPatoune} alt="Projet de site web pour Nat&Patoune" ratio="4/3" ratioMobile="1/1" position="center" />
        <EditorialImage src={portfolioRikunali} alt="Projet de site web pour Rikunali" ratio="4/3" ratioMobile="1/1" position="center" />
      </div>
    </div>
  </section>

  <HomeFAQ />

  <!-- Section 11 — CTA Final -->
  <section class="final-cta" aria-labelledby="final-cta-title">
    <div class="container final-cta__panel">
      <div class="final-cta__bg" aria-hidden="true">
        <EditorialImage src={bureauFlatlay} alt="" ratio="1/1" ratioMobile="1/1" position="center" />
      </div>
      <div class="final-cta__copy">
        <div class="eyebrow">Prochaine étape</div>
        <h2 id="final-cta-title">Prêt à accélérer votre croissance ?</h2>
        <p>Parlons de vos objectifs et identifions les leviers numériques les plus pertinents pour votre entreprise.</p>
        <Button href="/contact#audit">Demander un audit gratuit <span aria-hidden="true">↗</span></Button>
      </div>
      <div class="final-cta__contact">
        <div class="cta-motif" aria-hidden="true"><span></span><i></i><b>→</b></div>
        <a href="tel:+41788238950"><small>Téléphone</small>+41 78 823 89 50</a>
        <a href="mailto:hello@clicom.ch"><small>E-mail</small>hello@clicom.ch</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* =============================================
     HOME INTRO — Nouvelle section visuelle
     ============================================= */
  .home-intro { position: relative; padding-block: clamp(7rem,12vw,12rem); overflow: hidden; background: var(--color-background); }
  .home-intro::before { position: absolute; top: 0; right: 5%; width: min(42vw,650px); height: 1px; background: linear-gradient(90deg,transparent,var(--color-primary)); content: ''; }
  .home-intro__grid { display: grid; grid-template-columns: minmax(130px,.35fr) minmax(0,1.65fr) minmax(260px,.58fr); align-items: start; gap: clamp(28px,5vw,80px); }
  .home-intro__index { display: flex; align-items: center; gap: 12px; padding-top: 14px; color: var(--color-text-muted); font-size: .65rem; font-weight: 760; letter-spacing: .13em; text-transform: uppercase; }
  .home-intro__index i { width: 28px; height: 1px; background: var(--color-primary); }
  .home-intro h2 { max-width: 850px; margin: 0; font-size: clamp(3rem,5.2vw,6rem); line-height: .98; letter-spacing: -.065em; text-wrap: pretty; }
  .home-intro__copy { padding-top: 14px; }
  .home-intro__copy p { font-size: clamp(1rem,1.2vw,1.14rem); }
  .home-intro__visual { margin-top: clamp(40px,6vw,80px); }
  .home-intro__image-row { display: grid; grid-template-columns: 1fr 1.5fr; gap: 20px; }
  .home-intro__image-row :global(.editorial-image) { border-radius: 20px; overflow: hidden; }

  /* =============================================
     PROBLEM
     ============================================= */
  .problem__heading, .growth__head, .ads__heading { display: grid; grid-template-columns: minmax(0,1.55fr) minmax(280px,.65fr); align-items: end; gap: clamp(40px,8vw,110px); margin-bottom: clamp(48px,7vw,80px); }
  .problem__heading h2, .growth__head h2, .ads__heading h2 { margin-bottom: 0; }
  .problem__heading > p, .growth__head > p, .ads__heading > p { margin-bottom: 5px; }
  .problem-system { display: grid; grid-template-columns: minmax(0,1.35fr) minmax(320px,.65fr); gap: 24px; }
  .frictions { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); border: 1px solid var(--color-border); border-radius: var(--radius-surface); overflow: hidden; background: var(--color-border); gap: 1px; }
  .frictions article { position: relative; min-height: 175px; padding: 28px; background: white; }
