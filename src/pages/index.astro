---
import Layout from '../layouts/Layout.astro';import Button from '../components/Button.astro';import ServiceCard from '../components/ServiceCard.astro';import Icon from '../components/Icon.astro';import CTA from '../components/CTA.astro';
---
<Layout><section class="home-hero"><div class="container hero-grid"><div><div class="eyebrow">Agence digitale suisse</div><h1>Transformez votre digital en <span class="gradient-text">moteur de croissance.</span></h1><p class="lead">Clicom aide les entreprises à attirer davantage de prospects, convertir davantage de clients et automatiser leur croissance.</p><div class="button-row"><Button href="/contact#audit">Demander un audit gratuit →</Button><Button href="/services" variant="secondary">Découvrir nos services</Button></div><p class="hero-note"><span class="motif">●────→</span> Stratégie. Créativité. Technologie. Performance.</p></div><div class="dashboard" aria-label="Illustration des leviers de croissance digitale"><div class="dash-top"><span>● Système d’acquisition</span><small>Leviers coordonnés</small></div><div class="metrics"><div><small>ATTIRER</small><strong>↑</strong><span>Visibilité qualifiée</span></div><div><small>CONVERTIR</small><strong>→</strong><span>Parcours cohérent</span></div></div><div class="chart"><span>Progression</span><svg viewBox="0 0 520 190" role="img" aria-label="Illustration d’une progression"><defs><linearGradient id="line"><stop stop-color="#2457FF"/><stop offset="1" stop-color="#22D3EE"/></linearGradient></defs><path d="M0 45h520M0 95h520M0 145h520" class="gridline"/><path d="M0 158C65 154 86 128 130 134s78-28 120-21 61-47 108-39 83-48 162-59" class="curve"/><circle cx="358" cy="74" r="6"/><circle cx="520" cy="15" r="7"/></svg></div><div class="channels"><span>SEO<i></i></span><span>ADS<i></i></span><span>IA<i></i></span></div><div class="float"><Icon name="target"/><b>Objectif commercial</b></div></div></div></section>
<section class="trust"><div class="container"><p>Votre marketing doit générer du business. <strong>Pas seulement des impressions.</strong></p><div><span>Stratégie sur mesure</span><span>Exécution rapide</span><span>Mesure claire</span></div></div></section>
<section class="section"><div class="container"><div class="section-heading"><div class="eyebrow">Expertises</div><h2>Un système digital pensé pour <span class="accent">performer.</span></h2><p>Chaque levier a un rôle précis. Ensemble, ils transforment l’attention en opportunités commerciales.</p></div><div class="grid grid--3"><ServiceCard icon="code" title="Sites web & Landing Pages" text="Des expériences rapides, crédibles et conçues pour convertir." href="/services#web"/><ServiceCard icon="search" title="SEO, GEO & AEO" text="Une visibilité travaillée pour Google et les moteurs de réponse IA." href="/services#seo"/><ServiceCard icon="cursor" title="Google Ads & Social Ads" text="Des campagnes structurées autour de vos objectifs d’acquisition." href="/services#ads"/><ServiceCard icon="spark" title="Branding, social & contenus" text="Une identité cohérente et des contenus adaptés à chaque canal." href="/services#contenu"/><ServiceCard icon="automation" title="Automatisation & IA" text="Des processus connectés pour gagner en fluidité sans perdre l’humain." href="/solutions#ia"/><ServiceCard icon="chart" title="CRM & email marketing" text="Un suivi commercial clair et des communications utiles tout au long du parcours." href="/solutions#crm"/></div></div></section>
<section class="section section--dark"><div class="container ai"><div><div class="eyebrow">Intelligence artificielle</div><h2>L’IA utile. Intégrée à votre <span class="gradient-text">croissance.</span></h2><p class="lead">Mieux répondre, mieux qualifier, produire plus vite et prendre de meilleures décisions.</p><div class="button-row"><Button href="/solutions#ia">Découvrir nos solutions IA →</Button></div></div><div class="nodes" aria-hidden="true"><span><Icon name="spark"/></span><b>CRM</b><b>LEADS</b><b>DATA</b><b>CONTENU</b></div></div></section>
<section class="section section--white"><div class="container"><div class="section-heading"><div class="eyebrow">Méthode</div><h2>De la clarté à <span class="accent">l’accélération.</span></h2></div><div class="grid grid--4">{[['01','Comprendre'],['02','Construire'],['03','Activer'],['04','Accélérer']].map(([n,t])=><article class="step"><span>{n}</span><h3>{t}</h3></article>)}</div></div></section>
<section class="section"><div class="container"><div class="case"><div><span class="tag">Notre engagement</span><h2>Des recommandations claires.<br/>Des priorités utiles.</h2><p>Nous partons de vos objectifs, de vos outils et de vos contraintes pour construire un plan d’action adapté à votre entreprise.</p><a class="text-link" href="/agence">Découvrir notre approche <span>→</span></a></div><span class="motif">●────→</span></div></div></section><CTA/></Layout>
<style>.home-hero{overflow:hidden;padding-block:clamp(4.5rem,8vw,7.5rem)}.hero-grid{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:clamp(50px,7vw,100px)}.hero-note{margin-top:40px;font-size:.82rem}.dashboard{position:relative;padding:22px;border:1px solid rgba(36,87,255,.16);border-radius:28px;background:white;box-shadow:0 30px 90px rgba(8,17,38,.12)}.dash-top{display:flex;justify-content:space-between;padding-bottom:18px;border-bottom:1px solid var(--color-border);font-size:.8rem;font-weight:750}.dash-top span{color:var(--color-primary)}.metrics{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-block:16px}.metrics>div{display:grid;grid-template-columns:1fr auto;padding:16px;border:1px solid var(--color-border);border-radius:14px;background:var(--color-cloud)}.metrics small{color:var(--color-muted)}.metrics strong{grid-row:1/3;grid-column:2;color:var(--color-primary);font-size:1.5rem}.chart{padding:16px;border:1px solid var(--color-border);border-radius:16px;font-size:.8rem;font-weight:750}.gridline{fill:none;stroke:var(--color-border)}.curve{fill:none;stroke:url(#line);stroke-width:5;stroke-linecap:round}.chart circle{fill:white;stroke:var(--color-primary);stroke-width:4}.channels{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}.channels span{color:var(--color-muted);font-size:.7rem;font-weight:750}.channels i{display:block;height:4px;margin-top:6px;border-radius:4px;background:var(--gradient-brand)}.float{position:absolute;right:-30px;bottom:18%;display:flex;gap:9px;padding:12px;border:1px solid var(--color-border);border-radius:14px;background:white;box-shadow:var(--shadow-featured);font-size:.72rem}.float svg{width:20px;color:var(--color-primary)}.trust{padding-block:28px;border-block:1px solid var(--color-border);background:white}.trust .container,.trust div div{display:flex;justify-content:space-between;gap:24px}.trust p{margin:0;color:var(--color-midnight)}.trust div div{color:var(--color-muted);font-size:.8rem}.ai{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:80px}.nodes{position:relative;min-height:380px;background:radial-gradient(circle,rgba(36,87,255,.2),transparent 65%)}.nodes span,.nodes b{position:absolute;display:grid;place-items:center;border:1px solid rgba(34,211,238,.3);border-radius:14px;color:var(--color-cyan);background:var(--color-midnight)}.nodes span{top:50%;left:50%;width:76px;height:76px;background:var(--color-primary);transform:translate(-50%,-50%)}.nodes span svg{width:30px;color:white}.nodes b{padding:12px;font-size:.7rem}.nodes b:nth-of-type(1){top:10%;left:12%}.nodes b:nth-of-type(2){top:17%;right:5%}.nodes b:nth-of-type(3){bottom:14%;left:5%}.nodes b:nth-of-type(4){right:8%;bottom:8%}.step{padding-top:24px;border-top:2px solid var(--color-border)}.step span{display:block;margin-bottom:42px;color:var(--color-primary);font-size:.78rem}.case{display:flex;align-items:flex-end;justify-content:space-between;min-height:320px;padding:clamp(32px,5vw,64px);border:1px solid var(--color-border);border-radius:28px;background:white;box-shadow:var(--shadow-card)}@media(max-width:950px){.hero-grid,.ai{grid-template-columns:1fr}.dashboard{max-width:680px}.trust .container{flex-direction:column}.float{display:none}}@media(max-width:600px){.metrics{grid-template-columns:1fr}.case{align-items:flex-start;flex-direction:column}}</style>
