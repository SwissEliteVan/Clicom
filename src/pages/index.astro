---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeExpertise from '../components/home/HomeExpertise.astro';
import HomeChallenges from '../components/home/HomeChallenges.astro';
import HomeMethod from '../components/home/HomeMethod.astro';
import HomeSystemDemo from '../components/home/HomeSystemDemo.astro';
import HomeWork from '../components/home/HomeWork.astro';
import HomeProof from '../components/home/HomeProof.astro';
import HomeFAQ from '../components/home/HomeFAQ.astro';
import HomeAbout from '../components/home/HomeAbout.astro';
import HomeCTA from '../components/home/HomeCTA.astro';
import '../styles/home/index.css';
const title = 'CLICOM | Agence digitale pour PME en Suisse romande';
const description = 'CliCom construit le système digital qui aide les PME romandes à être trouvées, choisies et mieux organisées : site web, visibilité, acquisition et automatisation.';
const structuredData = {'@context':'https://schema.org','@graph':[{'@type':['Organization','ProfessionalService'],'@id':'https://clicom.ch/#organization',name:'CLICOM',url:'https://clicom.ch/',email:'hello@clicom.ch',telephone:'+41788238950',description,areaServed:{'@type':'AdministrativeArea',name:'Suisse romande'},serviceType:['Création de sites web','Référencement naturel (SEO)','Acquisition & Google Ads','Automatisation et CRM','Performance et sécurité']},{'@type':'WebSite','@id':'https://clicom.ch/#website',url:'https://clicom.ch/',name:'CLICOM',inLanguage:'fr-CH',publisher:{'@id':'https://clicom.ch/#organization'}}]};
---
<Layout {title} {description} {structuredData}>
  <div class="home-shell">
    <!-- Positionnement -->
    <HomeHero />
    <!-- Expertise -->
    <HomeExpertise />
    <!-- Problèmes résolus -->
    <HomeChallenges />
    <!-- Méthode -->
    <HomeMethod />
    <!-- Démonstration de savoir-faire -->
    <HomeSystemDemo />
    <!-- Projets sélectionnés = preuves -->
    <HomeWork />
    <!-- Solutions / Secteurs -->
    <section class="home-sector-band" aria-label="Secteurs accompagnés"><div class="container"><span>PME</span><i></i><span>Artisans</span><i></i><span>Immobilier</span><i></i><span>E-commerce</span><i></i><span>Services professionnels</span><i></i><span>Entreprises locales</span></div></section>
    <!-- Preuves documentées -->
    <HomeProof />
    <HomeFAQ />
    <HomeAbout />
    <!-- Prise de contact -->
    <HomeCTA />
  </div>
</Layout>
