---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeSystem from '../components/home/HomeSystem.astro';
import HomeExpertise from '../components/home/HomeExpertise.astro';
import HomeMethod from '../components/home/HomeMethod.astro';
import HomeWork from '../components/home/HomeWork.astro';
import HomeFAQ from '../components/home/HomeFAQ.astro';
import HomeCTA from '../components/home/HomeCTA.astro';
import '../styles/home.css';
import '../styles/home-v2.css';
import '../styles/home-v3.css';
const title = 'CLICOM | Agence digitale pour PME en Suisse romande';
const description = 'CLICOM relie site web, SEO, acquisition, automatisation, données et sécurité pour construire un digital utile aux PME de Suisse romande.';
const structuredData = {'@context':'https://schema.org','@graph':[{'@type':['Organization','ProfessionalService'],'@id':'https://clicom.ch/#organization',name:'CLICOM',url:'https://clicom.ch/',email:'hello@clicom.ch',telephone:'+41788238950',description,areaServed:{'@type':'AdministrativeArea',name:'Suisse romande'},serviceType:['Création de sites web','SEO','Google Ads','Automatisation et CRM','Performance et sécurité']},{'@type':'WebSite','@id':'https://clicom.ch/#website',url:'https://clicom.ch/',name:'CLICOM',inLanguage:'fr-CH',publisher:{'@id':'https://clicom.ch/#organization'}}]};
---
<Layout {title} {description} {structuredData}>
  <div class="home-shell">
    <HomeHero /><HomeSystem /><HomeExpertise /><HomeMethod />
    <section class="home-sector-band" aria-label="Secteurs accompagnés"><div class="container"><span>PME</span><i></i><span>Artisans</span><i></i><span>Immobilier</span><i></i><span>E-commerce</span><i></i><span>Services professionnels</span><i></i><span>Entreprises locales</span></div></section>
    <HomeWork /><HomeFAQ /><HomeCTA />
  </div>
</Layout>
<script>import '../scripts/home-premium';</script>
