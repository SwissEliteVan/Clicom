---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeFAQ from '../components/home/HomeFAQ.astro';

const title = 'Clicom | Agence numérique suisse — Web, SEO, Ads & IA';
const description = 'Clicom accompagne les entreprises avec des sites web performants, du SEO, Google Ads, Publicité sur les réseaux sociaux et des solutions d’intelligence artificielle et d’automatisation.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': 'https://clicom.ch/#organization',
      name: 'CLICOM',
      url: 'https://clicom.ch/',
      email: 'hello@clicom.ch',
      telephone: '+41788238950',
      description,
      areaServed: { '@type': 'Country', name: 'Suisse' },
      serviceType: ['Création de sites web', 'SEO', 'Référencement IA', 'Google Ads', 'Publicité sur les réseaux sociaux', 'Automatisation IA', 'CRM et e-mail marketing'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://clicom.ch/#website',
      url: 'https://clicom.ch/',
      name: 'CLICOM',
      inLanguage: 'fr-CH',
      publisher: { '@id': 'https://clicom.ch/#organization' },
    },
  ],
};

type ServiceIcon = 'search' | 'cursor' | 'chart' | 'globe' | 'automation' | 'target' | 'code' | 'spark';
interface HomeService { icon: ServiceIcon; title: string; text: string; href: string; class?: string; }

const services: HomeService[] = [
  { icon: 'code', title: 'Sites web', text: 'Des expériences rapides et convaincantes pensées pour transformer les visiteurs en prospects.', href: '/services#web', class: 'service--wide' },
  { icon: 'search', title: 'SEO & Référencement IA', text: 'Renforcez votre visibilité sur Google et dans les nouveaux environnements de recherche générative.', href: '/services#seo', class: 'service--tall' },
  { icon: 'cursor', title: 'Google Ads', text: 'Captez la demande existante avec des campagnes orientées acquisition et rentabilité.', href: '/services#ads' },
  { icon: 'target', title: 'Publicité sur les réseaux sociaux', text: 'Touchez les bonnes audiences avec des campagnes Meta, LinkedIn et autres plateformes pertinentes.', href: '/services#ads' },
  { icon: 'spark', title: 'Réseaux sociaux & contenu', text: 'Construisez une présence cohérente avec des contenus pensés pour attirer l’attention et créer de la confiance.', href: '/services#contenu', class: 'service--wide' },
  { icon: 'globe', title: 'Intelligence artificielle', text: 'Intégrez l’IA là où elle améliore réellement vos processus marketing et commerciaux.', href: '/solutions#ia' },
  { icon: 'automation', title: 'Automatisation & CRM', text: 'Connectez vos prospects, vos e-mails et votre CRM pour réduire les tâches manuelles et améliorer le suivi.', href: '/solutions#crm', class: 'service--dark' },
];
---

<Layout {title} {description} {structuredData}>
  <HomeHero />

  <section class="home-intro" aria-labelledby="intro-title">
    <div class="container home-intro__grid" data-reveal>
      <div class="home-intro__index" data-reveal-item><span>01</span><i></i><span>Notre approche</span></div>
      <h2 id="intro-title" data-reveal-item>Le numérique ne devrait pas être une suite d’actions isolées.</h2>
      <div class="home-intro__copy" data-reveal-item>
        <p>Nous concevons des systèmes où chaque point de contact attire, convertit et nourrit le suivant.</p>
        <a class="text-link" href="/agence">Découvrir Clicom <span>↗</span></a>
      </div>
    </div>
  </section>

  <section class="section problem" aria-labelledby="problem-title">
    <div class="container" data-reveal>
      <div class="problem__heading" data-reveal-item><div><div class="eyebrow">Le problème</div><h2 id="problem-title">Votre marketing doit générer des clients.<br /><span class="accent">Pas seulement de la visibilité.</span></h2></div><p>Une présence en ligne ne suffit pas si elle n’attire pas les bonnes personnes, ne transforme pas les visiteurs en prospects et ne permet pas de suivre les opportunités commerciales.</p></div>
      <div class="problem-system" data-reveal-item>
        <div class="frictions">
          {[
            ['01','Site internet','Un site qui reçoit des visiteurs mais génère peu de demandes.'],['02','Visibilité','Des concurrents plus visibles sur Google.'],['03','Publicité','Des campagnes dont la rentabilité est difficile à mesurer.'],
            ['04','Prospects','Des demandes qui ne sont pas suivies suffisamment rapidement.'],['05','Outils','Des outils qui ne communiquent pas entre eux.'],['06','Temps','Trop de tâches marketing répétitives.'],
          ].map(([number,label,text]) => <article><span>{number}</span><small>{label}</small><p>{text}</p></article>)}
        </div>
        <div class="system-answer">
          <div class="answer-mark" aria-hidden="true"><span></span><i></i><b>→</b></div>
          <span class="tag">Système Clicom</span>
          <h3>Relier les leviers pour créer un parcours cohérent.</h3>
          <p>Clicom relie stratégie, acquisition, conversion et automatisation dans un seul système de croissance.</p>
          <a class="text-link" href="/solutions">Découvrir les solutions <span>→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--white services" aria-labelledby="services-title">
    <div class="container">
      <div class="section-heading"><div class="eyebrow">Expertises</div><h2 id="services-title">Tout ce qu’il faut pour accélérer votre croissance en ligne.</h2><p>Des expertises complémentaires, activées selon vos objectifs plutôt que selon une formule préétablie.</p></div>
      <div class="services-bento">
        {services.map((service) => (
          <article class:list={['service-card', service.class]}>
            <div class="service-card__top"><span class="icon-box"><Icon name={service.icon} /></span><span aria-hidden="true" class="service-card__number">0{services.indexOf(service) + 1}</span></div>
            <h3>{service.title}</h3><p>{service.text}</p>
            <a href={service.href}>Explorer ce service <span aria-hidden="true">→</span></a>
            {service.class === 'service--wide' && <div class="service-signal" aria-hidden="true"><i></i><span></span><b>→</b></div>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section growth" aria-labelledby="growth-title">
    <div class="container">
      <div class="growth__head"><div><div class="eyebrow">Méthode Clicom</div><h2 id="growth-title">Un système de croissance,<br />pas une collection de prestations.</h2></div><p>Chaque étape alimente la suivante. Le suivi permet ensuite d’identifier ce qui doit être conservé, corrigé ou renforcé.</p></div>
      <div class="growth-pipeline">
        {[
          ['01','Attirer',['Référencement','Publicité','Réseaux sociaux','Contenu']],['02','Convertir',['Expérience utilisateur','Pages de conversion','Rédaction persuasive','Suivi des conversions']],
          ['03','Automatiser',['CRM','E-mail','Intelligence artificielle','Automatisations']],['04','Accélérer',['Données','Tests','Optimisation','Développement']],
        ].map(([number,title,items], index) => <article><div class="pipeline-index"><span>{number}</span>{index < 3 && <i aria-hidden="true">→</i>}</div><h3>{title}</h3><ul>{(items as string[]).map(item => <li>{item}</li>)}</ul></article>)}
      </div>
    </div>
  </section>

  <section class="section section--dark visibility" aria-labelledby="visibility-title">
    <div class="container visibility__layout">
      <div class="visibility__copy"><div class="eyebrow">Visibilité 2026</div><h2 id="visibility-title">La recherche change.<br />Votre visibilité doit évoluer avec elle.</h2><p class="lead">Le SEO améliore votre référencement sur les moteurs de recherche. Le GEO et l’AEO optimisent vos contenus pour les nouvelles réponses générées par l’intelligence artificielle.</p><div class="visibility-tags">{['SEO','GEO','AEO','Recherche','Visibilité IA','Contenu structuré'].map(item => <span>{item}</span>)}</div><a class="text-link" href="/services#seo">Découvrir le référencement <span>→</span></a></div>
      <div class="search-orbit" role="img" aria-label="Illustration des sources de visibilité connectées à une marque">
        <svg viewBox="0 0 600 520" aria-hidden="true"><path d="M300 260L108 105M300 260L490 101M300 260L538 276M300 260L467 435M300 260L117 426M300 260L65 270"/><circle cx="300" cy="260" r="118"/><circle cx="300" cy="260" r="205"/></svg>
        <div class="orbit-core"><span><Icon name="search" /></span><strong>Votre marque</strong><small>Contenu · Autorité · Structure</small></div>
        <span class="orbit-node node--google">Google</span><span class="orbit-node node--search">Recherche</span><span class="orbit-node node--ai">IA</span><span class="orbit-node node--content">Contenu</span><span class="orbit-node node--local">Local</span><span class="orbit-node node--authority">Autorité</span>
      </div>
    </div>
  </section>

  <section class="section web-section" aria-labelledby="web-title">
    <div class="container web-layout">
      <div class="browser-mockup" role="img" aria-label="Illustration du parcours entre un visiteur et une prise de contact">
        <div class="browser-bar"><span><i></i><i></i><i></i></span><div>clicom.ch / page-de-conversion</div></div>
        <div class="browser-page"><div class="page-copy"><small>Proposition de valeur</small><span></span><span></span><button tabindex="-1">Appel à l’action →</button></div><div class="page-visual"><div></div><i></i><i></i></div></div>
        <div class="browser-flow"><span>Visiteur</span><i>→</i><span>Page de conversion</span><i>→</i><span>Demande</span><i>→</i><strong>Prospect</strong></div>
      </div>
      <div class="web-copy"><div class="eyebrow">Sites web</div><h2 id="web-title">Votre site ne doit pas seulement être beau.<br /><span class="accent">Il doit convertir.</span></h2><p>La création web associe clarté du message, qualité de l’expérience et fondations techniques solides.</p><div class="feature-grid">{['Stratégie','Expérience utilisateur','Adapté à tous les écrans','Performance','SEO technique','Conversion','Suivi des conversions','Sécurité'].map(item => <span><i aria-hidden="true"></i>{item}</span>)}</div><Button href="/services#web" variant="dark">Découvrir les sites web <span aria-hidden="true">→</span></Button></div>
    </div>
  </section>

  <section class="section section--white ads" aria-labelledby="ads-title">
    <div class="container"><div class="ads__heading"><div><div class="eyebrow">Acquisition payante</div><h2 id="ads-title">Achetez de la visibilité.<br /><span class="accent">Mesurez de la performance.</span></h2></div><p>Chaque campagne doit relier une audience, une intention, une création, une page et un suivi exploitable.</p></div>
      <div class="ads-grid">
        <article><div class="ads-card__head"><span class="icon-box"><Icon name="search" /></span><div><small>Intention</small><h3>Google Ads</h3></div></div><ul><li>Réseau de recherche</li><li>Performance Max</li><li>Reciblage</li><li>Suivi des conversions</li><li>Optimisation</li></ul><a class="text-link" href="/services#ads">Découvrir Google Ads <span>→</span></a></article>
        <div class="funnel" aria-label="Parcours illustratif d’une campagne"><span>Campagne</span><i></i><span>Clic</span><i></i><span>Page de conversion</span><i></i><span>Prospect</span><i></i><strong>CRM</strong></div>
        <article><div class="ads-card__head"><span class="icon-box"><Icon name="cursor" /></span><div><small>Audience</small><h3>Publicité sur les réseaux sociaux</h3></div></div><ul><li>Meta Ads</li><li>LinkedIn Ads</li><li>Audiences</li><li>Créations publicitaires</li><li>Reciblage</li></ul><a class="text-link" href="/services#ads">Découvrir la publicité sociale <span>→</span></a></article>
      </div>
    </div>
  </section>

  <section class="section automation" aria-labelledby="automation-title">
    <div class="container automation__layout">
      <div class="automation__copy"><div class="eyebrow">Automatisation</div><h2 id="automation-title">Votre marketing peut continuer à travailler pendant que vous faites autre chose.</h2><p class="lead">Les automatisations sont conçues selon les besoins réels, les outils disponibles et les contrôles humains nécessaires.</p><Button href="/solutions#ia">Découvrir l’automatisation <span aria-hidden="true">→</span></Button></div>
      <div class="workflow" role="img" aria-label="Exemple d’automatisation reliant formulaire, qualification, CRM, e-mail, rendez-vous et suivi commercial">
        {[
          ['code','Formulaire'],['target','Prospect'],['spark','Qualification IA'],['chart','CRM'],['automation','E-mail'],['globe','Rendez-vous'],['cursor','Suivi commercial'],
        ].map(([icon,label], index) => <><div class="workflow-node"><span><Icon name={icon as 'code'} /></span><strong>{label}</strong><small>{index < 2 ? 'Entrée' : index < 5 ? 'Traitement' : 'Action'}</small></div>{index < 6 && <div class="workflow-line" aria-hidden="true"><i></i><b>→</b></div>}</>)}
      </div>
    </div>
  </section>

  <section class="section section--white audiences" aria-labelledby="audience-title">
    <div class="container"><div class="section-heading section-heading--center"><div class="eyebrow">Pour qui</div><h2 id="audience-title">Pensé pour les entreprises qui veulent accélérer.</h2><p>L’approche s’adapte au niveau de maturité, aux ressources et aux priorités de chaque organisation.</p></div><div class="audience-grid">{['PME','Indépendants','Entreprises locales','E-commerce','Immobilier','Services professionnels'].map((item,index) => <div><span>0{index+1}</span><strong>{item}</strong><i aria-hidden="true">→</i></div>)}</div></div>
  </section>

  <section class="section work" aria-labelledby="work-title">
    <div class="container work__panel"><div><div class="eyebrow">Réalisations</div><h2 id="work-title">Des projets présentés avec contexte et transparence.</h2><p>Les réalisations Clicom sont partagées lorsque le contexte, l’approche et les informations publiables permettent de comprendre le travail effectué — sans résultat inventé.</p><div class="button-row"><Button href="/contact#audit">Parler de votre projet <span aria-hidden="true">→</span></Button><Button href="/realisations" variant="secondary">Notre approche des réalisations</Button></div></div><div class="work-graphic" aria-hidden="true"><span>Contexte</span><i></i><span>Approche</span><i></i><span>Projet</span></div></div>
  </section>

  <HomeFAQ />

  <section class="final-cta" aria-labelledby="final-cta-title">
    <div class="container final-cta__panel"><div class="final-cta__copy"><div class="eyebrow">Prochaine étape</div><h2 id="final-cta-title">Prêt à accélérer votre croissance ?</h2><p>Parlons de vos objectifs et identifions les leviers numériques les plus pertinents pour votre entreprise.</p><Button href="/contact#audit">Demander un audit gratuit <span aria-hidden="true">→</span></Button></div><div class="final-cta__contact"><div class="cta-motif" aria-hidden="true"><span></span><i></i><b>→</b></div><a href="tel:+41788238950"><small>Téléphone</small>+41 78 823 89 50</a><a href="mailto:hello@clicom.ch"><small>E-mail</small>hello@clicom.ch</a></div></div>
  </section>
</Layout>

<style>
  .home-intro { position: relative; padding-block: clamp(7rem,12vw,12rem); overflow: hidden; background: var(--color-background); }
  .home-intro::before { position: absolute; top: 0; right: 5%; width: min(42vw,650px); height: 1px; background: linear-gradient(90deg,transparent,var(--color-primary)); content: ''; }
  .home-intro__grid { display: grid; grid-template-columns: minmax(130px,.35fr) minmax(0,1.65fr) minmax(260px,.58fr); align-items: start; gap: clamp(28px,5vw,80px); }
  .home-intro__index { display: flex; align-items: center; gap: 12px; padding-top: 14px; color: var(--color-text-muted); font-size: .65rem; font-weight: 760; letter-spacing: .13em; text-transform: uppercase; }
  .home-intro__index i { width: 28px; height: 1px; background: var(--color-primary); }
  .home-intro h2 { max-width: 850px; margin: 0; font-size: clamp(3rem,5.2vw,6rem); line-height: .98; letter-spacing: -.065em; text-wrap: pretty; }
  .home-intro__copy { padding-top: 14px; }
  .home-intro__copy p { font-size: clamp(1rem,1.2vw,1.14rem); }

  .problem__heading, .growth__head, .ads__heading { display: grid; grid-template-columns: minmax(0,1.55fr) minmax(280px,.65fr); align-items: end; gap: clamp(40px,8vw,110px); margin-bottom: clamp(48px,7vw,80px); }
  .problem__heading h2, .growth__head h2, .ads__heading h2 { margin-bottom: 0; }
  .problem__heading > p, .growth__head > p, .ads__heading > p { margin-bottom: 5px; }
  .problem-system { display: grid; grid-template-columns: minmax(0,1.35fr) minmax(320px,.65fr); gap: 24px; }
  .frictions { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); border: 1px solid var(--color-border); border-radius: var(--radius-surface); overflow: hidden; background: var(--color-border); gap: 1px; }
  .frictions article { position: relative; min-height: 175px; padding: 28px; background: white; }
  .frictions article::after { position: absolute; top: 28px; right: 28px; width: 6px; height: 6px; border-radius: 50%; background: #f04438; box-shadow: 0 0 0 5px rgba(240,68,56,.07); content: ''; }
  .frictions span { color: var(--color-border-strong); font-size: .7rem; font-weight: 760; }
  .frictions small { display: block; margin-top: 22px; color: var(--color-text-muted); font-size: .65rem; font-weight: 740; letter-spacing: .12em; text-transform: uppercase; }
  .frictions p { margin: 6px 0 0; color: var(--color-midnight); font-weight: 680; }
  .system-answer { position: relative; display: flex; min-height: 100%; flex-direction: column; align-items: flex-start; justify-content: flex-end; padding: clamp(32px,4vw,48px); overflow: hidden; border-radius: var(--radius-surface); color: white; background: var(--gradient-dark); }
  .system-answer::before { position: absolute; inset: 0; opacity: .2; background-image: radial-gradient(rgba(255,255,255,.3) 1px, transparent 1px); background-size: 18px 18px; content: ''; mask-image: linear-gradient(to bottom, black, transparent 75%); }
  .system-answer > * { position: relative; z-index: 1; }
  .answer-mark { position: absolute; top: 44px; right: 40px; left: 40px; display: flex; align-items: center; color: var(--color-cyan); }
  .answer-mark span { width: 11px; height: 11px; border-radius: 50%; background: var(--color-cyan); }
  .answer-mark i { height: 1px; flex: 1; background: linear-gradient(90deg,var(--color-cyan),transparent); }
  .answer-mark b { font-size: 1.7rem; font-weight: 400; }
  .system-answer .tag { margin-bottom: 24px; color: var(--color-cyan); border-color: rgba(34,211,238,.22); background: rgba(34,211,238,.08); }
  .system-answer h3 { font-size: clamp(1.8rem,2.6vw,2.5rem); }
  .system-answer p { color: var(--color-dark-muted); }
  .system-answer .text-link { color: var(--color-cyan); }

  .services-bento { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); grid-auto-flow: dense; gap: 20px; }
  .service-card { position: relative; display: flex; min-height: 330px; flex-direction: column; padding: 30px; overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-background); transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base); }
  .service-card:hover { transform: translateY(-4px); border-color: rgba(36,87,255,.28); box-shadow: var(--shadow-card-hover); }
  .service-card__top { display: flex; align-items: flex-start; justify-content: space-between; }
  .service-card__number { color: var(--color-border-strong); font-size: .68rem; font-weight: 760; }
  .service-card h3 { margin-top: auto; }
  .service-card p { font-size: .94rem; }
  .service-card > a { display: inline-flex; align-items: center; gap: 8px; color: var(--color-primary); font-size: .82rem; font-weight: 720; }
  .service-card > a::after { position: absolute; inset: 0; content: ''; }
  .service-card > a span { transition: transform var(--transition-fast); }
  .service-card:hover > a span { transform: translateX(4px); }
  .service--wide { grid-column: span 2; }
  .service--tall { grid-row: span 2; min-height: 680px; background: linear-gradient(155deg,var(--color-primary-soft),white 70%); }
  .service--dark { grid-column: span 2; color: white; border-color: rgba(255,255,255,.1); background: var(--gradient-dark); }
  .service--dark p { color: var(--color-dark-muted); }
  .service--dark .service-card__number { color: rgba(255,255,255,.2); }
  .service--dark > a { color: var(--color-cyan); }
  .service-signal { position: absolute; top: 48px; right: 30px; display: flex; width: 100px; align-items: center; color: var(--color-primary); }
  .service-signal i { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .service-signal span { height: 1px; flex: 1; background: linear-gradient(90deg,currentColor,transparent); }
  .service-signal b { font-weight: 400; }

  .growth { overflow: hidden; }
  .growth-pipeline { position: relative; display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 1px; padding: 1px; border: 1px solid var(--color-border); border-radius: var(--radius-surface); background: var(--color-border); }
  .growth-pipeline article { min-height: 390px; padding: 32px; background: white; }
  .growth-pipeline article:first-child { border-radius: 28px 0 0 28px; }
  .growth-pipeline article:last-child { border-radius: 0 28px 28px 0; background: var(--color-midnight); }
  .pipeline-index { display: flex; align-items: center; justify-content: space-between; margin-bottom: 90px; color: var(--color-primary); font-size: .7rem; font-weight: 760; }
  .pipeline-index i { font-size: 1.3rem; font-style: normal; font-weight: 400; }
  .growth-pipeline article:last-child .pipeline-index { color: var(--color-cyan); }
  .growth-pipeline article:last-child h3 { color: white; }
  .growth-pipeline ul { display: grid; gap: 8px; margin: 25px 0 0; padding: 0; list-style: none; }
  .growth-pipeline li { color: var(--color-text-muted); font-size: .82rem; }
  .growth-pipeline article:last-child li { color: var(--color-dark-muted); }

  .visibility__layout, .web-layout, .automation__layout { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); align-items: center; gap: clamp(64px,9vw,130px); }
  .visibility-tags { display: flex; flex-wrap: wrap; gap: 8px; margin: 32px 0 10px; }
  .visibility-tags span { padding: 8px 12px; border: 1px solid rgba(255,255,255,.12); border-radius: 999px; color: var(--color-dark-muted); background: rgba(255,255,255,.04); font-size: .72rem; }
  .visibility .text-link { color: var(--color-cyan); }
  .search-orbit { position: relative; min-height: 580px; }
  .search-orbit svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .search-orbit path, .search-orbit circle { fill: none; stroke: rgba(34,211,238,.18); stroke-width: 1; stroke-dasharray: 6 8; }
  .orbit-core { position: absolute; top: 50%; left: 50%; display: grid; width: 190px; height: 190px; place-items: center; align-content: center; border: 1px solid rgba(34,211,238,.24); border-radius: 50%; background: rgba(36,87,255,.14); box-shadow: 0 0 80px rgba(36,87,255,.2); transform: translate(-50%,-50%); }
  .orbit-core span { display: grid; width: 46px; height: 46px; place-items: center; border-radius: 14px; color: white; background: var(--color-primary); }
  .orbit-core :global(svg) { position: static; width: 21px; height: 21px; }
  .orbit-core strong { margin-top: 10px; font-size: 1rem; }
  .orbit-core small { color: var(--color-dark-muted); font-size: .57rem; }
