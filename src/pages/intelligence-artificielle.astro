---
import CommercialPage from '../components/CommercialPage.astro';
import aiImage from '../assets/editorial/ai-editorial.webp';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://clicom.ch/intelligence-artificielle/#service',
      name: 'Intelligence artificielle opérationnelle pour PME en Suisse',
      provider: {
        '@type': 'Organization',
        name: 'CLICOM',
        url: 'https://clicom.ch/',
      },
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Suisse romande',
      },
      description: 'Intégration d’usages IA pragmatiques, sécurisés et encadrés sous contrôle humain pour PME en Suisse romande. Traitement de données, synthèse et support.',
      serviceType: 'Intégration d’intelligence artificielle',
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://clicom.ch/intelligence-artificielle/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://clicom.ch/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://clicom.ch/services' },
        { '@type': 'ListItem', position: 3, name: 'Intelligence artificielle', item: 'https://clicom.ch/intelligence-artificielle/' },
      ],
    },
  ],
};

const problems = [
  {
    title: 'Trop d’outils et d’expérimentations sans retour sur investissement',
    text: 'Tester des dizaines d’applications IA isolées sans objectif métier prioritaire, sans cadre de données et sans intégration dans le quotidien de vos équipes.',
  },
  {
    title: 'Des tâches d’analyse et de rédaction toujours lentes et manuelles',
    text: 'Recherche documentaire, tri de dossiers, synthèses de réunions ou réponses types sont répétés manuellement sans exploiter le potentiel d’assistance de l’IA.',
  },
  {
    title: 'La crainte justifiée de résultats erronés ou de fuites de données',
    text: 'Sans règles strictes de confidentialité, sans sources vérifiées et sans validation humaine, un outil génératif peut produire des erreurs dommageables.',
  },
];

const services = [
  { title: 'Audit d’opportunité & Sélection des cas d’usage', text: 'Identifier les tâches récurrentes où l’IA apporte un gain de productivité concret et mesurable à votre PME.' },
  { title: 'Tri, classification & Extraction de données', text: 'Automatiser la catégorisation de demandes entrantes, de factures ou de documents selon vos critères métier.' },
  { title: 'Assistance à la rédaction & Préparation documentaire', text: 'Mettre en place des cadres de préparation assistée (comptes-rendus, propositions, synthèses) avec contrôle des sources.' },
  { title: 'Recherche interne & Base de connaissances d’entreprise', text: 'Permettre à vos collaborateurs d’interroger instantanément vos procédures, manuels et documentations internes sécurisées.' },
  { title: 'Support & Réponses types contextualisées', text: 'Aider vos équipes à formuler des réponses rapides et qualitatives aux questions fréquentes de vos clients.' },
  { title: 'Sécurisation des données & Charte d’usage', text: 'Garantir la confidentialité de vos informations professionnelles et définir les règles de validation humaine obligatoire.' },
];

const process = [
  { title: 'Cadrer', text: 'Partir d’un besoin opérationnel fréquent, d’un objectif de gain de temps clair et d’un niveau de risque maîtrisé.' },
  { title: 'Prototyper', text: 'Tester la solution sur un périmètre restreint pour vérifier l’exactitude des réponses et la simplicité de prise en main.' },
  { title: 'Encadrer', text: 'Définir les sources de données officielles, les consignes strictes et les points de contrôle humain indispensables.' },
  { title: 'Intégrer', text: 'Déployer l’assistant IA directement dans les outils quotidiens de vos collaborateurs en Suisse romande.' },
  { title: 'Améliorer', text: 'Former vos équipes, mesurer le temps gagné et faire évoluer les modèles selon les retours d’expérience.' },
];

const decisionGuide = {
  eyebrow: 'Intégration au système',
  title: 'L’IA comme assistant opérationnel sous contrôle humain.',
  intro: 'L’intelligence artificielle ne remplace ni le processus métier ni le jugement humain : elle amplifie l’efficacité de vos équipes.',
  items: [
    { title: 'Assistance ≠ Décision autonome', text: 'L’IA propose, synthétise ou prépare une version de travail ; votre collaborateur valide et conserve l’entière responsabilité.' },
    { title: 'La rigueur des données prime', text: 'Un outil IA n’est utile que s’il s’appuie sur des informations d’entreprise fiables, structurées et protégées.' },
    { title: 'Synergie avec l’Automatisation', text: 'Se combine avec vos flux de travail pour accélérer le traitement des demandes sans rupture organisationnelle.' },
  ],
};

const faq = [
  {
    question: 'Par où une PME doit-elle commencer avec l’intelligence artificielle ?',
    answer: 'Par un problème concret et fréquent (par exemple : le tri des demandes entrantes, la synthèse de documents techniques ou la recherche d’informations internes), plutôt que par le choix d’un logiciel à la mode. Nous débutons toujours par un prototype testé sur un cas d’usage délimité.',
  },
  {
    question: 'Comment garantissez-vous la confidentialité de nos données d’entreprise ?',
    answer: 'Nous sélectionnons des modèles et environnements professionnels garantissant que vos données ne sont ni partagées publiquement ni réutilisées pour entraîner des modèles tiers, conformément aux exigences suisses de protection des données.',
  },
  {
    question: 'L’IA remplace-t-elle des collaborateurs dans l’entreprise ?',
    answer: 'Non. Notre démarche vise à assister vos équipes pour éliminer les tâches ingrates de ressaisie et de recherche, afin qu’elles puissent consacrer leur temps au conseil, à la relation client et aux décisions stratégiques.',
  },
  {
    question: 'Quelle est la différence entre automatisation classique et intelligence artificielle ?',
    answer: 'L’automatisation classique applique des règles fixes (« si un formulaire arrive, envoyer un e-mail »). L’IA apporte une capacité d’analyse, de compréhension du langage et de synthèse sur des données non structurées, avant de passer le relais au flux automatisé.',
  },
];
---

<CommercialPage
  title="Intelligence artificielle pour PME en Suisse : usages concrets | CLICOM"
  description="Intégration d’outils IA pragmatiques et sécurisés pour assister vos équipes : synthèse, analyse, préparation de contenus et support. Sans effets d’annonce."
  pillarTag="Pilier 03 · Automatisation"
  eyebrow="Intelligence artificielle"
  h1="Intégrer l’intelligence artificielle là où elle apporte un <span class='accent'>gain opérationnel concret.</span>"
  intro="CliCom accompagne les PME romandes dans l’adoption d’usages IA pragmatiques : assistance au traitement de données, préparation documentaire et support interne, toujours sous le contrôle et la responsabilité de vos collaborateurs."
  {problems}
  solution="L’IA n’a de valeur que si elle résout un problème précis du quotidien. Nous ne vendons pas d’utopie technologique : nous mettons en place des assistants opérationnels encadrés, avec des sources vérifiables et un contrôle humain systématique."
  {services}
  {process}
  benefits={[
    'Des cas d’usage sélectionnés pour leur rentabilité et leur utilité immédiate',
    'Un gain de temps significatif sur les tâches d’analyse, de tri et de synthèse',
    'Une sécurité stricte pour vos données d’entreprise et informations confidentielles',
    'Une adoption rapide par vos équipes grâce à des outils intégrés et documentés',
    'Le maintien du jugement humain et de l’expertise métier au cœur des décisions',
  ]}
  {faq}
  links={[
    { href: '/services/', label: 'Le système complet CliCom' },
    { href: '/automatisation/', label: 'Automatisation des flux' },
    { href: '/referencement-ia/', label: 'Référencement IA' },
    { href: '/email-marketing-crm/', label: 'CRM & E-mail marketing' },
  ]}
  problemEyebrow="Pourquoi l’IA déçoit parfois"
  problemsTitle="Un outil puissant ne résout pas un problème mal défini."
  offerTitle="Partir du travail réel pour bâtir des assistants véritablement utiles."
  processTitle="Du cas d’usage au déploiement, avec des contrôles proportionnés."
  benefitsTitle="Des usages IA plus concrets, plus fiables et plus faciles à adopter."
  faqTitle="Les questions utiles avant d’intégrer l’IA dans vos processus."
  {decisionGuide}
  heroPrimaryLabel="Parler d’un cas d’usage IA"
  heroSecondary="#approach"
  heroSecondaryLabel="Comprendre notre méthode"
  heroPrimaryCalendly={true}
  ctaTitle="Évaluons un usage IA à partir de votre réalité opérationnelle."
  ctaText="Réservez un échange de 30 minutes pour identifier une tâche, un processus ou une information qui mérite d’être étudiée avec méthode dans votre PME."
  ctaLabel="Réserver un échange de 30 min →"
  ctaCalendly={true}
  variant="reverse"
  editorialImage={aiImage}
  {structuredData}
/>
