---
import CommercialPage from '../components/CommercialPage.astro';
import aiImage from '../assets/editorial/ai-editorial.webp';
const problems=[{title:'Trop d’outils, peu de direction',text:'Les usages IA se multiplient sans priorité, gouvernance ni intégration réelle.'},{title:'Des tâches toujours manuelles',text:'Les équipes répètent des opérations qui pourraient être assistées ou simplifiées.'},{title:'Des résultats difficiles à fiabiliser',text:'Les réponses générées manquent de contexte, de contrôle ou de validation.'}];
const services=[{title:'Stratégie IA',text:'Cas d’usage, priorités, risques et feuille de route adaptés à l’entreprise.'},{title:'Assistants métier',text:'Interfaces contextualisées pour aider les équipes dans leurs tâches.'},{title:'Génération de contenu',text:'Cadres de production avec règles, sources et validation humaine.'},{title:'Intégrations',text:'Connexion de l’IA aux outils et données utiles.'},{title:'Automatisations',text:'Enchaînement d’étapes assistées pour gagner en régularité.'},{title:'Marketing & acquisition',text:'Recherche, qualification, personnalisation et production encadrée.'}];
const process=[{title:'Identifier',text:'Choisir les usages utiles et réalistes.'},{title:'Prototyper',text:'Tester rapidement avec un périmètre contrôlé.'},{title:'Intégrer',text:'Connecter outils, données et validations.'},{title:'Encadrer',text:'Mesurer, documenter et améliorer.'}];
const faq=[{question:'Par où commencer avec l’IA ?',answer:'Par un problème concret, fréquent et mesurable, plutôt que par le choix d’un outil.'},{question:'L’IA remplace-t-elle les équipes ?',answer:'Notre approche vise à assister les équipes, réduire les tâches répétitives et améliorer la disponibilité de l’information.'},{question:'Comment limiter les erreurs ?',answer:'Par le contexte, les sources, des règles explicites, des tests et une validation humaine adaptée au risque.'}];
---
<CommercialPage title="Solutions d’intelligence artificielle — CLICOM" description="Stratégie IA, assistants, génération de contenu, intégrations et automatisations pour la productivité, le marketing et l’acquisition." eyebrow="Intelligence artificielle" h1="Passer de l’expérimentation IA à des <span class='accent'>usages réellement utiles.</span>" intro="CLICOM aide les entreprises à sélectionner, prototyper et intégrer des usages IA pragmatiques, avec un cadre clair." {problems} solution="Nous partons des processus et des équipes pour concevoir des assistants, intégrations et automatisations mesurables, contrôlés et évolutifs." {services} {process} benefits={['Des cas d’usage priorisés par valeur','Une intégration adaptée aux outils existants','Des validations proportionnées aux risques','Une adoption facilitée pour les équipes','Un cadre évolutif plutôt qu’un effet de mode']} {faq} links={[{href:'/automatisation/',label:'Automatisation'},{href:'/referencement-ia/',label:'Référencement IA'},{href:'/email-marketing-crm/',label:'CRM & e-mail'}]} variant="reverse" editorialImage={aiImage} />
