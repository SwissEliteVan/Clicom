---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';import CTA from '../components/CTA.astro';
const steps=[['01','Comprendre','Objectifs, contexte, audiences, données et contraintes.'],['02','Construire','Stratégie, parcours, contenus, campagnes et système de mesure.'],['03','Lancer','Déploiement contrôlé, tests et coordination des éléments essentiels.'],['04','Mesurer','Lecture des signaux utiles, de la qualité des demandes et des résultats.'],['05','Optimiser','Amélioration continue des messages, canaux, parcours et processus.'],['06','Accélérer','Développer ce qui fonctionne sans perdre la cohérence du système.']];
---
<Layout title="Méthode de croissance en ligne — CLICOM" description="La méthode CLICOM en six étapes : comprendre, construire, lancer, mesurer, optimiser et accélérer."><PageHero eyebrow="Notre méthode" title="De la clarté avant la <span class='accent'>vitesse.</span>" intro="Une méthode en six étapes pour relier stratégie, exécution et amélioration continue." secondary="/audit-gratuit/" secondaryLabel="Demander un audit"/><section class="section section--white"><div class="container method-list">{steps.map(([number,title,text])=><article><span>{number}</span><div><h2>{title}</h2><p>{text}</p></div></article>)}</div></section><section class="section section--dark"><div class="container method-principles"><div><div class="eyebrow">Principes</div><h2>Un système adapté à votre <span class="gradient-text">réalité.</span></h2></div><div class="grid grid--2"><article class="card"><h3>Prioriser avant d’ajouter</h3><p>Chaque levier doit avoir un rôle, un objectif et une place claire dans le parcours.</p></article><article class="card"><h3>Mesurer ce qui compte</h3><p>La visibilité et les clics prennent leur sens lorsqu’ils soutiennent des actions utiles.</p></article></div></div></section><CTA/></Layout>
<style>.method-list{max-width:1050px}.method-list article{display:grid;grid-template-columns:120px 1fr;gap:40px;padding:48px 0;border-bottom:1px solid var(--color-border)}.method-list article>span{color:var(--color-primary);font-size:1rem;font-weight:780;letter-spacing:.14em}.method-list h2{margin-bottom:10px}.method-list p{max-width:700px}.method-principles{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:start}@media(max-width:760px){.method-list article,.method-principles{grid-template-columns:1fr;gap:18px}}</style>
