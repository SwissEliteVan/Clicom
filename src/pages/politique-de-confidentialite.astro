---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Politique de confidentialité — Clicom" description="Politique de confidentialité du site Clicom.">
  <PageHero eyebrow="Confidentialité" title="Politique de <span class='accent'>confidentialité.</span>" intro="Informations relatives au traitement des données transmises à Clicom." />
  <section class="section section--white">
    <div class="container legal-copy">
      <p class="lead">Politique de confidentialité à compléter avant mise en production.</p>
    </div>
  </section>
</Layout>

<style>.legal-copy { max-width: 800px; }</style>
