---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';import CTA from '../components/CTA.astro';
const frameworks=[{tag:'Visibilité',title:'Développer une demande plus qualifiée',problem:'Une offre utile reste difficile à trouver ou attire des recherches trop éloignées du besoin réel.',strategy:'Relier intentions, positionnement, contenus et canaux d’acquisition autour des offres prioritaires.',actions:['Audit SEO et publicitaire','Architecture des pages','Contenus et campagnes ciblés'],results:'Les résultats sont évalués par la visibilité utile, la qualité des demandes et leur contribution commerciale.'},{tag:'Conversion',title:'Transformer davantage d’intérêt en action',problem:'Le site reçoit des visites, mais les messages, les preuves ou le parcours ralentissent la prise de contact.',strategy:'Clarifier la proposition de valeur et réduire les frictions entre la première visite et l’action attendue.',actions:['Analyse des parcours','Refonte UX/UI ciblée','Landing pages et mesure'],results:'L’évaluation porte sur les actions utiles, la qualité des contacts et les étapes du parcours.'},{tag:'Automatisation',title:'Mieux suivre les opportunités',problem:'Les leads, relances et informations circulent manuellement entre plusieurs outils.',strategy:'Simplifier le processus avant de connecter formulaires, CRM, email et reporting.',actions:['Cartographie des flux','Qualification des leads','Workflows et supervision'],results:'Les gains recherchés concernent la réactivité, la qualité des données et le temps consacré aux tâches répétitives.'}];
---
<Layout title="Réalisations et approches digitales — CLICOM" description="Découvrez comment CLICOM structure ses interventions : problème, stratégie, actions et résultats mesurés sans promesses artificielles."><PageHero eyebrow="Réalisations" title="Des interventions structurées autour de <span class='accent'>problèmes réels.</span>" intro="Nous présentons notre manière de relier diagnostic, stratégie, exécution et mesure, sans inventer de clients ni de résultats." primary="/audit-gratuit/" primaryLabel="Parler de mon enjeu →" secondary="/methode/" secondaryLabel="Voir notre méthode"/><section class="section section--white"><div class="container"><div class="case-notice"><strong>Études de cas en préparation</strong><p>Des études de cas réelles seront ajoutées progressivement, uniquement après validation des clients, des données et des informations publiables.</p></div><div class="case-list">{frameworks.map(item=><article><header><span class="tag">{item.tag}</span><h2>{item.title}</h2></header><div class="case-grid"><section><span>01 — Problème</span><p>{item.problem}</p></section><section><span>02 — Stratégie</span><p>{item.strategy}</p></section><section><span>03 — Actions</span><ul>{item.actions.map(action=><li>→ {action}</li>)}</ul></section><section><span>04 — Résultats</span><p>{item.results}</p></section></div></article>)}</div></div></section><CTA title="Construisons une réponse adaptée à votre contexte."/></Layout>
<style>.case-notice{max-width:900px;margin-bottom:70px;padding:24px 28px;border-left:3px solid var(--color-primary);background:var(--color-primary-soft)}.case-notice p{margin:7px 0 0}.case-list{display:grid;gap:32px}.case-list>article{padding:clamp(30px,5vw,58px);border:1px solid var(--color-border);border-radius:var(--radius-surface);background:white;box-shadow:var(--shadow-card)}.case-list header{display:grid;grid-template-columns:160px 1fr;gap:30px;align-items:start;margin-bottom:42px}.case-list header h2{max-width:760px}.case-grid{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--color-border)}.case-grid section{padding:26px 24px 0 0}.case-grid section+section{padding-left:24px;border-left:1px solid var(--color-border)}.case-grid section>span{display:block;margin-bottom:18px;color:var(--color-primary);font-size:.72rem;font-weight:780;text-transform:uppercase;letter-spacing:.08em}.case-grid p{margin:0}.case-grid ul{display:grid;gap:8px;margin:0;padding:0;list-style:none;color:var(--color-text-muted)}@media(max-width:900px){.case-grid{grid-template-columns:repeat(2,1fr)}.case-grid section:nth-child(3){padding-left:0;border-left:0}}@media(max-width:600px){.case-list header,.case-grid{grid-template-columns:1fr}.case-grid section+section{padding-left:0;border-left:0}.case-grid section{padding-block:22px;border-bottom:1px solid var(--color-border)}}</style>
