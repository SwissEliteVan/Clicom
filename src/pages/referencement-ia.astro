---
import CommercialPage from '../components/CommercialPage.astro';
import geoImage from '../assets/editorial/geo-knowledge.webp';

const problems = [
  {
    title: 'Des informations de marque éparpillées',
    text: 'Les données qui décrivent votre entreprise, vos offres et vos expertises sont incomplètes, contradictoires ou difficiles à relier.',
  },
  {
    title: 'Des contenus difficiles à exploiter',
    text: 'Les réponses sont vagues, peu structurées ou sans éléments vérifiables pour éclairer une question précise.',
  },
  {
    title: 'Une attente de résultats impossibles à garantir',
    text: 'Les moteurs génératifs changent, choisissent leurs sources et répondent selon le contexte : aucune présence dans ChatGPT ou Gemini ne peut être promise.',
  },
];

const services = [
  { title: 'Diagnostic de présence et de questions', text: 'Repérer les sujets, entités et informations qui doivent être mieux compris en ligne.' },
  { title: 'Architecture de l’information', text: 'Clarifier la relation entre votre entreprise, vos offres, vos expertises et vos preuves.' },
  { title: 'Réponses explicites et contenus utiles', text: 'Structurer des pages qui répondent clairement aux questions des prospects, sans jargon inutile.' },
  { title: 'Données structurées pertinentes', text: 'Mettre en place les balises qui décrivent utilement le contenu, sans surbalisage ni effet d’annonce.' },
  { title: 'Cohérence des entités', text: 'Aligner les informations importantes sur vos canaux pour rendre votre présence plus fiable et identifiable.' },
  { title: 'SEO et autorité éditoriale', text: 'Consolider les fondations SEO et les contenus qui restent indispensables aux nouveaux usages de recherche.' },
];

const process = [
  { title: 'Cartographier', text: 'Identifier les questions, contenus, informations de marque et écarts de cohérence.' },
  { title: 'Clarifier', text: 'Préciser vos sujets, vos offres et les réponses que les visiteurs doivent pouvoir trouver.' },
  { title: 'Structurer', text: 'Améliorer l’architecture, les pages et les données qui rendent ces informations compréhensibles.' },
  { title: 'Publier', text: 'Développer des contenus utiles, sourcés lorsque nécessaire et cohérents avec le SEO.' },
  { title: 'Suivre', text: 'Observer les évolutions sans confondre veille, signaux et garanties de visibilité.' },
];

const decisionGuide = {
  eyebrow: 'Un complément au SEO',
  title: 'Préparer les bons signaux, sans promettre une citation.',
  intro: 'Le référencement IA améliore la compréhension et la cohérence de votre présence. Il complète le SEO traditionnel, mais ne donne pas le contrôle sur les réponses des modèles.',
  items: [
    { title: 'Ce que nous renforçons', text: 'La clarté des contenus, les entités, les données structurées et la cohérence des informations de marque.' },
    { title: 'Ce qui reste incertain', text: 'Les sources retenues, le contexte de chaque requête et l’évolution des interfaces génératives.' },
    { title: 'Pourquoi le SEO reste central', text: 'Un site techniquement solide, des contenus utiles et des signaux de confiance restent les fondations de cette approche.' },
  ],
};

const faq = [
  {
    question: 'Peut-on garantir d’apparaître dans ChatGPT, Gemini ou un autre moteur IA ?',
    answer: 'Non. Les réponses dépendent du modèle, de ses sources et du contexte de la demande. Nous travaillons sur les signaux que votre entreprise maîtrise, sans promettre une citation.',
  },
  {
    question: 'Quelle est la différence avec le SEO ?',
    answer: 'Le SEO vise notamment la compréhension, l’indexation et la visibilité dans les résultats de recherche. Le référencement IA ajoute une attention particulière à la structure des réponses, aux entités et à la cohérence des informations. Les deux approches se renforcent.',
  },
  {
    question: 'Combien de temps faut-il ?',
    answer: 'Il faut d’abord traiter les fondations les plus utiles. Les effets dépendent de l’existant, du rythme de publication et des évolutions des moteurs. Nous définissons des priorités observables plutôt qu’un délai garanti.',
  },
  {
    question: 'Quels contenus sont concernés ?',
    answer: 'Les pages d’offres, pages d’expertise, FAQ, guides, études, informations d’entreprise et contenus qui répondent à des questions précises peuvent être concernés selon votre activité.',
  },
];
---

<CommercialPage
  title="Référencement IA : structurer votre visibilité | CLICOM"
  description="Structurez vos contenus, entités et données pour rendre votre entreprise plus facile à comprendre dans les nouveaux parcours de recherche."
  eyebrow="GEO & AEO"
  h1="Rendre votre entreprise plus facile à <span class='gradient-text'>comprendre, identifier et citer.</span>"
  intro="CLICOM aide à structurer les contenus et les signaux qui rendent votre expertise plus lisible pour les personnes, les moteurs de recherche et les interfaces génératives."
  {problems}
  solution="Le référencement IA ne remplace pas le SEO. Il prolonge un travail de clarté, de cohérence et d’autorité pour les parcours de recherche qui deviennent conversationnels."
  {services}
  {process}
  benefits={[
    'Une information de marque plus cohérente et plus facile à vérifier',
    'Des contenus qui répondent plus explicitement aux vraies questions',
    'Des données structurées utilisées avec discernement',
    'Une approche compatible avec les fondations SEO existantes',
    'Une veille pragmatique, sans promesse artificielle de présence',
  ]}
  {faq}
  links={[
    { href: '/seo/', label: 'SEO' },
    { href: '/creation-contenu/', label: 'Création de contenu' },
    { href: '/intelligence-artificielle/', label: 'Intelligence artificielle' },
  ]}
  problemEyebrow="Pourquoi s’y préparer"
  problemsTitle="Les moteurs ont besoin de comprendre avant de pouvoir recommander."
  offerTitle="Une présence plus claire pour les nouveaux parcours de recherche."
  processTitle="Une méthode prudente, fondée sur des signaux que vous maîtrisez."
  benefitsTitle="Mieux expliquer votre expertise, aujourd’hui et demain."
  faqTitle="Les limites et les priorités du référencement IA."
  {decisionGuide}
  heroPrimaryLabel="Évaluer votre présence IA"
  heroSecondary="#approach"
  heroSecondaryLabel="Comprendre l’approche"
  heroPrimaryCalendly={true}
  ctaTitle="Clarifions ce qui rend votre expertise plus lisible en ligne."
  ctaText="Réservez un échange de 30 minutes pour identifier les contenus, informations et fondations SEO à traiter en priorité."
  ctaLabel="Réserver un échange de 30 min →"
  ctaCalendly={true}
  editorialImage={geoImage}
/>
