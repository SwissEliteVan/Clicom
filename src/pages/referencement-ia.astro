const problems=[{title:'Une marque peu comprise',text:'Les moteurs génératifs disposent de signaux incomplets ou incohérents sur votre expertise.'},{title:'Des contenus difficiles à citer',text:'Les réponses sont peu structurées, peu spécifiques ou insuffisamment étayées.'},{title:'Une stratégie limitée au SEO classique',text:'Les nouveaux usages de recherche conversationnelle ne sont pas intégrés à la feuille de route.'}];
const services=[{title:'Audit GEO & AEO',text:'Analyse de votre présence dans les moteurs de réponse et génératifs.'},{title:'Contenu structuré',text:'Réponses claires, sections citables et formats adaptés aux questions.'},{title:'Entités & marque',text:'Cohérence des informations qui définissent votre entreprise et ses expertises.'},{title:'Schema.org',text:'Données structurées pertinentes, sans surbalisage ni promesse artificielle.'},{title:'Autorité éditoriale',text:'Contenus utiles, sources et preuves de compétence cohérentes.'},{title:'Veille générative',text:'Suivi raisonné des évolutions de ChatGPT, Google AI et autres interfaces.'}];
