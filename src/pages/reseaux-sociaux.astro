const problems=[{title:'Une présence irrégulière',text:'La publication dépend du temps disponible et manque de continuité.'},{title:'Des contenus sans ligne directrice',text:'Les formats existent, mais ne construisent ni positionnement ni préférence de marque.'},{title:'Peu de lien avec le commerce',text:'Les réseaux sociaux vivent séparément des offres, des campagnes et du site.'}];
