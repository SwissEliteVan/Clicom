---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTA from '../../components/CTA.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': 'https://clicom.ch/secteurs/#collection',
      url: 'https://clicom.ch/secteurs',
      name: 'Solutions numériques par secteur pour PME en Suisse | CLICOM',
      description: 'Découvrez comment CLICOM adapte son système digital aux réalités métier des PME, artisans, professionnels de l’immobilier, fiduciaires, e-commerce et indépendants.',
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://clicom.ch/#website',
        name: 'CLICOM',
        url: 'https://clicom.ch/',
      },
    },
    {
      '@type': 'ItemList',
      '@id': 'https://clicom.ch/secteurs/#itemlist',
      name: 'Secteurs accompagnés par CLICOM',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'PME suisses', url: 'https://clicom.ch/secteurs/pme/' },
        { '@type': 'ListItem', position: 2, name: 'Artisans & Bâtiment', url: 'https://clicom.ch/secteurs/artisans/' },
        { '@type': 'ListItem', position: 3, name: 'Services professionnels & B2B', url: 'https://clicom.ch/secteurs/services-professionnels/' },
        { '@type': 'ListItem', position: 4, name: 'Immobilier & Courtage', url: 'https://clicom.ch/secteurs/immobilier/' },
        { '@type': 'ListItem', position: 5, name: 'E-commerce & Boutiques', url: 'https://clicom.ch/secteurs/ecommerce/' },
        { '@type': 'ListItem', position: 6, name: 'Indépendants & Praticiens', url: 'https://clicom.ch/secteurs/independants/' },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://clicom.ch/secteurs/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://clicom.ch/' },
        { '@type': 'ListItem', position: 2, name: 'Secteurs', item: 'https://clicom.ch/secteurs' },
      ],
    },
  ],
};

const sectors = [
  [
    'PME suisses',
    '/secteurs/pme/',
    'Un partenaire digital pragmatique pour piloter visibilité, devis et automatisation avec un interlocuteur unique.',
    'chart',
  ],
  [
    'Artisans & Bâtiment',
    '/secteurs/artisans/',
    'Visibilité locale sur votre canton, valorisation visuelle de vos chantiers et demandes de devis qualifiées.',
    'search',
  ],
  [
    'Services professionnels',
    '/secteurs/services-professionnels/',
    'Clarification d’expertises complexes, renforcement de votre crédibilité B2B et maturation de cycles de décision longs.',
    'spark',
  ],
  [
    'Immobilier & Courtage',
    '/secteurs/immobilier/',
    'Capture de mandats de vente, demandes d’estimation en ligne et qualification rapide des acquéreurs.',
    'globe',
  ],
  [
    'E-commerce & Boutiques',
    '/secteurs/ecommerce/',
    'Optimisation du parcours d’achat mobile, préservation des marges et fidélisation automatisée.',
    'cursor',
  ],
  [
    'Indépendants & Praticiens',
    '/secteurs/independants/',
    'Présence claire et apaisante pour valoriser votre savoir-faire sans y passer vos soirées.',
    'target',
  ],
] as const;
---

<Layout
  title="Solutions numériques par secteur pour PME | CLICOM Suisse"
  description="Découvrez comment CLICOM adapte son système digital aux réalités métier des PME, artisans, professionnels de l’immobilier, fiduciaires, e-commerce et indépendants."
  {structuredData}
>
  <PageHero
    eyebrow="Expertise sectorielle"
    title="Une stratégie numérique adaptée à votre <span class='gradient-text'>réalité métier.</span>"
    intro="Les mêmes leviers ne produisent pas la même valeur partout. CliCom adapte les priorités, le ton et les parcours digitaux aux contraintes spécifiques de votre secteur en Suisse romande."
    primary="/contact/"
    primaryLabel="Parler de votre secteur →"
    primaryCalendly={true}
    secondary="/solutions/"
    secondaryLabel="Voir les solutions par défi"
  />

  <section class="section section--white">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">Ancrage sectoriel</div>
        <h2>Partir du terrain pour construire <span class="accent">le bon système.</span></h2>
        <p>Sélectionnez votre domaine d'activité pour découvrir les réponses méthodiques et les priorités recommandées.</p>
      </div>

      <div class="grid grid--3">
        {sectors.map(([title, href, text, icon]) => (
          <ServiceCard {title} {href} {text} {icon} />
        ))}
      </div>
    </div>
  </section>

  <CTA
    title="Quel est votre prochain défi de croissance ?"
    text="Un premier échange permet de relier votre contexte sectoriel aux leviers digitaux les plus immédiatement rentables."
    label="Demander un diagnostic digital →"
    calendly={true}
  />
</Layout>
