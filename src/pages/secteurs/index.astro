---
import Layout from '../../layouts/Layout.astro';import PageHero from '../../components/PageHero.astro';import ServiceCard from '../../components/ServiceCard.astro';import CTA from '../../components/CTA.astro';
const sectors=[['PME suisses','/secteurs/pme/','Une croissance digitale structurée autour de priorités réalistes.','chart'],['Indépendants','/secteurs/independants/','Une présence claire pour gagner en visibilité et en crédibilité.','target'],['Immobilier','/secteurs/immobilier/','Des parcours adaptés aux mandats, aux biens et aux demandes.','globe'],['E-commerce','/secteurs/ecommerce/','Acquisition, conversion et fidélisation reliées aux données.','cursor'],['Artisans','/secteurs/artisans/','Une visibilité locale qui transforme les recherches en demandes.','search'],['Services professionnels','/secteurs/services-professionnels/','Une expertise mieux expliquée et des contacts mieux qualifiés.','spark']] as const;
---
<Layout title="Solutions digitales par secteur — CLICOM Suisse" description="Découvrez les solutions CLICOM pour les PME, indépendants, acteurs de l’immobilier, e-commerce, artisans et services professionnels."><PageHero eyebrow="Secteurs" title="Une stratégie digitale adaptée à votre <span class='gradient-text'>réalité métier.</span>" intro="Les mêmes leviers ne produisent pas la même valeur partout. CLICOM adapte le système à votre marché, vos clients et vos ressources." primary="/audit-gratuit/" primaryLabel="Demander un audit →" secondary="/services/" secondaryLabel="Voir les services"/><section class="section section--white"><div class="container"><div class="section-heading"><div class="eyebrow">Expertise sectorielle</div><h2>Partir du terrain pour construire <span class="accent">le bon système.</span></h2></div><div class="grid grid--3">{sectors.map(([title,href,text,icon])=><ServiceCard title={title} href={href} text={text} icon={icon}/>)}</div></div></section><CTA title="Quel est votre prochain enjeu de croissance ?" text="Un audit permet de relier votre contexte sectoriel aux leviers les plus pertinents."/></Layout>
