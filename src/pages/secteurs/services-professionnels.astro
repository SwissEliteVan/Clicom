  {
    title: 'SEO d’expertise & Contenus décisionnels',
    text: 'Positionner votre cabinet sur les interrogations stratégiques des dirigeants et directeurs financiers en Suisse romande.',
  },
  {
    title: 'CRM, LinkedIn & Nurturing commercial',
    text: 'Maintenir le lien avec vos prospects tout au long du cycle de décision grâce à des séquences ciblées et un pipeline visuel.',
  },
];

const method = [
  {
    title: 'Comprendre',
    text: 'Analyser votre pratique, vos offres rentables et le profil de vos clients institutionnels ou privés.',
  },
  {
    title: 'Clarifier',
    text: 'Rédiger des argumentaires percutants et structurer vos pages de compétences sans jargon inutile.',
  },
  {
    title: 'Établir l’autorité',
