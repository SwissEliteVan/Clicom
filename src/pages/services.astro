---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import CalendlyButton from '../components/conversion/CalendlyButton.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': 'https://clicom.ch/services/#systeme',
      name: 'Système digital PME CLICOM',
      provider: {
        '@type': 'Organization',
        name: 'CLICOM',
        url: 'https://clicom.ch/',
      },
      areaServed: {
        '@type': 'AdministrativeArea',
        name: 'Suisse romande',
      },
      description: 'Système digital complet pour PME en Suisse romande : Présence digitale, Acquisition, Automatisation et Performance & sécurité.',
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Piliers du système CliCom',
        itemListElement: [
          {
            '@type': 'OfferCatalog',
            name: 'Présence digitale',
            itemListElement: [
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Création de site web', url: 'https://clicom.ch/creation-site-web/' } },
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Identité de marque & Branding', url: 'https://clicom.ch/branding/' } },
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Création de contenu', url: 'https://clicom.ch/creation-contenu/' } },
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Réseaux sociaux', url: 'https://clicom.ch/reseaux-sociaux/' } },
            ],
          },
          {
            '@type': 'OfferCatalog',
            name: 'Acquisition',
            itemListElement: [
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Référencement naturel (SEO)', url: 'https://clicom.ch/seo/' } },
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Référencement IA', url: 'https://clicom.ch/referencement-ia/' } },
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Google Ads', url: 'https://clicom.ch/google-ads/' } },
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Publicité sur les réseaux sociaux', url: 'https://clicom.ch/social-ads/' } },
            ],
          },
          {
            '@type': 'OfferCatalog',
            name: 'Automatisation',
            itemListElement: [
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Automatisation des processus', url: 'https://clicom.ch/automatisation/' } },
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'CRM & E-mail marketing', url: 'https://clicom.ch/email-marketing-crm/' } },
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Intelligence artificielle', url: 'https://clicom.ch/intelligence-artificielle/' } },
            ],
          },
          {
            '@type': 'OfferCatalog',
            name: 'Performance & sécurité',
            itemListElement: [
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Méthode & suivi continu', url: 'https://clicom.ch/methode/' } },
              { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Audit digital gratuit', url: 'https://clicom.ch/audit-gratuit/' } },
            ],
          },
        ],
      },
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://clicom.ch/services/#breadcrumb',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Accueil',
          item: 'https://clicom.ch/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Services',
          item: 'https://clicom.ch/services',
        },
      ],
    },
  ],
};

const pillars = [
  {
    number: '01',
    badge: 'FONDATIONS & CRÉDIBILITÉ',
    title: 'Présence digitale',
    subtitle: 'Rendre votre entreprise visible, crédible et attractive dès le premier regard.',
    problem: 'Un site web vieillissant, lent ou inadapté au mobile, un discours confus et une identité qui ne reflète pas la qualité de vos prestations. Les visiteurs arrivent et repartent sans comprendre pourquoi vous choisir.',
    result: 'Une image professionnelle rassurante, une proposition de valeur limpide en quelques secondes, une navigation fluide et un socle technique ultra-rapide conçu pour convertir.',
    capabilities: [
      {
        title: 'Création de sites web orientés conversion',
        desc: 'Architecture lisible, design moderne, développement performant et formulaires optimisés.',
        href: '/creation-site-web/',
      },
      {
        title: 'Positionnement & Identité de marque (Branding)',
        desc: 'Charte graphique soignée, cohérence visuelle et discours de marque différenciant.',
        href: '/branding/',
      },
      {
        title: 'Création de contenu & Argumentation',
        desc: 'Textes clairs, pages d’offres convaincantes et preuves concrètes pour faciliter la décision.',
        href: '/creation-contenu/',
      },
      {
        title: 'Présence éditoriale sur les réseaux sociaux',
        desc: 'Prises de parole régulières et valorisation de votre savoir-faire sur les canaux adaptés.',
        href: '/reseaux-sociaux/',
      },
    ],
    links: [
      { label: 'Découvrir la création de site', href: '/creation-site-web/' },
      { label: 'Voir le branding', href: '/branding/' },
    ],
  },
  {
    number: '02',
    badge: 'VISIBILITÉ & DEMANDES QUALIFIÉES',
    title: 'Acquisition',
    subtitle: 'Capter les intentions réelles et générer un flux continu d’opportunités.',
    problem: 'Une dépendance risquée au seul bouche-à-oreille, un flux d’opportunités irrégulier ou des budgets publicitaires gaspillés sur des clics sans lendemain qui ne se transforment jamais en demandes concrètes.',
    result: 'Des prospects qualifiés en Suisse romande qui découvrent vos services au moment précis où ils formulent un besoin commercial ou comparent les solutions du marché.',
    capabilities: [
      {
        title: 'Référencement naturel (SEO & Local)',
        desc: 'Positionnement durable sur Google sur les requêtes stratégiques de votre secteur en Suisse.',
        href: '/seo/',
      },
      {
        title: 'Référencement IA (ChatGPT, Gemini, Perplexity)',
        desc: 'Structuration des données et entités pour être identifié et cité dans les moteurs conversationnels.',
        href: '/referencement-ia/',
      },
      {
        title: 'Campagnes Google Ads à forte intention',
        desc: 'Ciblage précis des recherches actives avec mesure rigoureuse du coût par contact utile.',
        href: '/google-ads/',
      },
      {
        title: 'Publicité ciblée sur les réseaux sociaux (Meta & LinkedIn)',
        desc: 'Création de demande, ciblage B2B/B2C et reciblage des audiences déjà engagées.',
        href: '/social-ads/',
      },
    ],
    links: [
      { label: 'Explorer le SEO naturel', href: '/seo/' },
      { label: 'Campagnes Google Ads', href: '/google-ads/' },
      { label: 'Visibilité dans l’IA', href: '/referencement-ia/' },
    ],
  },
  {
    number: '03',
    badge: 'FLUIDITÉ & TEMPS GAGNÉ',
    title: 'Automatisation',
    subtitle: 'Traiter chaque demande instantanément sans alourdir votre quotidien.',
    problem: 'Des formulaires web traités avec plusieurs jours de retard, des coordonnées recopiées à la main dans des tableaux Excel, des relances oubliées et des heures perdues sur des tâches administratives répétitives.',
    result: 'Une prise en charge immédiate de chaque lead, une transmission automatique au bon interlocuteur, des relances programmées et des équipes commerciales libérées des frictions techniques.',
    capabilities: [
      {
        title: 'Automatisation des flux opérationnels',
        desc: 'Connexion de vos formulaires, outils de gestion et messageries pour supprimer les doubles saisies.',
        href: '/automatisation/',
      },
      {
        title: 'Organisation CRM & Séquences e-mail',
        desc: 'Centralisation des contacts, pipeline commercial lisible et scénarios de suivi pertinents.',
        href: '/email-marketing-crm/',
      },
      {
        title: 'Assistance par intelligence artificielle',
        desc: 'Intégration d’outils IA pragmatiques et sécurisés pour assister le tri, la rédaction ou le support.',
        href: '/intelligence-artificielle/',
      },
    ],
    links: [
      { label: 'Voir l’automatisation', href: '/automatisation/' },
      { label: 'Structurer votre CRM', href: '/email-marketing-crm/' },
      { label: 'Usages IA pragmatiques', href: '/intelligence-artificielle/' },
    ],
  },
  {
    number: '04',
    badge: 'CONTINUITÉ & CONTRÔLE',
    title: 'Performance & sécurité',
    subtitle: 'Mesurer les résultats concrets, protéger votre écosystème et progresser.',
    problem: 'Aucune visibilité sur la rentabilité de vos actions digitales, des sites abandonnés sans maintenance qui deviennent vulnérables ou lents, et la crainte permanente d’une panne ou d’une perte de données.',
    result: 'Un écosystème numérique rapide, sécurisé, hébergé sur une infrastructure adaptée à la production, monitoré en continu et piloté grâce à des indicateurs de performance commerciale limpides.',
    capabilities: [
      {
        title: 'Mesure analytique & Suivi des conversions',
        desc: 'Configuration de tableaux de bord clairs pour mesurer les prises de contact et le retour sur investissement.',
        href: '/audit-gratuit/',
      },
      {
        title: 'Hébergement haute performance & Sécurité',
        desc: 'Serveurs fiables, certificats SSL, sauvegardes régulières et conformité aux standards de protection.',
        href: '/contact/',
      },
      {
        title: 'Maintenance préventive & Évolution continue',
        desc: 'Mises à jour proactives, optimisation Core Web Vitals et ajustements réguliers au fil de votre croissance.',
        href: '/methode/',
      },
    ],
    links: [
      { label: 'Découvrir notre méthode', href: '/methode/' },
      { label: 'Demander un audit de performance', href: '/audit-gratuit/' },
    ],
  },
];

const differentiators = [
  {
    title: 'PME en Suisse romande',
    text: 'Un partenaire ancré localement (Vaud, Genève, Valais, Fribourg, Neuchâtel, Jura), disponible et connaissant les réalités du marché suisse.',
  },
  {
    title: 'Métier avant technologie',
    text: 'Pas de jargon inutile ni de buzzwords. Nous parlons de vos clients, de votre rentabilité et de l’organisation de vos équipes.',
  },
  {
    title: 'Conseil & Réalisation intégrés',
    text: 'Un interlocuteur unique qui conçoit la stratégie et assure l’exécution technique, sans déperdition entre plusieurs sous-traitants.',
  },
  {
    title: 'Approche progressive',
    text: 'Vous activez uniquement les briques nécessaires à votre stade de maturité, sans forfait rigide imposé ni surcoût caché.',
  },
];
---

<Layout
  title="Services digitaux pour PME en Suisse romande | CLICOM"
  description="Découvrez le système digital CliCom : Présence digitale, Acquisition, Automatisation et Performance & sécurité. Un digital cohérent et rentable pour PME."
  {structuredData}
>
  <PageHero
    eyebrow="Services & Système PME"
    title="Un digital cohérent plutôt qu'une <span class='gradient-text'>accumulation d'outils.</span>"
    intro="CliCom ne vous vend pas des prestations isolées : nous sélectionnons, structurons et relions les compétences numériques réellement utiles aux objectifs de votre PME."
    primary="#piliers"
    primaryLabel="Explorer les 4 piliers ↓"
    secondary="/solutions/"
    secondaryLabel="Voir les solutions par défi métier"
    showBand={false}
  />

  <!-- Constat métier -->
  <section class="section section--white services-concept">
    <div class="container">
      <div class="services-concept__grid">
        <div class="services-concept__lead">
          <div class="eyebrow">Vision &amp; Méthode</div>
          <h2>Vous ne cherchez pas un outil. <span class="accent">Vous cherchez des résultats.</span></h2>
          <p class="lead-text">
            Une PME ne cherche pas à empiler des logiciels. Elle cherche plus de demandes de devis qualifiées, une meilleure organisation commerciale et du temps libéré pour ses équipes opérationnelles.
          </p>
        </div>
        <div class="services-concept__split">
          <div class="concept-item">
            <span class="concept-item__num">01</span>
            <h3>L'approche classique par catalogue</h3>
            <p>Faire appel à un freelance SEO, une agence web et acheter un CRM séparément crée des ruptures, de la perte de données et des coûts cachés.</p>
          </div>
          <div class="concept-item concept-item--highlight">
            <span class="concept-item__num">02</span>
            <h3>L'approche système CliCom</h3>
            <p>Chaque composant alimente le suivant : le site crédibilise, les campagnes attirent, l'automatisation traite et le suivi fidélise.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Les 4 piliers du système -->
  <section class="section services-pillars-section" id="piliers">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">Architecture du système</div>
        <h2>Le système CliCom en 4 piliers interconnectés.</h2>
        <p>Chaque pilier répond à un enjeu clé de votre entreprise et s'articule avec les autres pour former un moteur de croissance fiable.</p>
      </div>

      <div class="pillars-stack">
        {pillars.map((pillar) => (
          <article class="pillar-row" id={`pilier-${pillar.number}`}>
            <div class="pillar-row__intro">
              <span class="pillar-row__num">{pillar.number}</span>
              <div class="pillar-row__title-wrap">
                <span class="pillar-row__tag">{pillar.badge}</span>
                <h3>{pillar.title}</h3>
                <p class="pillar-row__subtitle">{pillar.subtitle}</p>
              </div>
            </div>

            <div class="pillar-row__content">
              <div class="pillar-row__narrative">
                <div class="narrative-block">
                  <strong>Le défi fréquent</strong>
                  <p>{pillar.problem}</p>
                </div>
                <div class="narrative-block narrative-block--result">
                  <strong>La valeur créée</strong>
                  <p>{pillar.result}</p>
                </div>
              </div>

              <div class="pillar-row__capabilities">
                <span class="capabilities-title">Expertises mobilisées :</span>
                <div class="capabilities-list">
                  {pillar.capabilities.map((cap) => (
                    <a href={cap.href} class="cap-card">
                      <div class="cap-card__header">
                        <h4>{cap.title}</h4>
                        <span class="cap-card__arrow" aria-hidden="true">↗</span>
                      </div>
                      <p>{cap.desc}</p>
                    </a>
                  ))}
                </div>
              </div>
            </div>

            <div class="pillar-row__footer">
              <span>Pages détaillées :</span>
              <div class="pillar-row__links">
                {pillar.links.map((link) => (
                  <a href={link.href} class="pillar-link">
                    {link.label} <span aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Approche : partir du besoin -->
  <section class="section section--dark services-approach">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow eyebrow--cyan">Notre démarche</div>
        <h2>Nous partons du besoin métier, pas de la technologie.</h2>
        <p>Une collaboration efficace ne commence pas par le choix d’un outil, mais par la compréhension de votre modèle et de vos priorités opérationnelles.</p>
      </div>

      <div class="grid grid--3 approach-grid">
        <div class="approach-item">
          <span class="approach-item__num">01</span>
          <h3>Diagnostic &amp; Priorisation</h3>
          <p>Nous identifions où se situe votre point de friction majeur : visibilité insuffisante, perte de conversion sur votre site ou traitement trop lent des opportunités.</p>
        </div>
        <div class="approach-item">
          <span class="approach-item__num">02</span>
          <h3>Activation progressive</h3>
          <p>Nous déployons uniquement les briques pertinentes pour votre situation, avec un calendrier réaliste et des jalons de validation partagés.</p>
        </div>
        <div class="approach-item">
          <span class="approach-item__num">03</span>
          <h3>Mesure &amp; Optimisation</h3>
          <p>Nous suivons les résultats sur vos demandes réelles et faisons évoluer le dispositif dans la durée, sans complexité superflue.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Différenciation Suisse Romande & PME -->
  <section class="section section--white services-diff">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">Ce qui nous distingue</div>
        <h2>Pourquoi les PME romandes choisissent CliCom.</h2>
        <p>Une agence conçue pour les PME exigeantes : clarté, proximité, pragmatisme et indépendance technique.</p>
      </div>

      <div class="grid grid--3 diff-grid">
        {differentiators.map((diff, idx) => (
          <div class="diff-item">
            <span class="diff-item__index">0{idx + 1}</span>
            <h3>{diff.title}</h3>
            <p>{diff.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bloc final de conversion -->
  <section class="section section--dark">
    <div class="container cta-panel">
      <div class="cta-panel__copy">
        <div class="eyebrow eyebrow--cyan">Passer à l'action</div>
        <h2>Faire le point sur votre digital.</h2>
        <p>
          En 30 minutes, analysons votre présence en ligne, vos canaux d'acquisition et vos processus pour identifier les actions prioritaires les plus rentables pour votre PME.
        </p>
      </div>
      <div class="button-row">
        <CalendlyButton label="Réserver un échange gratuit de 30 minutes" fallbackHref="/contact/" />
        <Button href="/audit-gratuit/" variant="secondary">Demander un audit gratuit</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Concept Section */
  .services-concept {
    border-bottom: 1px solid var(--color-border);
  }
  .services-concept__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(36px, 5vw, 64px);
    align-items: start;
  }
  .services-concept__lead h2 {
    font-size: clamp(1.85rem, 2.5vw, 2.4rem);
    line-height: 1.15;
  }
  .lead-text {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }
  .services-concept__split {
    display: grid;
    gap: 24px;
  }
  .concept-item {
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }
  .concept-item__num {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }
  .concept-item h3 {
    margin: 0 0 8px;
    font-size: 1.2rem;
    color: var(--color-midnight);
  }
  .concept-item p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  .concept-item--highlight h3 {
    color: var(--color-primary);
  }

  /* Pillars Stack — Editorial Pacing */
  .services-pillars-section {
    background: var(--color-background);
  }
  .pillars-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 6vw, 72px);
  }
  .pillar-row {
    padding-top: 32px;
    border-top: 1px solid var(--color-border-strong);
  }
  .pillar-row__intro {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    align-items: baseline;
    gap: 24px;
    margin-bottom: 32px;
  }
  .pillar-row__num {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-primary);
  }
  .pillar-row__tag {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }
  .pillar-row__title-wrap h3 {
    margin: 0 0 8px;
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    color: var(--color-midnight);
  }
  .pillar-row__subtitle {
    margin: 0;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .pillar-row__content {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
    margin-bottom: 28px;
  }
  .pillar-row__narrative {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .narrative-block {
    padding-left: 18px;
    border-left: 2px solid var(--color-border-strong);
  }
  .narrative-block strong {
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }
  .narrative-block p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--color-text);
  }
  .narrative-block--result {
    border-left-color: var(--color-primary);
  }
  .narrative-block--result strong {
    color: var(--color-primary);
  }

  .capabilities-title {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 14px;
  }
  .capabilities-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .cap-card {
    display: flex;
    flex-direction: column;
    padding: 16px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card-small);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }
  .cap-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }
  .cap-card__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 6px;
  }
  .cap-card__header h4 {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-midnight);
  }
  .cap-card__arrow {
    font-size: 0.9rem;
    color: var(--color-primary);
  }
  .cap-card p {
    margin: 0;
    font-size: 0.84rem;
  }
  .pillar-row__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    padding-top: 16px;
    border-top: 1px dashed var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
  .pillar-row__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .pillar-link {
    color: var(--color-primary);
    font-weight: 600;
  }
  .pillar-link:hover {
    text-decoration: underline;
  }

  /* Approach Grid */
  .approach-grid {
    gap: clamp(24px, 4vw, 40px);
  }
