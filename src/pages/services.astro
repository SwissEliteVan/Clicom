---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';

const pillars = [
  {
    id: 'creer-convertir',
    index: '01',
    title: 'Créer & convertir',
    lead: "Les fondations qui transforment une présence en ligne en outil commercial : un site qui vend, une marque qui rassure, un contenu qui convainc.",
    services: [
      { icon: 'code', title: 'Sites web & pages de conversion', text: "Conception, performance et parcours pensés pour transformer les visites en demandes.", href: '/creation-site-web/' },
      { icon: 'target', title: 'Identité de marque', text: 'Positionnement, identité et système de marque cohérents et mémorables.', href: '/branding/' },
      { icon: 'spark', title: 'Création de contenu', text: 'Vidéo, photo, textes et formats organiques ou publicitaires sur mesure.', href: '/creation-contenu/' },
    ],
  },
  {
    id: 'acquerir',
    index: '02',
    title: 'Acquérir',
    lead: "Toucher les bonnes audiences, au bon moment, sur les bons canaux — en organique avec le référencement, et en payant avec la publicité.",
    services: [
      { icon: 'search', title: 'Référencement & visibilité IA', text: "Visibilité durable sur les moteurs de recherche et les réponses génératives.", href: '/seo/' },
      { icon: 'cursor', title: 'Google Ads & publicité sociale', text: "Campagnes d'acquisition sur Google et les réseaux sociaux.", href: '/google-ads/' },
      { icon: 'globe', title: 'Réseaux sociaux', text: 'Stratégie éditoriale, publication et animation de marque.', href: '/reseaux-sociaux/' },
    ],
  },
  {
    id: 'automatiser',
    index: '03',
    title: 'Automatiser',
    lead: "Transformer l'effort manuel en processus fiables : le suivi des contacts, les relances et l'intelligence artificielle au service de l'équipe.",
    services: [
      { icon: 'automation', title: 'Automatisation & IA', text: 'Automatisations, assistants et intégrations avec un cadre clair.', href: '/automatisation/' },
      { icon: 'chart', title: 'CRM & e-mail marketing', text: 'Organisation des contacts, suivi et scénarios e-mail utiles.', href: '/email-marketing-crm/' },
      { icon: 'automation', title: 'Intelligence artificielle', text: 'Usages IA pragmatiques pour les équipes et l’acquisition.', href: '/intelligence-artificielle/' },
    ],
  },
] as const;
---

<Layout title="Services numériques — Clicom" description="Sites web, SEO, GEO, publicité, réseaux sociaux, contenu, automatisation, CRM et identité de marque par Clicom.">
  <PageHero
    eyebrow="Services"
    title="Les bons leviers. <span class='accent'>Un seul système.</span>"
    intro="Trois piliers pour faire avancer votre croissance : créer et convertir, acquérir, puis automatiser."
    secondary="/solutions"
    secondaryLabel="Voir nos solutions"
  />

  <section class="section section--white">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">Nos expertises</div>
        <h2>Une hiérarchie claire. <span class="accent">Trois piliers.</span></h2>
        <p>Chaque offre répond à une étape précise de votre croissance — de la création à l’automatisation. Choisissez le levier, nous relions le reste.</p>
      </div>

      <div class="pillars">
        {pillars.map((pillar) => (
          <section class="pillar" aria-labelledby={pillar.id}>
            <div class="pillar__head">
              <span class="pillar__index">{pillar.index}</span>
              <div class="pillar__intro">
                <h3 id={pillar.id} class="pillar__title">{pillar.title}</h3>
                <p class="pillar__lead">{pillar.lead}</p>
              </div>
            </div>
            <ul class="pillar__list">
              {pillar.services.map((s) => (
                <li class="svc">
                  <span class="svc__icon"><Icon name={s.icon} /></span>
                  <div class="svc__body">
                    <h4 class="svc__title">{s.title}</h4>
                    <p class="svc__text">{s.text}</p>
                  </div>
                  <a class="svc__link" href={s.href} aria-label={`Découvrir ${s.title}`}>Découvrir <span aria-hidden="true">→</span></a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <CTA variant="calendly" />
</Layout>


<style>
  .pillars {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  .pillar {
    border-top: 1px solid var(--color-border);
    padding-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .pillar__head {
    display: flex;
    gap: clamp(14px, 2.5vw, 24px);
    align-items: flex-start;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .pillar__index {
    flex: none;
    font-size: 1rem;
    font-weight: 760;
    letter-spacing: .14em;
    line-height: 1.2;
    color: var(--color-primary);
    padding-top: .35rem;
  }

  .pillar__title {
    margin: 0;
    font-size: clamp(1.5rem, 4.2vw, 2.15rem);
    line-height: 1.08;
  }

  .pillar__lead {
    margin: .7rem 0 0;
    max-width: 60ch;
    font-size: 1.02rem;
    line-height: 1.5;
  }

  .pillar__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .svc {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(20px, 2vw, 28px);
    background: var(--color-surface);
    transition: background-color var(--transition-base);
  }

  .svc__icon {
    display: inline-grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 1px solid rgba(36,87,255,.12);
    border-radius: 13px;
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }
  .svc__icon :global(svg) { width: 21px; height: 21px; }

  .svc__title {
    margin: 0;
    font-size: 1.08rem;
    letter-spacing: -.02em;
  }

  .svc__text {
    margin: 0;
    font-size: .94rem;
    line-height: 1.5;
  }

  .svc__link {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    font-size: .9rem;
    font-weight: 730;
  }
  .svc__link span { transition: transform var(--transition-fast); }
  .svc__link:hover span { transform: translateX(4px); }

  @media (max-width: 900px) {
    .pillar__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 680px) {
    .pillar__head { flex-direction: column; gap: 6px; }
    .pillar__index { padding-top: 0; }
    .pillar__list { grid-template-columns: 1fr; }
  }

  @media (max-width: 390px) {
    .svc { padding: 18px; gap: 10px; }
    .pillar__lead { font-size: .95rem; }
    .svc__text { font-size: .9rem; }
  }
</style>
