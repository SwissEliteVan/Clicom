---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import CalendlyButton from '../components/conversion/CalendlyButton.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': 'https://clicom.ch/solutions/#webpage',
      url: 'https://clicom.ch/solutions',
      name: 'Solutions numériques par problème métier pour PME | CLICOM Suisse',
      description: 'Trouvez la solution adaptée à votre situation : visibilité locale, conversion de devis, relance commerciale, gain de temps et mesure du ROI.',
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://clicom.ch/#website',
        name: 'CLICOM',
        url: 'https://clicom.ch/',
      },
    },
    {
      '@type': 'ItemList',
      '@id': 'https://clicom.ch/solutions/#itemlist',
      name: 'Solutions par défis métier PME',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Être trouvé · Capter les clients qui recherchent vos services en Suisse romande',
          description: 'Solutions SEO, référencement local, référencement IA et Google Ads pour générer un flux continu de prospects qualifiés.',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Être choisi · Rassurer immédiatement et transformer vos visiteurs en demandes de devis',
          description: 'Conception de sites web persuasifs, branding professionnel et clarté de l’offre pour maximiser le taux de conversion.',
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: 'Ne plus perdre d’opportunités · Suivre chaque contact et relancer vos devis avec méthode',
          description: 'Organisation CRM, formulaires connectés et séquences de relance automatisées pour augmenter le taux de signature.',
        },
        {
          '@type': 'ListItem',
          position: 4,
          name: 'Gagner du temps · Éliminer les ressaisies manuelles et relier vos logiciels métier',
          description: 'Automatisation des flux administratifs, synchronisation d’outils et assistance IA opérationnelle sous contrôle humain.',
        },
        {
          '@type': 'ListItem',
          position: 5,
          name: 'Mesurer et sécuriser · Piloter votre rentabilité avec des indicateurs fiables',
          description: 'Tableaux de bord d’activité commerciale, maintenance, sécurité technique et accompagnement continu.',
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': 'https://clicom.ch/solutions/#breadcrumb',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://clicom.ch/' },
        { '@type': 'ListItem', position: 2, name: 'Solutions', item: 'https://clicom.ch/solutions' },
      ],
    },
  ],
};

const solutions = [
  {
    id: 'etre-trouve',
    number: '01',
    theme: 'Visibilité & Acquisition',
    title: 'Être trouvé par vos futurs clients en Suisse romande',
    subtitle: 'Capter la demande au moment précis où vos prospects recherchent vos compétences.',
    problems: [
      'Votre entreprise n’apparaît pas sur les requêtes Google stratégiques de votre canton.',
      'Vos concurrents locaux occupent les premières places et captent les contacts qualifiés.',
      'Vous dépendez exclusivement du bouche-à-oreille sans flux d’opportunités prévisible.',
    ],
    impact: 'Des mandats et contrats à haute valeur ajoutée partent chez des concurrents simplement parce qu’ils sont plus faciles à trouver en ligne.',
    approach: 'Nous positionnons votre entreprise sur les intentions de recherche à fort potentiel commercial (organique, local et payant) pour construire une source régulière d’opportunités qualifiées.',
    services: [
      { label: 'Référencement naturel (SEO)', href: '/seo/' },
      { label: 'Référencement IA (GEO & AEO)', href: '/referencement-ia/' },
      { label: 'Campagnes Google Ads ciblées', href: '/google-ads/' },
      { label: 'Création de contenu d’autorité', href: '/creation-contenu/' },
    ],
    ctaLabel: 'Résoudre mon problème de visibilité',
  },
  {
    id: 'etre-choisi',
    number: '02',
    theme: 'Crédibilité & Conversion',
    title: 'Être choisi face aux alternatives du marché',
    subtitle: 'Rassurer immédiatement vos visiteurs et les inciter à faire une demande de devis.',
    problems: [
      'Votre site web est vieillissant, lent ou mal adapté à la navigation sur smartphone.',
      'Votre proposition de valeur est floue et vos visiteurs ne comprennent pas rapidement vos atouts.',
      'Vous recevez des visites mais très peu de formulaires ou d’appels téléphoniques concrets.',
    ],
    impact: 'Chaque visiteur qui quitte votre site sans vous contacter représente un investissement ou une recommandation gâchée.',
    approach: 'Nous transformons votre vitrine digitale en un outil de réassurance commerciale : message limpide, vitesse de chargement instantanée, preuves tangibles et boutons d’action incitatifs.',
    services: [
      { label: 'Création de site web orienté conversion', href: '/creation-site-web/' },
      { label: 'Identité de marque & Branding', href: '/branding/' },
      { label: 'Rédaction persuasive & Pages d’offres', href: '/creation-contenu/' },
      { label: 'Réseaux sociaux professionnels', href: '/reseaux-sociaux/' },
    ],
    ctaLabel: 'Améliorer mon taux de conversion',
  },
  {
    id: 'ne-plus-perdre-leads',
    number: '03',
    theme: 'Suivi commercial & Pipeline',
    title: 'Ne plus perdre d’opportunités et relancer chaque devis',
    subtitle: 'Structurer la réception de vos leads et fiabiliser votre suivi commercial.',
    problems: [
      'Les demandes web arrivent dans une boîte e-mail générique et sont traitées avec retard.',
      'Le suivi commercial dépend de la mémoire de chacun et les relances sont irrégulières.',
      'Des devis envoyés restent sans réponse sans que personne ne relance les prospects tièdes.',
    ],
    impact: 'Une perte évitable d’opportunités commerciales sur des prospects pourtant très intéressés au départ.',
    approach: 'Nous centralisons vos prises de contact dans un CRM visuel et configurons des séquences de relance automatiques bienveillantes pour signer davantage de propositions.',
    services: [
      { label: 'Organisation CRM & Pipeline de vente', href: '/email-marketing-crm/' },
      { label: 'Automatisation des relances de devis', href: '/automatisation/' },
      { label: 'Séquences e-mails personnalisées', href: '/email-marketing-crm/' },
      { label: 'Formulaires web connectés au CRM', href: '/creation-site-web/' },
    ],
    ctaLabel: 'Structurer mon suivi commercial',
  },
  {
    id: 'gagner-du-temps',
    number: '04',
    theme: 'Productivité & Processus',
    title: 'Gagner du temps et éliminer les tâches répétitives',
    subtitle: 'Faire communiquer vos logiciels pour libérer vos équipes du travail administratif.',
    problems: [
      'Ressaisir manuellement les coordonnées des clients entre le site, Excel et la facturation.',
      'Passer des heures à transférer des informations et créer des tâches au lieu de servir les clients.',
      'Des logiciels de gestion déconnectés qui multiplient les risques d’erreur et les oublis.',
    ],
    impact: 'Une surcharge administrative qui épuise vos collaborateurs et ralentit le traitement des commandes.',
    approach: 'Nous relions vos outils quotidiens grâce à des automatisations robustes et intégrons des assistants IA pragmatiques sous contrôle humain permanent.',
    services: [
      { label: 'Automatisation des processus métier', href: '/automatisation/' },
      { label: 'Synchronisation de logiciels & API', href: '/automatisation/' },
      { label: 'Intelligence artificielle opérationnelle', href: '/intelligence-artificielle/' },
      { label: 'Alertes d’équipe & Notifications', href: '/email-marketing-crm/' },
    ],
    ctaLabel: 'Automatiser mes tâches répétitives',
  },
  {
    id: 'mesurer-et-securiser',
    number: '05',
    theme: 'Pilotage & Sécurité',
    title: 'Mesurer vos résultats et sécuriser votre infrastructure',
    subtitle: 'Piloter vos investissements digitaux avec des données claires et un socle durable.',
    problems: [
      'Incapacité à identifier précisément quels canaux ou campagnes génèrent du chiffre d’affaires.',
      'Crainte de dépendre d’outils propriétaires opaques ou d’abonnements mensuels captifs.',
      'Inquiétude quant à la sécurité technique, aux sauvegardes et à la pérennité du site.',
    ],
    impact: 'Des décisions budgétaires prises à l’aveugle et un risque opérationnel permanent sur vos actifs digitaux.',
    approach: 'Nous mettons en place des tableaux de bord d’indicateurs compréhensibles, livrons un code dont vous êtes 100 % propriétaire et assurons la maintenance et la pérennité de votre socle technique.',
    services: [
      { label: 'Notre méthode & Pilotage des résultats', href: '/methode/' },
      { label: 'Diagnostic de performance & sécurité', href: '/audit-gratuit/' },
      { label: 'Architecture web maîtrisée', href: '/creation-site-web/' },
      { label: 'Tableaux de bord d’activité commerciale', href: '/automatisation/' },
    ],
    ctaLabel: 'Évaluer ma performance et ma sécurité',
  },
];

const sectors = [
  { name: 'PME suisses', href: '/secteurs/pme/', desc: 'Croissance structurée & rentabilité' },
  { name: 'Artisans & Bâtiment', href: '/secteurs/artisans/', desc: 'Visibilité locale & demandes de devis' },
  { name: 'Services professionnels', href: '/secteurs/services-professionnels/', desc: 'Crédibilité B2B & génération de leads' },
  { name: 'Immobilier', href: '/secteurs/immobilier/', desc: 'Mandats, biens & parcours acquéreurs' },
  { name: 'E-commerce', href: '/secteurs/ecommerce/', desc: 'Conversion, paniers & fidélisation' },
  { name: 'Indépendants', href: '/secteurs/independants/', desc: 'Présence professionnelle & prise de contact' },
];
---

<Layout
  title="Solutions numériques par problème métier pour PME | CLICOM Suisse"
  description="Trouvez la solution adaptée au défi de votre PME : visibilité Google, conversion de devis, relance commerciale, gain de temps et mesure du ROI sans jargon."
  {structuredData}
>
  <PageHero
    eyebrow="Solutions par défis métier"
    title="Résoudre les blocages qui freinent le développement de votre PME."
    intro="Vous n’avez pas besoin de maîtriser le jargon technique. Identifiez simplement ce qui freine vos résultats : nous structurons les solutions et leviers pertinents pour y répondre."
    primary="#problemes"
    primaryLabel="Explorer les solutions ↓"
    secondary="/services/"
    secondaryLabel="Voir les services par compétence"
    showBand={false}
  />

  <!-- Detailed Solutions List -->
  <section class="section section--white" id="problemes">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">Méthode de résolution</div>
        <h2>5 réponses concrètes aux défis des PME romandes.</h2>
        <p>Chaque solution associe un diagnostic clair, une méthode d’intervention éprouvée et les expertises techniques indispensables.</p>
      </div>

      <div class="solutions-stream">
        {solutions.map((sol) => (
          <article class="solution-entry" id={sol.id}>
            <div class="solution-entry__head">
              <span class="solution-entry__num">{sol.number}</span>
              <div class="solution-entry__titles">
                <span class="solution-entry__theme">{sol.theme}</span>
                <h3>{sol.title}</h3>
                <p>{sol.subtitle}</p>
              </div>
            </div>

            <div class="solution-entry__grid">
              <!-- 01 Problème -->
              <div class="solution-column">
                <span class="column-step">01 · Le constat terrain</span>
                <h4>Ce qui bloque aujourd’hui</h4>
                <ul class="clean-list">
                  {sol.problems.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>

              <!-- 02 Approche -->
              <div class="solution-column">
                <span class="column-step">02 · L’intervention</span>
                <h4>L’approche CliCom</h4>
                <p>{sol.approach}</p>
                <div class="impact-note">
                  <strong>Impact visé :</strong>
                  <p>{sol.impact}</p>
                </div>
              </div>

              <!-- 03 Système & Action -->
              <div class="solution-column solution-column--action">
                <span class="column-step">03 · Briques activées</span>
                <h4>Compétences mobilisées</h4>
                <div class="services-nav">
                  {sol.services.map((srv) => (
                    <a href={srv.href} class="srv-link">
                      <span>{srv.label}</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  ))}
                </div>
                <div class="solution-entry__cta">
                  <CalendlyButton label={`${sol.ctaLabel} →`} fallbackHref="/contact/" />
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Sector Navigation Strip -->
  <section class="section section--compact sectors-section">
    <div class="container">
      <div class="section-heading">
        <div class="eyebrow">Approche sectorielle</div>
        <h2>Une réponse adaptée à votre secteur d’activité.</h2>
        <p>Nous adaptons le système digital aux réalités opérationnelles et réglementaires de chaque métier en Suisse romande.</p>
      </div>

      <div class="grid grid--3 sectors-stream">
        {sectors.map((sec, idx) => (
          <a href={sec.href} class="sector-item">
            <span class="sector-item__num">0{idx + 1}</span>
            <h3>{sec.name}</h3>
            <p>{sec.desc}</p>
            <span class="sector-item__arrow" aria-hidden="true">Découvrir →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA Panel -->
  <section class="section section--dark">
    <div class="container cta-panel">
      <div class="cta-panel__copy">
        <div class="eyebrow eyebrow--cyan">Diagnostic sans engagement</div>
        <h2>Votre situation combine plusieurs de ces défis ?</h2>
        <p>C’est le cas de la majorité des PME en développement. Un échange direct de 30 minutes permet de faire le point, d’identifier le point de friction prioritaire et de déterminer la première étape la plus rentable.</p>
      </div>
      <div class="button-row">
        <CalendlyButton label="Réserver un échange de 30 min →" fallbackHref="/contact/" />
        <Button href="/audit-gratuit/" variant="secondary">Demander un diagnostic digital</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Solutions Stream — Open Editorial */
  .solutions-stream {
    display: flex;
    flex-direction: column;
    gap: clamp(56px, 7vw, 84px);
  }
  .solution-entry {
    padding-top: 36px;
    border-top: 1px solid var(--color-border-strong);
    scroll-margin-top: 96px;
  }
  .solution-entry__head {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: 24px;
    align-items: baseline;
    margin-bottom: 32px;
  }
  .solution-entry__num {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-primary);
  }
  .solution-entry__theme {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 6px;
  }
  .solution-entry__titles h3 {
    margin: 0 0 6px;
    font-size: clamp(1.65rem, 2.4vw, 2.15rem);
    color: var(--color-midnight);
  }
  .solution-entry__titles p {
    margin: 0;
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  /* Solution Columns */
  .solution-entry__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3.5vw, 44px);
    align-items: start;
  }
  }
  .services-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .service-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-midnight);
    text-decoration: none;
    transition: border-color var(--transition-fast), color var(--transition-fast), background var(--transition-fast);
  }
  .service-chip .arrow {
    color: var(--color-primary);
    transition: transform var(--transition-fast);
  }
  .service-chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }
  .service-chip:hover .arrow {
    transform: translateX(3px);
  }

  .solution-block__action {
    margin-top: 8px;
  }

  /* Sectors Strip */
  .sectors-section {
    background: var(--color-background);
  }
  .sectors-panel {
    padding: clamp(32px, 5vw, 48px);
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }
  .sectors-heading {
    margin-bottom: 28px;
    max-width: 680px;
  }
  .sectors-heading h3 {
    margin: 8px 0 10px;
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    color: var(--color-midnight);
  }
  .sectors-heading p {
  /* Sectors Stream */
  .sectors-stream {
    gap: clamp(20px, 3vw, 32px);
  }
  .sector-item {
    display: flex;
    flex-direction: column;
    padding: 24px;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }
  .sector-item:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
  }
  .sector-item__num {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }
  .sector-item h3 {
    margin: 0 0 8px;
    font-size: 1.15rem;
    color: var(--color-midnight);
  }
  .sector-item p {
    margin: 0 0 16px;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
  .sector-item__arrow {
    margin-top: auto;
    font-size: 0.84rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  @media (max-width: 1024px) {
    .solution-entry__grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  @media (max-width: 680px) {
    .solution-entry__head {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .sectors-stream {
      grid-template-columns: 1fr;
    }
  }
</style>
