---
import Layout from '../layouts/Layout.astro';import PageHero from '../components/PageHero.astro';import CTA from '../components/CTA.astro';
const levels=[{name:'Essentiel',text:'Clarifier et remettre à niveau votre présence digitale.',items:['Objectif principal défini','Périmètre concentré','Socle prêt à évoluer']},{name:'Croissance',text:'Développer votre visibilité et générer davantage de demandes.',items:['Stratégie multilevier','Mesure et optimisation','Accompagnement continu']},{name:'Accélération',text:'Connecter vos outils, automatiser vos processus et piloter votre croissance.',items:['Architecture sur mesure','Automatisation et intégrations','Pilotage évolutif']}];
---
<Layout title="Tarifs et accompagnements numériques — CLICOM" description="Découvrez l’approche tarifaire sur mesure de CLICOM et les niveaux Essentiel, Croissance et Accélération, sans offre standard imposée."><PageHero eyebrow="Tarifs" title="Un investissement défini par la <span class='gradient-text'>valeur et le périmètre.</span>" intro="Chaque entreprise part d’un contexte différent. Nous construisons une proposition transparente après avoir clarifié vos priorités." primary="/audit-gratuit/" primaryLabel="Cadrer mon projet →" secondary="/methode/" secondaryLabel="Voir notre méthode"/><section class="section section--white"><div class="container"><div class="section-heading"><div class="eyebrow">Niveaux d’accompagnement</div><h2>Trois cadres. <span class="accent">Aucun faux forfait.</span></h2><p>Ces niveaux donnent une lecture du degré d’accompagnement. Le budget dépend du périmètre réellement retenu.</p></div><div class="grid grid--3 pricing">{levels.map((level,i)=><article class:list={['card',{'card--highlighted':i===1}]}><span>0{i+1}</span><h2>{level.name}</h2><p>{level.text}</p><ul>{level.items.map(item=><li>→ {item}</li>)}</ul><a class="text-link" href="/audit-gratuit/">Définir le périmètre <span>→</span></a></article>)}</div><p class="tarif-note">Aucun prix public : chaque proposition est construite après un échange sur votre contexte, vos priorités et votre budget.</p></div></section><section class="section"><div class="container included"><h2>Ce qui détermine votre proposition.</h2><div class="grid grid--3"><article><h3>Périmètre</h3><p>Nombre de leviers, pages, campagnes, contenus ou intégrations.</p></article><article><h3>Complexité</h3><p>Niveau de personnalisation, données, outils et dépendances.</p></article><article><h3>Accompagnement</h3><p>Projet ponctuel, suivi continu, production ou collaboration avec vos équipes.</p></article></div></div></section><CTA title="Obtenez un cadrage adapté à votre situation." text="Un échange permet de définir le bon niveau d’ambition, sans ajouter de prestations inutiles."/></Layout>
<style>.pricing article>span{color:var(--color-primary);font-size:.75rem;font-weight:780}.pricing h2{margin-top:28px}.pricing ul{display:grid;gap:10px;padding:22px 0 0;border-top:1px solid var(--color-border);list-style:none;color:var(--color-text-muted)}.tarif-note{margin:28px auto 0;max-width:640px;color:var(--color-text-muted);font-size:.95rem;line-height:1.6;text-align:center}.included>h2{max-width:700px;margin-bottom:50px}.included article{padding-top:22px;border-top:2px solid var(--color-primary)}</style>
